---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
const prefix = isZh ? '/research-handbook' : '/research-handbook/en';
const panelCopy = isZh ? {
  representation:['Representation / NFE','如何把 local velocity 壓縮成 finite-time transport？','MeanFlow 把 instantaneous velocity v 換成 interval-average velocity u。這條分支可連到 Flow Map Matching、Shortcut-style finite-time representation。'],
  training:['Training dynamics','如何安排 r=t、small-Δt 與 large-gap learning？','目前證據支持先形成 instantaneous / small-gap 能力，再逐步進入 large-gap MeanFlow；pure r=t-only warm-up 仍值得直接 ablation。'],
  objective:['Objective / JVP','JVP tangent、uθ、vθ、Vθ 應如何分工？','Original MF 與 iMF 的關鍵差異集中在 JVP tangent；同時連到偏微分、marginalization 與 compound predictor。'],
  endpoint:['Endpoint / refinement','one-step coarse transport 後是否仍需要 correction？','RMFlow 代表另一條改善支線：除了改 objective，也可拆成 coarse transport + refinement。'],
  distribution:['Distribution correctness','vector regression 變好，是否代表 probability path 真的正確？','Divergence alignment 提供 distribution-level constraint / diagnostic lens，可作為 fast-flow 方法的跨方法參考。']
} : {
  representation:['Representation / NFE','How can local velocity become finite-time transport?','MeanFlow replaces instantaneous velocity v with interval-average velocity u and connects naturally to finite-time representations such as Flow Map Matching and Shortcut-style ideas.'],
  training:['Training dynamics','How should r=t, small-Δt, and large-gap learning be scheduled?','Existing evidence supports establishing instantaneous / small-gap competence before large-gap MeanFlow; strict r=t-only warm-up remains worth direct ablation.'],
  objective:['Objective / JVP','How should the JVP tangent, uθ, vθ, and Vθ interact?','The key Original-MF → iMF change sits in the JVP tangent and connects to partial derivatives, marginalization, and the compound predictor.'],
  endpoint:['Endpoint / refinement','Does one-step coarse transport still need correction?','RMFlow represents another route: improve quality with coarse transport plus refinement instead of only reformulating the objective.'],
  distribution:['Distribution correctness','Does better vector regression imply a correct probability path?','Divergence alignment supplies a distribution-level constraint / diagnostic lens that may transfer to fast-flow research.']
};
---
<div class="kg" data-kg data-lang={isZh?'zh':'en'}>
  <div class="kg-head">
    <div class="kg-copy">
      <span class="kicker">RESEARCH KNOWLEDGE GRAPH</span>
      <strong>{isZh ? 'MeanFlow-centered 關聯地圖' : 'MeanFlow-centered relation graph'}</strong>
      <p>{isZh ? '點 MeanFlow 展開主分支；再點任一研究問題展開 papers、concepts 與可借鏡方法。圖中可自由拖曳與縮放。' : 'Select MeanFlow to reveal the main branches, then open a research question to show papers, concepts, and transferable ideas. The graph can be freely panned and zoomed.'}</p>
    </div>
    <div class="kg-actions" role="group" aria-label={isZh?'地圖控制':'Graph controls'}>
      <button type="button" data-expand>{isZh ? '展開 MeanFlow' : 'Expand MeanFlow'}</button>
      <button type="button" data-all>{isZh ? '全部展開' : 'Expand all'}</button>
      <button type="button" data-zoom-out aria-label={isZh?'縮小':'Zoom out'}>−</button>
      <button type="button" data-zoom-in aria-label={isZh?'放大':'Zoom in'}>＋</button>
      <button type="button" data-reset>{isZh ? '重設' : 'Reset'}</button>
    </div>
  </div>
  <div class="legend"><span><i class="main"></i>{isZh?'主線':'mainline'}</span><span><i class="question"></i>{isZh?'問題':'question'}</span><span><i class="paper"></i>{isZh?'論文':'paper'}</span><span><i class="concept"></i>{isZh?'概念 / 舊方法':'concept / transfer'}</span></div>

  <div class="graph-shell" data-shell>
    <div class="graph-stage">
      <svg class="graph" viewBox="0 0 1200 820" role="img" aria-label={isZh?'MeanFlow 研究關聯圖':'MeanFlow research relation graph'}>
        <g data-viewport>
          <g class="base-edges"><path d="M600 110 L600 175"/><path d="M600 235 L600 300"/></g>
          <g class="main-node"><rect x="470" y="52" width="260" height="58" rx="14"/><text x="600" y="86">Diffusion / Score-based</text></g>
          <g class="main-node"><rect x="470" y="175" width="260" height="60" rx="14"/><text x="600" y="210">Flow Matching</text></g>
          <g class="main-node focus" data-toggle-main tabindex="0" role="button"><rect x="455" y="300" width="290" height="72" rx="16"/><text x="600" y="332">MeanFlow</text><text x="600" y="355" class="sub">average velocity u · one/few-step</text></g>

          <g class="branch-layer">
            <g class="branch-edges"><path d="M455 334 C390 334 350 285 310 260"/><path d="M480 366 C400 410 350 470 305 510"/><path d="M600 372 L600 505"/><path d="M745 334 C815 334 855 285 900 260"/><path d="M720 366 C805 410 855 470 905 510"/></g>
            <g class="branch-node" data-branch="representation" tabindex="0" role="button"><rect x="170" y="220" width="240" height="78" rx="14"/><text x="290" y="250">Representation / NFE</text><text x="290" y="274" class="sub">local → finite-time</text></g>
            <g class="branch-node" data-branch="training" tabindex="0" role="button"><rect x="155" y="472" width="250" height="80" rx="14"/><text x="280" y="502">Training dynamics</text><text x="280" y="527" class="sub">r=t · small Δt · curriculum</text></g>
            <g class="branch-node" data-branch="objective" tabindex="0" role="button"><rect x="475" y="505" width="250" height="80" rx="14"/><text x="600" y="535">Objective / JVP</text><text x="600" y="560" class="sub">e−x · vθ · Vθ</text></g>
            <g class="branch-node" data-branch="endpoint" tabindex="0" role="button"><rect x="795" y="220" width="250" height="78" rx="14"/><text x="920" y="250">Endpoint / refinement</text><text x="920" y="274" class="sub">coarse → correction</text></g>
            <g class="branch-node" data-branch="distribution" tabindex="0" role="button"><rect x="795" y="472" width="250" height="80" rx="14"/><text x="920" y="502">Distribution correctness</text><text x="920" y="527" class="sub">vector loss → path?</text></g>
          </g>

          <g class="child-layer" data-group="representation">
            <path class="child-edge" d="M170 245 L95 165"/><path class="child-edge" d="M170 280 L95 350"/><path class="cross-edge" d="M210 298 C190 390 210 430 250 472"/>
            <a href={`${prefix}/papers/meanflow/`}><g class="paper-node"><rect x="10" y="125" width="190" height="58" rx="12"/><text x="105" y="160">MeanFlow paper</text></g></a>
            <g class="concept-node"><rect x="10" y="332" width="190" height="58" rx="12"/><text x="105" y="357">Flow Map Matching</text><text x="105" y="377" class="sub">finite displacement</text></g>
            <g class="concept-node"><rect x="215" y="120" width="190" height="58" rx="12"/><text x="310" y="145">Shortcut Models</text><text x="310" y="165" class="sub">two-time consistency</text></g>
          </g>

          <g class="child-layer" data-group="training">
            <path class="child-edge" d="M155 510 L105 650"/><path class="child-edge" d="M280 552 L280 690"/><path class="child-edge" d="M405 510 L470 650"/>
            <a href={`${prefix}/papers/alphaflow/`}><g class="paper-node"><rect x="10" y="635" width="190" height="58" rx="12"/><text x="105" y="670">AlphaFlow</text></g></a>
            <a href={`${prefix}/papers/meanflow-training/`}><g class="paper-node"><rect x="205" y="690" width="230" height="60" rx="12"/><text x="320" y="716">MF Training Dynamics</text><text x="320" y="737" class="sub">short → long gap</text></g></a>
            <g class="concept-node"><rect x="440" y="635" width="220" height="60" rx="12"/><text x="550" y="661">Consistency curriculum</text><text x="550" y="682" class="sub">transfer lens</text></g>
          </g>

          <g class="child-layer" data-group="objective">
            <path class="child-edge" d="M520 585 L470 680"/><path class="child-edge" d="M600 585 L600 740"/><path class="child-edge" d="M680 585 L760 680"/>
            <a href={`${prefix}/papers/improved-meanflow/`}><g class="paper-node"><rect x="365" y="655" width="220" height="60" rx="12"/><text x="475" y="681">Improved MeanFlow</text><text x="475" y="702" class="sub">JVP tangent reformulation</text></g></a>
            <a href={`${prefix}/concepts/calculus-jvp/`}><g class="concept-node"><rect x="495" y="742" width="210" height="58" rx="12"/><text x="600" y="767">Calculus & JVP</text><text x="600" y="787" class="sub">partials · total derivative</text></g></a>
            <g class="concept-node"><rect x="705" y="655" width="215" height="60" rx="12"/><text x="812" y="681">uθ · vθ · Vθ</text><text x="812" y="702" class="sub">notation / roles</text></g>
          </g>

          <g class="child-layer" data-group="endpoint">
            <path class="child-edge" d="M1045 245 L1110 165"/><path class="child-edge" d="M1045 280 L1110 350"/>
            <a href={`${prefix}/papers/rmflow/`}><g class="paper-node"><rect x="1000" y="125" width="190" height="58" rx="12"/><text x="1095" y="160">RMFlow</text></g></a>
            <g class="concept-node"><rect x="990" y="332" width="200" height="60" rx="12"/><text x="1090" y="358">Refinement / corrector</text><text x="1090" y="379" class="sub">transfer lens</text></g>
          </g>

          <g class="child-layer" data-group="distribution">
            <path class="child-edge" d="M1045 510 L1110 650"/><path class="child-edge" d="M920 552 L920 690"/><path class="cross-edge" d="M795 510 C735 420 700 315 690 235"/>
            <a href={`${prefix}/papers/flow-divergence/`}><g class="paper-node"><rect x="995" y="635" width="195" height="60" rx="12"/><text x="1092" y="661">Flow Divergence</text><text x="1092" y="682" class="sub">path-level objective</text></g></a>
            <g class="concept-node"><rect x="810" y="690" width="220" height="60" rx="12"/><text x="920" y="716">Continuity / divergence</text><text x="920" y="737" class="sub">distribution constraint</text></g>
          </g>
        </g>
      </svg>
    </div>
    <div class="zoom-indicator"><span data-zoom-label>100%</span></div>
  </div>

  <div class="kg-inspector">
    <div class="inspector-placeholder"><span>{isZh?'使用方式':'How to use'}</span><strong>{isZh?'先點 MeanFlow，再點任一研究分支。':'Select MeanFlow, then select any research branch.'}</strong></div>
    {Object.entries(panelCopy).map(([id,p])=><section data-panel={id} hidden><span>{p[0]}</span><h3>{p[1]}</h3><p>{p[2]}</p></section>)}
  </div>
</div>

<style>
.kg{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface);margin:1rem 0 1.5rem;box-shadow:0 14px 38px rgba(74,49,34,.055)}.kg-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center}.kg-copy{min-width:0}.kg-head strong{display:block;font-size:1.08rem}.kg-head p{margin:.3rem 0 0;color:var(--rh-muted);line-height:1.55}.kicker{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.13em;margin-bottom:.25rem}.kg-actions{display:grid;grid-template-columns:repeat(5,max-content);gap:.45rem;align-items:center}.kg-actions button{box-sizing:border-box;height:2.65rem;min-width:2.65rem;margin:0;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);color:var(--rh-text);padding:0 .8rem;font:inherit;line-height:1;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;cursor:pointer}.kg-actions button:hover{border-color:var(--rh-caramel)}.legend{display:flex;gap:.75rem;flex-wrap:wrap;margin:.75rem 0;font-size:.7rem;color:var(--rh-muted)}.legend span{display:flex;gap:.3rem;align-items:center}.legend i{width:.65rem;height:.65rem;border-radius:3px;display:inline-block}.legend .main{background:var(--rh-coffee)}.legend .question{background:var(--rh-caramel)}.legend .paper{background:var(--rh-surface-2);border:1px solid var(--rh-coffee)}.legend .concept{background:transparent;border:1px dashed var(--rh-caramel)}
.graph-shell{position:relative;border:1px solid var(--rh-border);border-radius:.85rem;background:color-mix(in srgb,var(--rh-surface) 95%,white);overflow:hidden;height:680px;touch-action:none;cursor:grab}.graph-shell.dragging{cursor:grabbing}.graph-stage{position:absolute;inset:0;overflow:hidden}.graph{display:block;width:100%;height:100%;user-select:none}.graph [data-viewport]{transform-origin:0 0;transform-box:fill-box}.base-edges path,.branch-edges path,.child-edge,.cross-edge{fill:none;stroke:var(--rh-border);stroke-width:2}.cross-edge{stroke:var(--rh-caramel);stroke-dasharray:7 7;opacity:.6}.main-node rect{fill:var(--rh-surface-2);stroke:var(--rh-border);stroke-width:1.5}.main-node text,.branch-node text,.paper-node text,.concept-node text{fill:var(--rh-text);font-size:14px;font-weight:700;text-anchor:middle;pointer-events:none}.main-node .sub,.branch-node .sub,.paper-node .sub,.concept-node .sub{fill:var(--rh-muted);font-size:11px;font-weight:500}.main-node.focus,.branch-node{cursor:pointer}.main-node.focus rect{fill:color-mix(in srgb,var(--rh-coffee) 9%,var(--rh-surface-2));stroke:var(--rh-coffee);stroke-width:2.5}.branch-node rect{fill:var(--rh-surface-2);stroke:var(--rh-border);stroke-width:1.5}.branch-node:hover rect,.branch-node.active rect{stroke:var(--rh-caramel);stroke-width:2.4;fill:color-mix(in srgb,var(--rh-caramel) 8%,var(--rh-surface-2))}.paper-node rect{fill:var(--rh-surface);stroke:var(--rh-coffee);stroke-width:1.3}.concept-node rect{fill:var(--rh-surface);stroke:var(--rh-caramel);stroke-width:1.3;stroke-dasharray:6 5}.child-layer,.branch-layer{opacity:0;pointer-events:none;transition:opacity .18s ease}.kg.show-branches .branch-layer,.child-layer.open{opacity:1;pointer-events:auto}.zoom-indicator{position:absolute;right:.7rem;bottom:.7rem;background:color-mix(in srgb,var(--rh-surface) 90%,transparent);border:1px solid var(--rh-border);border-radius:.45rem;padding:.25rem .45rem;font-size:.68rem;color:var(--rh-muted);pointer-events:none}.kg-inspector{margin-top:.8rem;display:grid;grid-template-columns:1fr;min-height:7rem}.inspector-placeholder,.kg-inspector section{box-sizing:border-box;border:1px solid var(--rh-border);border-radius:.7rem;padding:.8rem;background:var(--rh-surface-2);min-height:7rem}.kg-inspector span,.inspector-placeholder span{display:block;color:var(--rh-caramel);font-size:.68rem;text-transform:uppercase;letter-spacing:.06em}.kg-inspector h3{font-size:.95rem;margin:.28rem 0}.kg-inspector p{margin:0;color:var(--rh-muted);line-height:1.55}.inspector-placeholder strong{display:block;margin-top:.25rem}
@media(max-width:900px){.kg-head{grid-template-columns:1fr}.kg-actions{grid-template-columns:repeat(5,minmax(0,1fr));width:100%}.kg-actions button{min-width:0;padding:0 .45rem}.graph-shell{height:560px}}@media(max-width:620px){.kg-actions{grid-template-columns:repeat(3,minmax(0,1fr))}.graph-shell{height:500px}}
</style>

<script>
for(const root of document.querySelectorAll('[data-kg]')){
  if(root.dataset.ready)continue;root.dataset.ready='1';
  const shell=root.querySelector('[data-shell]'),viewport=root.querySelector('[data-viewport]'),main=root.querySelector('[data-toggle-main]'),branches=[...root.querySelectorAll('[data-branch]')],groups=[...root.querySelectorAll('[data-group]')],panels=[...root.querySelectorAll('[data-panel]')],placeholder=root.querySelector('.inspector-placeholder'),expand=root.querySelector('[data-expand]'),all=root.querySelector('[data-all]'),zin=root.querySelector('[data-zoom-in]'),zout=root.querySelector('[data-zoom-out]'),reset=root.querySelector('[data-reset]'),zlabel=root.querySelector('[data-zoom-label]');
  let scale=1,tx=0,ty=0,drag=false,lastX=0,lastY=0;
  function apply(){viewport.style.transform=`translate(${tx}px,${ty}px) scale(${scale})`;zlabel.textContent=`${Math.round(scale*100)}%`}
  function resetView(){scale=1;tx=0;ty=0;apply()}
  function zoom(next,cx=shell.clientWidth/2,cy=shell.clientHeight/2){const ns=Math.min(2.2,Math.max(.55,next)),ratio=ns/scale;tx=cx-(cx-tx)*ratio;ty=cy-(cy-ty)*ratio;scale=ns;apply()}
  function showPanel(id){panels.forEach(p=>p.hidden=p.dataset.panel!==id);placeholder.hidden=true}
  function openBranch(id){root.classList.add('show-branches');branches.forEach(b=>b.classList.toggle('active',b.dataset.branch===id));groups.forEach(g=>g.classList.toggle('open',g.dataset.group===id));showPanel(id)}
  function expandAll(){root.classList.add('show-branches');groups.forEach(g=>g.classList.add('open'));branches.forEach(b=>b.classList.remove('active'));placeholder.hidden=false;panels.forEach(p=>p.hidden=true);resetView()}
  main.addEventListener('click',()=>root.classList.toggle('show-branches'));main.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();root.classList.toggle('show-branches')}});branches.forEach(b=>{const id=b.dataset.branch;b.addEventListener('click',()=>openBranch(id));b.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openBranch(id)}})});expand.addEventListener('click',()=>root.classList.add('show-branches'));all.addEventListener('click',expandAll);zin.addEventListener('click',()=>zoom(scale*1.18));zout.addEventListener('click',()=>zoom(scale/1.18));reset.addEventListener('click',resetView);
  shell.addEventListener('wheel',e=>{e.preventDefault();const r=shell.getBoundingClientRect();zoom(scale*(e.deltaY<0?1.12:.89),e.clientX-r.left,e.clientY-r.top)},{passive:false});
  shell.addEventListener('pointerdown',e=>{if(e.target.closest('a,[data-branch],[data-toggle-main]'))return;drag=true;lastX=e.clientX;lastY=e.clientY;shell.setPointerCapture(e.pointerId);shell.classList.add('dragging')});shell.addEventListener('pointermove',e=>{if(!drag)return;tx+=e.clientX-lastX;ty+=e.clientY-lastY;lastX=e.clientX;lastY=e.clientY;apply()});shell.addEventListener('pointerup',()=>{drag=false;shell.classList.remove('dragging')});shell.addEventListener('pointercancel',()=>{drag=false;shell.classList.remove('dragging')});apply();
}
</script>
