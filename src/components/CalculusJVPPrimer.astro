---
import katex from 'katex';
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
const render = (s) => katex.renderToString(s,{displayMode:true,throwOnError:false,strict:false});
const labels = isZh ? ['導數','偏微分','Total derivative','JVP'] : ['Derivative','Partial','Total derivative','JVP'];
---
<div class="calc" data-calc data-lang={isZh?'zh':'en'}>
  <div class="calc-head">
    <div class="calc-copy"><span>CALCULUS PRIMER</span><strong>{isZh?'從 0 到 MeanFlow 所需的偏微分與 JVP':'From zero to the partial derivatives and JVP MeanFlow needs'}</strong><p>{isZh?'依序點 1→4；每一步只增加一個新概念。':'Follow steps 1→4; each step adds only one new idea.'}</p></div>
    <div class="steps" role="tablist" aria-label={isZh?'微積分學習步驟':'Calculus learning steps'}>{labels.map((label,i)=><button class={i===0?'active':''} data-step={i} role="tab"><span>{i+1}</span><small>{label}</small></button>)}</div>
  </div>

  <div class="step-guide"><b data-guide-title>{isZh?'現在：只看一個 input 的局部變化率':'Now: local change with one input'}</b><span>{isZh?'完成後按「下一步」；不需要一次讀完整頁。':'Use Next after each concept; you do not need to absorb the whole page at once.'}</span></div>

  <section data-panel="0"><span class="eyebrow">Ordinary derivative</span><h3>{isZh?'一個輸入：導數就是局部變化率':'One input: a derivative is a local rate of change'}</h3><div class="math" set:html={render(String.raw`f(x)=x^2,\qquad \frac{df}{dx}=2x`)}></div><div class="concept-row"><div><small>{isZh?'你改變':'You change'}</small><strong>x</strong></div><div><small>{isZh?'你觀察':'You observe'}</small><strong>f(x)</strong></div><div><small>{isZh?'導數回答':'Derivative answers'}</small><strong>{isZh?'改一點 x，f 改多少？':'How much does f change?'}</strong></div></div></section>

  <section data-panel="1" hidden><span class="eyebrow">Partial derivative</span><h3>{isZh?'多個輸入：固定其他變數，只問一個方向':'Multiple inputs: hold the others fixed and inspect one direction'}</h3><div class="math" set:html={render(String.raw`u(z,t)=z^2+0.6zt+2t`)}></div><div class="equal-grid two"><div><small>z direction</small><strong>∂u/∂z = 2z + 0.6t</strong><span>{isZh?'固定 t，只改 z':'hold t; vary z'}</span></div><div><small>t direction</small><strong>∂u/∂t = 0.6z + 2</strong><span>{isZh?'固定 z，只改 t':'hold z; vary t'}</span></div></div><p>{isZh?'偏微分沒有引入新的神祕運算；只是把其他 inputs 暫時固定。':'A partial derivative introduces no mysterious new operation; it temporarily freezes the other inputs.'}</p></section>

  <section data-panel="2" hidden><span class="eyebrow">Total derivative</span><h3>{isZh?'如果 z 也跟著 t 移動，兩種變化必須相加':'If z also moves with t, both sources of change must be added'}</h3><div class="math" set:html={render(String.raw`\frac{du}{dt}=\frac{\partial u}{\partial z}\frac{dz}{dt}+\frac{\partial u}{\partial t}`)}></div><div class="equal-grid two"><div><small>{isZh?'state contribution':'state contribution'}</small><strong>(∂u/∂z)(dz/dt)</strong><span>{isZh?'因為 z 自己在移動':'because z itself moves'}</span></div><div><small>{isZh?'time contribution':'time contribution'}</small><strong>∂u/∂t</strong><span>{isZh?'因為 t 自己改變':'because t itself changes'}</span></div></div><p>{isZh?'MeanFlow 中 dz/dt=v，因此 du/dt=∂z u·v+∂t u。':'In MeanFlow dz/dt=v, so du/dt=∂z u·v+∂t u.'}</p></section>

  <section data-panel="3" hidden><span class="eyebrow">JVP</span><h3>{isZh?'JVP：沿指定 tangent 移動時，network output 怎麼變？':'JVP: how does the network output change along a chosen tangent?'}</h3><div class="math" set:html={render(String.raw`q(t)=(z_t,r,t),\quad q'(t)=[v,0,1],\quad \frac{du}{dt}=J_u(q)[v,0,1]`)}></div><div class="equal-grid three"><div><small>{isZh?'被微分的 function':'differentiated function'}</small><strong>uθ(z,r,t)</strong><span>{isZh?'永遠是 uθ':'always uθ'}</span></div><div><small>{isZh?'tangent 的 state 部分':'state tangent'}</small><strong>v or vθ</strong><span>{isZh?'提供移動方向':'supplies direction'}</span></div><div><small>{isZh?'固定 endpoint':'fixed endpoint'}</small><strong>dr/dt = 0</strong><span>{isZh?'r 不跟 t 一起動':'r does not move with t'}</span></div></div><div class="callout">{isZh?'所以 JVP(uθ;vθ) 不是「對 vθ 微分」：被微分的是 uθ，vθ 只提供方向。':'Therefore JVP(uθ;vθ) does not differentiate vθ: uθ is differentiated, while vθ only supplies the direction.'}</div></section>

  <div class="calc-nav"><button data-prev disabled>← {isZh?'上一步':'Previous'}</button><span><b data-counter>1 / 4</b><small data-nav-label>{labels[0]}</small></span><button data-next>{isZh?'下一步':'Next'} →</button></div>
</div>
<style>
.calc{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface-2);margin:1rem 0 1.4rem;overflow:hidden}.calc-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(22rem,.85fr);gap:1rem;align-items:center}.calc-copy{min-width:0}.calc-head span,.eyebrow{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.1em}.calc-head strong{display:block;margin-top:.2rem}.calc-head p{margin:.25rem 0 0;color:var(--rh-muted)}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.4rem;align-items:stretch}.steps button{box-sizing:border-box;width:100%;height:3.35rem;margin:0;border:1px solid var(--rh-border);border-radius:.6rem;background:var(--rh-surface);color:var(--rh-text);font:inherit;cursor:pointer;padding:.35rem .3rem;display:grid;grid-template-columns:auto 1fr;gap:.35rem;align-items:center;justify-items:start}.steps button>span{display:grid;place-items:center;width:1.55rem;height:1.55rem;border-radius:50%;background:var(--rh-surface-2);color:var(--rh-coffee);font-size:.72rem;letter-spacing:0}.steps button small{font-size:.7rem;line-height:1.15;text-align:left;color:inherit}.steps button.active{background:var(--rh-coffee);color:#fff;border-color:var(--rh-coffee)}.steps button.active>span{background:rgba(255,255,255,.16);color:#fff}.step-guide{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.7rem;align-items:center;margin-top:.85rem;border:1px solid var(--rh-border);border-radius:.65rem;padding:.6rem .7rem;background:var(--rh-surface)}.step-guide b{font-size:.8rem}.step-guide span{color:var(--rh-muted);font-size:.76rem}.calc section{margin-top:.8rem;border-top:1px solid var(--rh-border);padding-top:.9rem;min-height:16.2rem}.calc h3{margin:.3rem 0 .6rem;line-height:1.35}.calc p{color:var(--rh-muted);line-height:1.65}.math{max-width:100%;overflow-x:auto;border:1px solid var(--rh-border);border-radius:.65rem;background:var(--rh-surface);padding:.55rem .7rem}.math :global(.katex-display){width:max-content;min-width:100%;margin:.2rem 0}.equal-grid,.concept-row{display:grid;gap:.6rem;margin:.7rem 0;align-items:stretch}.equal-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.equal-grid.three,.concept-row{grid-template-columns:repeat(3,minmax(0,1fr))}.equal-grid>div,.concept-row>div{box-sizing:border-box;min-width:0;height:100%;min-height:5.5rem;border:1px solid var(--rh-border);border-radius:.65rem;background:var(--rh-surface);padding:.7rem;display:flex;flex-direction:column;justify-content:flex-start}.equal-grid small,.concept-row small{display:block;color:var(--rh-muted);font-size:.7rem;min-height:1.05rem}.equal-grid strong,.concept-row strong{display:block;margin-top:.25rem;overflow-wrap:anywhere;font-size:.86rem;line-height:1.35}.equal-grid span{display:block;margin-top:auto;padding-top:.35rem;color:var(--rh-muted);font-size:.72rem;line-height:1.35}.callout{border-left:3px solid var(--rh-caramel);border-radius:.45rem;background:color-mix(in srgb,var(--rh-caramel) 7%,var(--rh-surface));padding:.7rem .8rem;line-height:1.55}.calc-nav{display:grid;grid-template-columns:8rem minmax(0,1fr) 8rem;gap:.6rem;align-items:center;margin-top:.75rem;border-top:1px solid var(--rh-border);padding-top:.75rem}.calc-nav button{height:2.55rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface);color:var(--rh-text);font:inherit;cursor:pointer}.calc-nav button:disabled{opacity:.42;cursor:default}.calc-nav>span{text-align:center}.calc-nav b,.calc-nav small{display:block}.calc-nav small{color:var(--rh-muted);font-size:.7rem;margin-top:.1rem}
@media(max-width:900px){.calc-head{grid-template-columns:1fr}.steps{width:100%}}@media(max-width:720px){.equal-grid.two,.equal-grid.three,.concept-row{grid-template-columns:1fr}.equal-grid>div,.concept-row>div{min-height:auto}.calc section{min-height:18rem}.step-guide{grid-template-columns:1fr}.calc-nav{grid-template-columns:1fr 1fr}.calc-nav>span{grid-column:1/-1;grid-row:1}.steps button{grid-template-columns:1fr;justify-items:center;height:3.7rem}.steps button small{text-align:center}}
</style>
<script define:vars={{labels}}>
for(const root of document.querySelectorAll('[data-calc]')){if(root.dataset.ready)continue;root.dataset.ready='1';const tabs=[...root.querySelectorAll('[data-step]')],panels=[...root.querySelectorAll('[data-panel]')],prev=root.querySelector('[data-prev]'),next=root.querySelector('[data-next]'),counter=root.querySelector('[data-counter]'),navLabel=root.querySelector('[data-nav-label]'),guide=root.querySelector('[data-guide-title]');let idx=0;const zh=root.dataset.lang==='zh';const guides=zh?['現在：只看一個 input 的局部變化率','現在：固定其他 input，只看一個方向','現在：把 state 與 time 的變化加起來','現在：把 total derivative 寫成 Jacobian × tangent']:['Now: local change with one input','Now: freeze other inputs and inspect one direction','Now: add state and time contributions','Now: write the total derivative as Jacobian × tangent'];function set(i){idx=Math.max(0,Math.min(3,i));tabs.forEach((b,j)=>{b.classList.toggle('active',idx===j);b.setAttribute('aria-selected',idx===j?'true':'false')});panels.forEach((p,j)=>p.hidden=idx!==j);prev.disabled=idx===0;next.disabled=idx===3;counter.textContent=`${idx+1} / 4`;navLabel.textContent=labels[idx];guide.textContent=guides[idx]}tabs.forEach((b,i)=>b.addEventListener('click',()=>set(i)));prev.addEventListener('click',()=>set(idx-1));next.addEventListener('click',()=>set(idx+1));set(0)}
</script>
