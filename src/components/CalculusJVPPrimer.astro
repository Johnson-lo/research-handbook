---
import katex from 'katex';
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
const render = (s) => katex.renderToString(s,{displayMode:true,throwOnError:false,strict:false});
---
<div class="calc" data-calc data-lang={isZh?'zh':'en'}>
  <div class="calc-head"><div><span>CALCULUS PRIMER</span><strong>{isZh?'從 0 到 MeanFlow 所需的偏微分與 JVP':'From zero to the partial derivatives and JVP MeanFlow needs'}</strong><p>{isZh?'每次只增加一個概念：普通導數 → 偏微分 → total derivative → JVP。':'One concept at a time: ordinary derivative → partial derivative → total derivative → JVP.'}</p></div><div class="steps"><button class="active" data-step="0">1</button><button data-step="1">2</button><button data-step="2">3</button><button data-step="3">4</button></div></div>
  <section data-panel="0"><span class="eyebrow">Ordinary derivative</span><h3>{isZh?'一個輸入：導數就是局部變化率':'One input: a derivative is a local rate of change'}</h3><div class="math" set:html={render(String.raw`f(x)=x^2,\qquad \frac{df}{dx}=2x`)}></div><p>{isZh?'把 x 改一點點，f 會改多少？這就是導數回答的問題。':'If x changes by a tiny amount, how much does f change?'}</p></section>
  <section data-panel="1" hidden><span class="eyebrow">Partial derivative</span><h3>{isZh?'多個輸入：先固定其他變數，只看一個方向':'Multiple inputs: hold the others fixed and inspect one direction'}</h3><div class="math" set:html={render(String.raw`u(z,t)=z^2+0.6zt+2t`)}></div><div class="pair"><div><small>z direction</small><strong>∂u/∂z = 2z + 0.6t</strong></div><div><small>t direction</small><strong>∂u/∂t = 0.6z + 2</strong></div></div><p>{isZh?'偏微分不是不同種類的微積分；只是「其他 inputs 暫時不動」。':'A partial derivative simply means the other inputs are temporarily held fixed.'}</p></section>
  <section data-panel="2" hidden><span class="eyebrow">Total derivative</span><h3>{isZh?'如果 z 也隨 t 動，就要把兩種變化一起算':'If z also moves with t, both changes contribute'}</h3><div class="math" set:html={render(String.raw`\frac{du}{dt}=\frac{\partial u}{\partial z}\frac{dz}{dt}+\frac{\partial u}{\partial t}`)}></div><div class="pair"><div><small>{isZh?'state 造成的變化':'state contribution'}</small><strong>(∂u/∂z)(dz/dt)</strong></div><div><small>{isZh?'time 直接造成的變化':'time contribution'}</small><strong>∂u/∂t</strong></div></div><p>{isZh?'MeanFlow 中 dz/dt=v，所以 du/dt=∂z u·v+∂t u。':'In MeanFlow dz/dt=v, so du/dt=∂z u·v+∂t u.'}</p></section>
  <section data-panel="3" hidden><span class="eyebrow">JVP</span><h3>{isZh?'JVP 就是「沿指定 tangent 移動時，輸出怎麼變」':'A JVP asks how the output changes along a chosen tangent'}</h3><div class="math" set:html={render(String.raw`q(t)=(z_t,r,t),\quad q'(t)=[v,0,1],\quad \frac{du}{dt}=J_u(q)[v,0,1]`)}></div><div class="roles"><div><small>{isZh?'被微分的 function':'differentiated function'}</small><strong>uθ(z,r,t)</strong></div><div><small>{isZh?'tangent 的 state 部分':'state part of tangent'}</small><strong>v or vθ</strong></div><div><small>{isZh?'固定的 endpoint':'fixed endpoint'}</small><strong>dr/dt = 0</strong></div></div><p>{isZh?'所以 JVP(uθ;vθ) 不是「對 vθ 微分」；被微分的一直是 uθ，vθ 提供方向。':'So JVP(uθ;vθ) does not differentiate vθ. The function being differentiated is uθ; vθ supplies the direction.'}</p></section>
</div>
<style>
.calc{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface-2);margin:1rem 0 1.4rem;overflow:hidden}.calc-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center}.calc-head span,.eyebrow{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.1em}.calc-head strong{display:block;margin-top:.2rem}.calc-head p{margin:.25rem 0 0;color:var(--rh-muted)}.steps{display:grid;grid-template-columns:repeat(4,2.7rem);gap:.35rem}.steps button{height:2.45rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface);color:var(--rh-text);font:inherit;cursor:pointer}.steps button.active{background:var(--rh-coffee);color:#fff;border-color:var(--rh-coffee)}.calc section{margin-top:.9rem;border-top:1px solid var(--rh-border);padding-top:.9rem;min-height:15.5rem}.calc h3{margin:.3rem 0 .6rem}.calc p{color:var(--rh-muted);line-height:1.65}.math{max-width:100%;overflow-x:auto;border:1px solid var(--rh-border);border-radius:.65rem;background:var(--rh-surface);padding:.55rem .7rem}.math :global(.katex-display){width:max-content;min-width:100%;margin:.2rem 0}.pair,.roles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:.7rem 0}.roles{grid-template-columns:repeat(3,minmax(0,1fr))}.pair>div,.roles>div{border:1px solid var(--rh-border);border-radius:.65rem;background:var(--rh-surface);padding:.7rem;min-width:0}.pair small,.roles small{display:block;color:var(--rh-muted);font-size:.7rem}.pair strong,.roles strong{display:block;margin-top:.25rem;overflow-wrap:anywhere;font-size:.88rem}
@media(max-width:720px){.calc-head{grid-template-columns:1fr}.steps{grid-template-columns:repeat(4,minmax(0,1fr));width:100%}.pair,.roles{grid-template-columns:1fr}.calc section{min-height:17rem}}
</style>
<script>
for(const root of document.querySelectorAll('[data-calc]')){if(root.dataset.ready)continue;root.dataset.ready='1';const tabs=[...root.querySelectorAll('[data-step]')],panels=[...root.querySelectorAll('[data-panel]')];function set(i){tabs.forEach((b,j)=>b.classList.toggle('active',i===j));panels.forEach((p,j)=>p.hidden=i!==j)}tabs.forEach((b,i)=>b.addEventListener('click',()=>set(i)));set(0)}
</script>
