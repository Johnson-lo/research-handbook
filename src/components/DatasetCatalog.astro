---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';

const categories = [
  ['all', isZh ? '全部任務' : 'All tasks'],
  ['image', isZh ? '影像 / 視覺' : 'Image / Vision'],
  ['multimodal', isZh ? '圖文 / 多模態' : 'Image-text / Multimodal'],
  ['video', isZh ? '影片' : 'Video'],
  ['robotics', isZh ? '機器人 / Action' : 'Robotics / Action'],
  ['driving', isZh ? '自駕 / Motion' : 'Driving / Motion'],
  ['audio', isZh ? '語音 / 音訊 / 音樂' : 'Speech / Audio / Music'],
  ['text', isZh ? '文字 / LLM' : 'Text / LLM'],
  ['molecule', isZh ? '分子 / 蛋白 / 材料' : 'Molecule / Protein / Materials'],
  ['timeseries', isZh ? '時間序列 / 動力系統' : 'Time series / Dynamics'],
  ['3d', isZh ? '3D / 人體動作' : '3D / Human Motion'],
  ['medical', isZh ? '醫療 / 生醫' : 'Medical / Biomedical'],
  ['sequence', isZh ? '離散序列 / DNA' : 'Discrete sequence / DNA'],
];

const accessLabels = {
  open: isZh ? '公開下載 / 依原授權' : 'Public download / source license',
  terms: isZh ? '需同意使用條款' : 'Terms apply',
  registration: isZh ? '需註冊 / 申請' : 'Registration / application',
  restricted: isZh ? '受限存取 / DUA' : 'Restricted / DUA',
  volatile: isZh ? '來源易變 / URL 型資料' : 'Volatile / URL-based',
  synthetic: isZh ? '可自行模擬生成' : 'Simulation-generated',
};

const datasets = [
  {name:'CIFAR-10',cat:'image',tasks:['unconditional generation','classification','toy diffusion / flow'],scale:'60,000 · 32×32 RGB · 10 classes',access:'open',url:'https://www.cs.toronto.edu/~kriz/cifar.html',zh:'最便宜的 image-generation smoke test。適合先驗證 loss、ODE / flow、sampling 與 overfit 行為，再移到大資料。',en:'A cheap image-generation smoke test for validating losses, flows, sampling, and overfitting before scaling up.'},
  {name:'ImageNet-1K / ILSVRC2012',cat:'image',tasks:['class-conditional generation','classification','FID benchmark'],scale:'1,281,167 train · 50,000 val · 1,000 classes',access:'terms',url:'https://www.image-net.org/download.php',zh:'MeanFlow 系列最重要的可比 benchmark。256×256 class-conditional generation 可直接和 MeanFlow、iMF、AlphaFlow 等論文對照。',en:'The central comparable benchmark for the MeanFlow family, especially 256×256 class-conditional generation.'},
  {name:'FFHQ',cat:'image',tasks:['face generation','GAN / diffusion benchmark','high-resolution generation'],scale:'70,000 · 1024×1024',access:'terms',url:'https://github.com/NVlabs/ffhq-dataset',zh:'高解析人臉生成常用資料；適合研究高頻細節與少類別 domain generation。NVIDIA 明確註記不應用於臉部辨識。',en:'A high-resolution face-generation benchmark useful for detail modeling; NVIDIA explicitly excludes face-recognition use.'},
  {name:'CelebA',cat:'image',tasks:['face generation','attribute conditioning','representation learning'],scale:'202,599 face images · 40 attributes · 10,177 identities',access:'terms',url:'https://mmlab.ie.cuhk.edu.hk/projects/CelebA.html',zh:'比 FFHQ 更適合 attribute-conditioned generation，例如 hair、smile、glasses 等條件控制。',en:'Useful for attribute-conditioned face generation, e.g. hair, smile, glasses, and representation learning.'},
  {name:'LSUN',cat:'image',tasks:['scene generation','unconditional generation','high-resolution benchmark'],scale:'Millions of images across scene/object categories',access:'open',url:'https://www.yf.io/p/lsun',zh:'GAN / diffusion 歷史上常見的大型場景資料，適合 bedroom、church、tower 等單一 domain 生成。',en:'A classic large-scale scene benchmark for domain-specific generation such as bedrooms and churches.'},
  {name:'AFHQ v2',cat:'image',tasks:['animal generation','domain translation','few-domain generation'],scale:'~15,000 high-quality images · cat / dog / wild',access:'open',url:'https://github.com/clovaai/stargan-v2',zh:'三個動物 domain，資料量不大；適合小資源 generation、domain translation 與快速 ablation。',en:'Three animal domains at manageable scale; useful for low-resource generation and domain-translation ablations.'},
  {name:'COCO 2017',cat:'multimodal',tasks:['text-to-image','captioning','detection','segmentation','evaluation'],scale:'118k train images · 5k val · captions + boxes + masks',access:'open',url:'https://cocodataset.org/',zh:'圖文生成與視覺條件任務的核心資料。RMFlow 也使用 COCO 2017 的 5k split 做額外 text-image 評估。',en:'A core image-text and perception dataset; RMFlow also uses the COCO 2017 5k split for additional text-image evaluation.'},
  {name:'Open Images V7',cat:'image',tasks:['detection','segmentation','classification','visual relationship'],scale:'~9.18M images · boxes / masks / labels / relationships',access:'terms',url:'https://storage.googleapis.com/openimages/web/index.html',zh:'適合大規模 vision pretraining、detector / segmenter，以及需要多標籤與關係 annotation 的條件模型。',en:'Large-scale vision pretraining with labels, boxes, masks, and visual relationships.'},
  {name:'ADE20K',cat:'image',tasks:['semantic segmentation','scene parsing','layout conditioning'],scale:'20k train · 2k val · 150 semantic classes',access:'terms',url:'https://groups.csail.mit.edu/vision/datasets/ADE20K/',zh:'場景 parsing 與 semantic layout generation / conditioning 很常用，可當 segmentation-conditioned generative model 的資料來源。',en:'A standard scene-parsing dataset useful for semantic-layout conditioning and segmentation-driven generation.'},
  {name:'Cityscapes',cat:'driving',tasks:['semantic segmentation','instance segmentation','urban perception'],scale:'5k fine + 20k coarse annotations · 50 cities',access:'terms',url:'https://www.cityscapes-dataset.com/',zh:'城市街景 segmentation 經典 benchmark；有 stereo、GPS / odometry 等資訊，適合自駕 perception 或 image-to-image。',en:'A classic urban segmentation benchmark with stereo and vehicle metadata for autonomous-driving perception.'},
  {name:'SA-1B',cat:'image',tasks:['segmentation foundation model','mask generation','promptable segmentation'],scale:'11M images · 1.1B class-agnostic masks',access:'terms',url:'https://ai.meta.com/datasets/segment-anything/',zh:'超大規模 mask pretraining。適合 segmentation foundation model 或把 mask 當 generative conditioning；研究用途與資料授權需看 Meta 條款。',en:'Massive mask pretraining for segmentation foundation models and mask-conditioned generation; Meta data terms apply.'},
  {name:'LAION-5B',cat:'multimodal',tasks:['text-to-image pretraining','CLIP-style pretraining','multilingual vision-language'],scale:'5.85B CLIP-filtered image-text pairs',access:'volatile',url:'https://laion.ai/blog/laion-5b/',zh:'web-scale 圖文預訓練代表。規模極大，但 URL、權利、內容品質、安全過濾與去重都必須自行處理。',en:'A representative web-scale image-text corpus; URLs, rights, filtering, deduplication, and safety require careful handling.'},
  {name:'Conceptual Captions 3M (CC3M)',cat:'multimodal',tasks:['image captioning','vision-language pretraining','text-image retrieval'],scale:'~3.3M training URL-caption pairs',access:'volatile',url:'https://ai.google.com/research/ConceptualCaptions/download',zh:'比 LAION 小很多，較適合中型 multimodal pretraining / captioning 實驗；下載的是 URL / caption，圖片可隨時間失效。',en:'A manageable image-caption corpus for mid-scale VLM experiments; image URLs can decay over time.'},
  {name:'Conceptual 12M (CC12M)',cat:'multimodal',tasks:['vision-language pretraining','text-to-image','captioning'],scale:'~12M image-URL / caption pairs',access:'volatile',url:'https://github.com/google-research-datasets/conceptual-12m',zh:'CC3M 的更大、更寬鬆版本；適合圖文 pretraining，但同樣需處理 URL decay 與資料清理。',en:'A larger, more diverse successor to CC3M for vision-language pretraining; URL decay remains an issue.'},
  {name:'DataComp',cat:'multimodal',tasks:['dataset filtering','CLIP pretraining','data-centric VLM research'],scale:'Benchmark tracks from manageable to billion-scale pools',access:'terms',url:'https://www.datacomp.ai/',zh:'不是單一固定資料集，而是比較「資料選擇 / filtering」策略的 benchmark；適合研究資料品質對 VLM / generative pretraining 的影響。',en:'A benchmark for data-selection and filtering strategies rather than a single fixed corpus.'},
  {name:'UCF101',cat:'video',tasks:['action recognition','video generation','video representation'],scale:'13,320 videos · 101 action classes',access:'open',url:'https://www.crcv.ucf.edu/data/UCF101.php',zh:'小型動作影片基準，適合 video model prototype、latent video generation 與快速驗證。',en:'A manageable action-video benchmark for prototypes, latent video generation, and representation learning.'},
  {name:'Kinetics-700',cat:'video',tasks:['video pretraining','action recognition','video generation'],scale:'~650k clips · ~10 s each · 700 classes',access:'volatile',url:'https://deepmind.google/discover/blog/kinetics-700-a-new-dataset-and-benchmark-for-human-action-recognition/',zh:'大型人類動作影片 pretraining。YouTube 來源會有 URL 失效，因此實際可取得數量會變。',en:'Large-scale human-action video pretraining; YouTube URL availability changes over time.'},
  {name:'Something-Something V2',cat:'video',tasks:['temporal reasoning','action understanding','video generation'],scale:'~220k short videos · fine-grained human-object interactions',access:'terms',url:'https://developer.qualcomm.com/software/ai-datasets/something-something',zh:'重點不是場景辨識，而是物體如何隨時間被操作；適合 temporal reasoning 與 action-conditioned video。',en:'Emphasizes fine-grained temporal human-object interactions rather than scene recognition.'},
  {name:'KTH Actions',cat:'video',tasks:['video prediction','action recognition','latent flow benchmark'],scale:'6 actions · 25 subjects · 4 scenarios · 2,391 sequences',access:'open',url:'https://www.csc.kth.se/cvap/actions/',zh:'小而乾淨，適合 video prediction / dynamics toy benchmark；Flow Divergence Matching 的影片實驗使用 KTH。',en:'A small clean benchmark for video prediction; used in the Flow Divergence Matching video experiments.'},
  {name:'Ego4D',cat:'video',tasks:['egocentric video','long-horizon forecasting','audio-visual','embodied understanding'],scale:'~3,600 h first-person video · 900+ participants',access:'terms',url:'https://ego4d-data.org/',zh:'第一人稱長影片與多模態標註，適合 embodied forecasting、long-horizon video / action understanding。',en:'Large first-person video for embodied forecasting, long-horizon understanding, and multimodal learning.'},
  {name:'WebVid-10M',cat:'video',tasks:['text-to-video pretraining','video-text retrieval','video diffusion'],scale:'10M video-text pairs',access:'volatile',url:'https://github.com/m-bain/webvid',zh:'歷史上常見的 text-to-video web corpus；專案已說明公開資料分發受法律要求停止，不能把它當成穩定可下載來源。',en:'A historically important text-video corpus; public distribution was halted, so it should not be treated as a stable download source.'},
  {name:'BAIR Robot Pushing',cat:'video',tasks:['video prediction','robot dynamics','action-conditioned generation'],scale:'~44k robot-pushing training sequences',access:'open',url:'https://www.tensorflow.org/datasets/catalog/bair_robot_pushing_small',zh:'經典 action-conditioned video prediction 小資料；可把 action 與 future frames 的關係先做成 toy experiment。',en:'A classic action-conditioned robot-video benchmark for future-frame prediction and dynamics prototypes.'},
  {name:'DROID',cat:'robotics',tasks:['robot manipulation','behavior cloning','vision-language-action','generalization'],scale:'76k trajectories · ~350 h · 564 scenes · 86 tasks',access:'open',url:'https://droid-dataset.github.io/',zh:'真實世界 manipulation 的重要大資料，跨場景、跨收集者，適合 policy / action generation 與 generalization。',en:'A large real-world manipulation dataset for policy learning, action generation, and cross-scene generalization.'},
  {name:'BridgeData V2',cat:'robotics',tasks:['language-conditioned manipulation','behavior cloning','multitask policy'],scale:'53,896 trajectories · 13 skills · 24 environments',access:'open',url:'https://rail-berkeley.github.io/bridgedata/',zh:'較容易上手的真實 robot dataset，有語言 instruction；很適合做 diffusion / flow policy 的研究起點。',en:'An accessible real-robot dataset with language instructions, useful for diffusion/flow policies and multitask imitation.'},
  {name:'Open X-Embodiment',cat:'robotics',tasks:['generalist robot policy','cross-embodiment transfer','VLA pretraining'],scale:'1M+ trajectories aggregated from many robot datasets / embodiments',access:'terms',url:'https://robotics-transformer-x.github.io/',zh:'多實驗室、多 robot embodiment 的聚合資料；適合 generalist VLA / cross-robot transfer，但資料格式與 embodiment 差異要處理。',en:'A multi-lab, multi-embodiment aggregation for generalist VLA and cross-robot transfer.'},
  {name:'RoboMimic datasets',cat:'robotics',tasks:['imitation learning','offline RL','robot manipulation'],scale:'Suite of simulated + real manipulation datasets',access:'open',url:'https://robomimic.github.io/docs/datasets/overview.html',zh:'資料格式與 baseline 很完整，適合先做 BC / offline policy，再替換成 flow / diffusion action model。',en:'A well-structured benchmark suite for BC/offline RL before replacing the policy with a flow/diffusion action model.'},
  {name:'LIBERO',cat:'robotics',tasks:['lifelong robot learning','language-conditioned manipulation','continual learning'],scale:'4 benchmark suites; LIBERO-100 contains 100 tasks',access:'open',url:'https://libero-project.github.io/',zh:'適合研究多任務、continual / lifelong policy，以及長期是否遺忘；有語言與 task structure。',en:'Designed for multitask, continual, and lifelong robot learning with language and structured task suites.'},
  {name:'RLBench',cat:'robotics',tasks:['sim manipulation','multitask RL / IL','language-conditioned action'],scale:'100+ simulated manipulation tasks',access:'open',url:'https://github.com/stepjam/RLBench',zh:'CoppeliaSim-based 大量 manipulation task，適合低成本測 policy architecture 與 action trajectory generation。',en:'A large simulated manipulation suite for low-cost policy and action-trajectory experiments.'},
  {name:'CALVIN',cat:'robotics',tasks:['long-horizon manipulation','language-conditioned policy','sequence planning'],scale:'Long-horizon simulated manipulation benchmark · 34 atomic tasks',access:'open',url:'https://github.com/mees/calvin',zh:'強調連續完成多個 language goal，適合測 long-horizon action generation，而不只是單一 pick-and-place。',en:'Focuses on chaining language-conditioned manipulation goals for long-horizon policy evaluation.'},
  {name:'ManiSkill',cat:'robotics',tasks:['sim manipulation','RL / IL','contact-rich control'],scale:'Many GPU-parallelized simulated manipulation tasks',access:'open',url:'https://maniskill.readthedocs.io/',zh:'GPU simulation 速度快，適合大量 ablation、policy training 與 contact-rich task；比 real robot 更適合先測 loss。',en:'Fast GPU simulation for large ablations, policy learning, and contact-rich manipulation.'},
  {name:'MimicGen',cat:'robotics',tasks:['synthetic demonstrations','imitation learning','data generation'],scale:'Scalable generated demonstration datasets from few source demonstrations',access:'open',url:'https://mimicgen.github.io/',zh:'重點是「自動擴增 demonstration」，適合研究 data scaling、few-demo → many-demo，或與 flow action model 結合。',en:'Automates demonstration expansion, useful for studying data scaling and few-demo-to-many-demo policies.'},
  {name:'D4RL',cat:'robotics',tasks:['offline RL','locomotion','control'],scale:'Benchmark suite with large offline transition datasets',access:'open',url:'https://github.com/Farama-Foundation/D4RL',zh:'offline RL 經典資料，包含 locomotion / navigation 等；如果研究 action distribution 而非 image generation，很適合當對照。',en:'A classic offline-RL suite for locomotion/navigation and action-distribution modeling.'},
  {name:'nuScenes',cat:'driving',tasks:['3D detection','tracking','sensor fusion','trajectory prediction'],scale:'1,000 × 20 s scenes · 1.4M camera images · 390k lidar sweeps',access:'terms',url:'https://www.nuscenes.org/nuscenes',zh:'camera + lidar + radar + map 的多感測器自駕 benchmark，適合 perception、trajectory / scene generation。',en:'A multimodal autonomous-driving benchmark for perception, tracking, trajectory, and scene generation.'},
  {name:'Waymo Open Dataset',cat:'driving',tasks:['perception','motion forecasting','sim agents','end-to-end driving'],scale:'2,030 perception segments · 103,354 motion segments · 5,000 E2E segments',access:'terms',url:'https://waymo.com/open/',zh:'規模很大的自駕資料族，motion dataset 特別適合 trajectory generative model；目前授權為 non-commercial use。',en:'A large autonomous-driving family; the Motion Dataset is especially relevant for trajectory generative models. Non-commercial terms apply.'},
  {name:'Argoverse 2',cat:'driving',tasks:['motion forecasting','3D perception','HD maps','scenario generation'],scale:'250k motion scenarios · 1,000 annotated sensor scenarios',access:'terms',url:'https://www.argoverse.org/av2.html',zh:'motion forecasting 資料很適合 conditional trajectory generation；有豐富 HD map 與長尾互動。',en:'Excellent for conditional trajectory generation and motion forecasting with rich HD maps and long-tail interactions.'},
  {name:'KITTI',cat:'driving',tasks:['stereo','optical flow','3D detection','odometry','depth'],scale:'Multiple benchmark subsets; camera + lidar + GPS/IMU',access:'terms',url:'https://www.cvlibs.net/datasets/kitti/',zh:'自駕 perception 的經典小型 benchmark；現代規模不大，但適合快速 debug 與和歷史方法比較。',en:'A classic compact autonomous-driving benchmark for fast debugging and historical comparisons.'},
  {name:'BDD100K',cat:'driving',tasks:['driving video','detection','lane / drivable area','tracking'],scale:'100k driving videos with diverse weather / time',access:'terms',url:'https://bdd-data.berkeley.edu/',zh:'影像為主的 driving dataset，場景條件多樣；適合 camera-only perception、video / trajectory conditioning。',en:'A diverse camera-centric driving dataset for perception and conditional video/trajectory research.'},
  {name:'LibriSpeech',cat:'audio',tasks:['ASR','speech generation','speech representation'],scale:'~1,000 h · 16 kHz read English speech',access:'open',url:'https://www.openslr.org/12',zh:'語音模型標準基準之一；可做 ASR、speech diffusion / flow、representation pretraining。',en:'A standard speech benchmark for ASR, speech generation, and representation learning.'},
  {name:'LibriTTS',cat:'audio',tasks:['text-to-speech','speaker-conditioned speech','voice modeling'],scale:'~585 h · 24 kHz multi-speaker English',access:'open',url:'https://www.openslr.org/60',zh:'比 LibriSpeech 更偏 TTS，保留較高取樣率與句子資訊；適合 conditional speech generation。',en:'A TTS-oriented derivative of LibriSpeech for conditional and multi-speaker speech generation.'},
  {name:'LJSpeech',cat:'audio',tasks:['single-speaker TTS','speech generation','small-scale prototype'],scale:'13,100 clips · ~24 h · single speaker',access:'open',url:'https://keithito.com/LJ-Speech-Dataset/',zh:'單 speaker、小資料，適合快速 TTS / flow-matching speech prototype，但不適合測 speaker diversity。',en:'A small single-speaker corpus for quick TTS prototypes; unsuitable for speaker-diversity evaluation.'},
  {name:'AudioSet',cat:'audio',tasks:['audio event recognition','audio generation','audio-text / label conditioning'],scale:'2,084,320 × 10 s clips · ~5.8k h · 527 labels',access:'volatile',url:'https://research.google.com/audioset/',zh:'超大型 audio-event 標註；YouTube 來源會失效。適合 general audio representation 與 label-conditioned generation。',en:'Large audio-event supervision for general audio models; YouTube availability changes over time.'},
  {name:'FSD50K',cat:'audio',tasks:['sound event classification','audio generation','few-shot audio'],scale:'51,197 clips · >100 h · 200 classes',access:'open',url:'https://zenodo.org/records/4060432',zh:'比 AudioSet 小、較容易下載與重現；適合 sound generation / classification 的中型 benchmark。',en:'A reproducible mid-scale sound-event corpus suitable for audio generation and classification.'},
  {name:'VGGSound',cat:'audio',tasks:['audio-visual learning','sound generation','event recognition'],scale:'200k+ videos · 310+ classes · 550+ h',access:'volatile',url:'https://www.robots.ox.ac.uk/~vgg/data/vggsound/',zh:'audio-visual event 很豐富；官方網站已不再提供原始 download links，需注意可取得性。',en:'Rich audio-visual events, but original download links are no longer distributed from the project site.'},
  {name:'MAESTRO',cat:'audio',tasks:['music generation','piano transcription','audio-MIDI modeling'],scale:'~200 h aligned piano audio + MIDI',access:'open',url:'https://magenta.tensorflow.org/datasets/maestro',zh:'音訊與 MIDI 高精度對齊，適合 symbolic ↔ audio generation、music flow / diffusion。',en:'Precisely aligned piano audio and MIDI for symbolic-to-audio generation and transcription.'},
  {name:'C4',cat:'text',tasks:['language-model pretraining','text generation','representation learning'],scale:'Hundreds of millions of cleaned web documents',access:'open',url:'https://www.tensorflow.org/datasets/catalog/c4',zh:'T5 使用的大型 cleaned Common Crawl corpus；適合 text model pretraining，但仍需考慮 web bias / duplicated content。',en:'The cleaned Common Crawl corpus used by T5; large-scale LM pretraining with typical web-data caveats.'},
  {name:'The Pile',cat:'text',tasks:['LLM pretraining','domain-mixture modeling','text generation'],scale:'825 GiB · 22 source components',access:'open',url:'https://pile.eleuther.ai/',zh:'多來源 mixture corpus，適合研究 domain mixture 與小/中型 LLM；不同 component 有不同授權與內容風險。',en:'A 22-component text mixture for LM pretraining; component licenses and content risks vary.'},
  {name:'FineWeb',cat:'text',tasks:['LLM pretraining','web text generation','data filtering'],scale:'15T+ tokens across large web-derived releases',access:'open',url:'https://huggingface.co/datasets/HuggingFaceFW/fineweb',zh:'現代大規模 web text pretraining 資料；適合研究 filtering / dedup / quality，但硬體與 storage 成本很高。',en:'A modern web-scale corpus for studying filtering, deduplication, and quality at very large scale.'},
  {name:'OpenWebText',cat:'text',tasks:['GPT-style pretraining','text generation','small LM experiments'],scale:'~8M web documents',access:'open',url:'https://skylion007.github.io/OpenWebTextCorpus/',zh:'重建 WebText 風格資料的公開 corpus，規模比 C4 / FineWeb 小，適合較可控的 GPT-style pretraining。',en:'A public WebText-style corpus suitable for more manageable GPT-style pretraining.'},
  {name:'WikiText-103',cat:'text',tasks:['language modeling','long-context evaluation','text generation'],scale:'~103M tokens from high-quality Wikipedia articles',access:'open',url:'https://blog.salesforceairesearch.com/the-wikitext-long-term-dependency-language-modeling-dataset/',zh:'乾淨、規模小；適合 language modeling debug、long-range dependency 與 loss sanity check。',en:'A clean compact language-modeling benchmark for debugging and long-range dependency experiments.'},
  {name:'Common Crawl',cat:'text',tasks:['web-scale pretraining','multimodal crawl source','data curation research'],scale:'Petabyte-scale raw web crawl snapshots',access:'open',url:'https://commoncrawl.org/',zh:'是很多大型 text / image-text dataset 的原料，不是「下載就能訓練」的乾淨資料；必須做 parsing、filtering、去重、安全處理。',en:'Raw web crawl infrastructure; requires parsing, filtering, deduplication, and safety processing before training.'},
  {name:'QM9',cat:'molecule',tasks:['molecule generation','property prediction','3D equivariant modeling'],scale:'133,885 small organic molecules · up to 9 heavy atoms',access:'open',url:'https://www.tensorflow.org/datasets/catalog/qm9',zh:'小分子生成最常見的入門 benchmark；RMFlow 的 context-to-molecule 實驗直接使用 QM9。',en:'A standard small-molecule benchmark used directly by RMFlow for context-to-molecule generation.'},
  {name:'GEOM',cat:'molecule',tasks:['3D molecular conformation','molecule generation','energy modeling'],scale:'~37M conformations · >450k molecules',access:'open',url:'https://github.com/learningmatter-mit/geom',zh:'如果研究 3D molecular generation，比 QM9 更大且有多 conformer / energy 資訊。',en:'A much larger 3D molecular-conformation corpus with multiple conformers and energy information.'},
  {name:'MOSES',cat:'molecule',tasks:['molecular generation','validity / novelty benchmark','scaffold generation'],scale:'~1.94M drug-like molecules',access:'open',url:'https://github.com/molecularsets/moses',zh:'專為 molecular generation benchmark 設計，有 train / test / scaffold split 與 standardized metrics。',en:'Designed specifically for molecular-generation benchmarking with standardized splits and metrics.'},
  {name:'ZINC20',cat:'molecule',tasks:['molecule pretraining','virtual screening','molecular generation'],scale:'Billions of purchasable / enumerated compounds; use task-specific subsets',access:'terms',url:'https://zinc20.docking.org/',zh:'規模非常大，適合 chemical pretraining 或 sampling pool；通常不會整庫直接訓練，而是抽取條件子集。',en:'A massive purchasable-compound database typically used through task-specific subsets rather than full-corpus training.'},
  {name:'ChEMBL',cat:'molecule',tasks:['bioactivity modeling','drug discovery','conditional molecule generation'],scale:'Dynamic database with millions of bioactive compounds / measurements',access:'open',url:'https://www.ebi.ac.uk/chembl/',zh:'含 assay / target / bioactivity，適合 property-conditioned molecule generation；資料庫版本會持續更新，實驗要記版本。',en:'Bioactivity-rich data for property-conditioned generation; record the database release because counts change.'},
  {name:'RCSB Protein Data Bank (PDB)',cat:'molecule',tasks:['protein structure','protein-ligand modeling','3D generative modeling'],scale:'Dynamic archive of experimentally determined biomolecular 3D structures',access:'open',url:'https://www.rcsb.org/',zh:'蛋白與核酸 3D 結構的核心來源；資料量持續更新，必須固定 release date、resolution 與去重策略。',en:'The core experimental biomolecular-structure archive; pin release date, resolution filters, and redundancy rules.'},
  {name:'UniRef50',cat:'molecule',tasks:['protein language-model pretraining','sequence generation','redundancy reduction'],scale:'Dynamic protein sequence clusters at ~50% identity threshold',access:'open',url:'https://www.uniprot.org/help/uniref',zh:'蛋白 sequence pretraining 常用，透過 50% identity clustering 降低高度重複的序列。',en:'Common for protein-language-model pretraining because sequence clustering reduces heavy redundancy.'},
  {name:'Materials Project',cat:'molecule',tasks:['materials generation','property prediction','crystal modeling'],scale:'Large evolving DFT-computed materials database',access:'registration',url:'https://next-gen.materialsproject.org/',zh:'若把 flow / diffusion 延伸到 crystal / material generation，可取得結構與 DFT properties；API 使用通常需要帳號 / key。',en:'A major source for crystal/material generative modeling with structures and DFT properties; API access typically requires an account/key.'},
  {name:'UCR / UEA Time Series Archives',cat:'timeseries',tasks:['time-series classification','representation learning','small benchmark suite'],scale:'128 UCR univariate + 30 UEA multivariate datasets',access:'open',url:'https://www.timeseriesclassification.com/',zh:'不是單一資料，而是一整套小型 time-series benchmark；很適合先測 temporal encoder / flow representation 是否有效。',en:'A large suite of small time-series benchmarks for testing temporal representations before scaling.'},
  {name:'M4 Forecasting',cat:'timeseries',tasks:['forecasting','probabilistic forecasting','sequence generation'],scale:'100,000 time series across multiple frequencies',access:'open',url:'https://github.com/Mcompetitions/M4-methods',zh:'forecasting 經典資料；若研究 generative forecasting，可和傳統 statistical baseline 有直接比較。',en:'A classic forecasting collection useful for comparing generative forecasts against statistical baselines.'},
  {name:'ETT (Electricity Transformer Temperature)',cat:'timeseries',tasks:['long-sequence forecasting','multivariate time series','transformer benchmark'],scale:'2 years · 7 variables · hourly / 15-min variants',access:'open',url:'https://github.com/zhouhaoyi/ETDataset',zh:'現代 long-horizon forecasting 常見 benchmark，規模小且 preprocessing 清楚，適合快速做 flow-based forecasting。',en:'A compact modern long-horizon forecasting benchmark with clear preprocessing and multiple sampling rates.'},
  {name:'ElectricityLoadDiagrams20112014',cat:'timeseries',tasks:['load forecasting','multivariate time series','probabilistic generation'],scale:'370 clients · 15-min electricity consumption · 2011–2014',access:'open',url:'https://archive.ics.uci.edu/dataset/321/electricityloaddiagrams20112014',zh:'高維 multivariate forecasting 常用；可測 probabilistic forecast、trajectory generation 與 uncertainty。',en:'A common multivariate electricity benchmark for probabilistic forecasting and trajectory generation.'},
  {name:'MIMIC-IV-ECG',cat:'medical',tasks:['ECG generation','biosignal representation','diagnosis support research'],scale:'~800k 10-s 12-lead ECGs · ~160k patients · 500 Hz',access:'restricted',url:'https://physionet.org/content/mimic-iv-ecg/',zh:'大規模真實醫療 biosignal；適合 ECG generative model，但需 PhysioNet credentialing、DUA / training，不能當一般 open data。',en:'Large real clinical ECG data for generative biosignal research; PhysioNet credentialing and data-use requirements apply.'},
  {name:'Lorenz / FitzHugh–Nagumo synthetic trajectories',cat:'timeseries',tasks:['dynamical-system generation','conditional forecasting','probability-path research'],scale:'Simulation-generated; scale controlled by researcher',access:'synthetic',url:'https://proceedings.mlr.press/v267/huang25ag.html',zh:'Flow Divergence Matching 與 RMFlow 相關 time-series 實驗使用的動力系統 family。優點是可以無限採樣、知道真 dynamics，適合檢驗 distribution path。',en:'Synthetic dynamical systems used in Flow Divergence / RMFlow-style experiments; useful because ground-truth dynamics are known and data are unlimited.'},
  {name:'ShapeNetCore',cat:'3d',tasks:['3D shape generation','point-cloud / mesh modeling','category-conditioned 3D'],scale:'~51.3k 3D models · 55 categories',access:'registration',url:'https://shapenet.org/',zh:'3D generative modeling 的經典 object corpus；需註冊並遵守研究使用條款。',en:'A classic category-structured 3D object corpus; registration and research-use terms apply.'},
  {name:'Objaverse 1.0',cat:'3d',tasks:['3D foundation model','text-to-3D','asset generation'],scale:'800k+ 3D objects (Objaverse-XL extends to 10M+)',access:'terms',url:'https://objaverse.allenai.org/',zh:'比 ShapeNet 更大、更 in-the-wild；適合 3D foundation / text-to-3D，但個別 asset 的授權與品質差異要檢查。',en:'A much larger in-the-wild 3D asset corpus; per-asset licenses and quality vary.'},
  {name:'CO3D',cat:'3d',tasks:['novel-view synthesis','3D reconstruction','category-level 3D'],scale:'18,619 videos · 50 categories · ~1.5M frames',access:'terms',url:'https://ai.meta.com/datasets/co3d-downloads/',zh:'同一物體多視角影片 + camera annotation，適合 NeRF / 3D reconstruction / view-conditioned generation。',en:'Multi-view object videos with camera annotations for reconstruction, NeRF, and view-conditioned generation.'},
  {name:'ScanNet',cat:'3d',tasks:['indoor 3D reconstruction','semantic segmentation','RGB-D generation'],scale:'>1,500 scans · ~2.5M RGB-D views',access:'registration',url:'https://www.scan-net.org/',zh:'室內 RGB-D / 3D scene benchmark，有 pose、mesh、semantic labels；適合 scene generation / embodied perception。',en:'An indoor RGB-D/3D scene benchmark with poses, meshes, and semantic labels.'},
  {name:'AMASS',cat:'3d',tasks:['human motion generation','motion prediction','body-model learning'],scale:'>40 h · 300+ subjects · 11k+ motions',access:'registration',url:'https://amass.is.tue.mpg.de/',zh:'把多個 mocap dataset 統一到 SMPL body model，適合 human-motion diffusion / flow。',en:'Unifies many mocap sources into the SMPL body representation for motion generation and prediction.'},
  {name:'HumanML3D',cat:'3d',tasks:['text-to-motion','motion generation','language-motion alignment'],scale:'14,616 motions · 44,970 text descriptions · ~28.6 h',access:'open',url:'https://github.com/EricGuo5513/HumanML3D',zh:'text-to-motion 的代表 benchmark；若未來研究 action / trajectory generation，可借鏡其語言條件與 motion metrics。',en:'A representative text-to-motion benchmark with paired natural-language descriptions.'},
  {name:'MIMIC-CXR',cat:'medical',tasks:['chest X-ray generation','radiology report generation','vision-language medical'],scale:'377,110 images · 227,835 studies · 64,588 patients',access:'restricted',url:'https://physionet.org/content/mimic-cxr/',zh:'X-ray + report 大型配對醫療資料；非常適合 medical multimodal / generation，但有 credentialing 與 DUA。',en:'Large paired chest X-ray/report data for medical multimodal modeling; credentialing and DUA are required.'},
  {name:'CheXpert',cat:'medical',tasks:['chest X-ray classification','uncertainty modeling','medical generation evaluation'],scale:'224,316 radiographs · 65,240 patients · 14 observations',access:'terms',url:'https://stanfordmlgroup.github.io/competitions/chexpert/',zh:'有 uncertainty labels 的胸腔 X-ray benchmark；適合 conditional generation / medical representation 的評估。',en:'A chest X-ray benchmark with uncertainty labels useful for medical representation and conditional-generation evaluation.'},
  {name:'ISIC Archive / Challenges',cat:'medical',tasks:['skin lesion classification','segmentation','medical image generation'],scale:'Multiple releases; image counts and licenses vary by challenge / asset',access:'terms',url:'https://www.isic-archive.com/',zh:'皮膚鏡影像的重要來源；每個 release / image 的授權可能不同，使用前要固定 challenge year 與 license。',en:'A major dermoscopy source; pin the challenge/release and verify per-dataset or per-image licensing.'},
  {name:'BraTS',cat:'medical',tasks:['brain tumor segmentation','MRI synthesis','multi-modal medical imaging'],scale:'Yearly challenge releases of multi-parametric brain MRI',access:'registration',url:'https://www.synapse.org/Synapse:syn51156910/wiki/',zh:'多 modality MRI 與腫瘤 segmentation benchmark；適合 conditional MRI synthesis，但需依當年度 challenge / Synapse 規則取得。',en:'A multi-parametric brain-MRI challenge family for tumor segmentation and conditional synthesis; access rules vary by release.'},
  {name:'MedMNIST v2',cat:'medical',tasks:['medical toy benchmark','classification','small generative prototype'],scale:'18 standardized 2D / 3D biomedical datasets',access:'open',url:'https://medmnist.com/',zh:'把多種 medical data 標準化成很小尺寸，適合先做 loss / architecture smoke test，不代表真實 clinical deployment 難度。',en:'A standardized small biomedical benchmark suite for smoke tests, not a proxy for clinical deployment complexity.'},
  {name:'DNA sequence generation benchmark (Dirichlet-FM setup)',cat:'sequence',tasks:['DNA sequence generation','discrete flow matching','guided sequence generation'],scale:'Task-specific discrete sequence benchmark; follow paper/code release',access:'open',url:'https://github.com/Utah-Math-Data-Science/Flow_Div_Matching',zh:'Flow Divergence Matching 用來測 discrete / simplex flow 的 DNA generation。若重現，應直接依該 repo 的 preprocessing 與 split，避免把不同 DNA corpus 混成同一 benchmark。',en:'Used by Flow Divergence Matching to test discrete/simplex flow on DNA generation; reproduce using the repository preprocessing and splits.'},
];
---

<div class="dataset-catalog" data-dataset-catalog>
  <div class="catalog-head">
    <div>
      <span>DATASET CATALOG</span>
      <strong>{isZh ? '依任務、存取條件與關鍵字搜尋訓練資料' : 'Search training data by task, access, and keyword'}</strong>
      <p>{isZh ? '這是可持續擴充的 practical catalog，不宣稱涵蓋世界上所有 dataset；規模與授權可能隨版本改變，實際使用前請回原始來源確認。' : 'This is an expandable practical catalog, not a claim of literal exhaustiveness. Scale and licenses can change; verify current source terms before use.'}</p>
    </div>
    <div class="count"><b data-count>{datasets.length}</b><small>{isZh ? '目前顯示' : 'shown'}</small></div>
  </div>

  <div class="toolbar">
    <label class="search"><span>{isZh ? '搜尋' : 'Search'}</span><input type="search" data-search placeholder={isZh ? '例如 ImageNet、robot、text-to-image、ECG…' : 'e.g. ImageNet, robot, text-to-image, ECG…'} /></label>
    <label><span>{isZh ? '任務族群' : 'Task family'}</span><select data-cat>{categories.map(([v,l]) => <option value={v}>{l}</option>)}</select></label>
    <label><span>{isZh ? '存取方式' : 'Access'}</span><select data-access><option value="all">{isZh ? '全部存取方式' : 'All access types'}</option>{Object.entries(accessLabels).map(([v,l]) => <option value={v}>{l}</option>)}</select></label>
    <button type="button" data-reset>{isZh ? '重設' : 'Reset'}</button>
  </div>

  <div class="task-strip">
    {categories.slice(1).map(([v,l]) => <button type="button" data-chip={v}>{l}</button>)}
  </div>

  <div class="dataset-grid">
    {datasets.map((d) => (
      <article class="dataset-card" data-card data-cat={d.cat} data-access={d.access} data-search={`${d.name} ${d.cat} ${d.tasks.join(' ')} ${d.scale} ${d.zh} ${d.en}`.toLowerCase()}>
        <div class="card-top"><span class={`access access-${d.access}`}>{accessLabels[d.access]}</span><span class="category">{categories.find(([v])=>v===d.cat)?.[1]}</span></div>
        <h3>{d.name}</h3>
        <p>{isZh ? d.zh : d.en}</p>
        <dl><div><dt>{isZh ? '規模 / 資料型態' : 'Scale / format'}</dt><dd>{d.scale}</dd></div><div><dt>{isZh ? '常見任務' : 'Typical tasks'}</dt><dd class="tags">{d.tasks.map(t => <span>{t}</span>)}</dd></div></dl>
        <a class="source" href={d.url} target="_blank" rel="noreferrer">{isZh ? '官方 / 主要來源 ↗' : 'Official / primary source ↗'}</a>
      </article>
    ))}
  </div>
  <div class="empty" data-empty hidden>{isZh ? '目前條件沒有結果；可清除關鍵字或改選其他任務。' : 'No dataset matches the current filters.'}</div>
</div>

<style>
.dataset-catalog{border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface);margin:1rem 0 1.5rem;overflow:hidden}.catalog-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center}.catalog-head>div:first-child>span{display:block;color:var(--rh-caramel);font-size:.68rem;letter-spacing:.12em;font-weight:800}.catalog-head strong{display:block;margin-top:.2rem}.catalog-head p{margin:.25rem 0 0!important;color:var(--rh-muted);line-height:1.55}.count{width:5.2rem;height:5.2rem;border:1px solid var(--rh-border);border-radius:50%;display:grid;place-content:center;text-align:center;background:var(--rh-surface-2)}.count b{font-size:1.25rem}.count small{font-size:.67rem;color:var(--rh-muted)}.toolbar{display:grid;grid-template-columns:minmax(14rem,1.4fr) minmax(10rem,.8fr) minmax(10rem,.8fr) 5rem;gap:.55rem;margin-top:1rem;align-items:end}.toolbar label{display:grid;gap:.3rem;margin:0!important}.toolbar label>span{font-size:.68rem;color:var(--rh-muted)}.toolbar input,.toolbar select,.toolbar button{box-sizing:border-box;width:100%;height:2.65rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);color:var(--rh-text);font:inherit;padding:0 .7rem;margin:0}.toolbar button{cursor:pointer;color:var(--rh-coffee);font-weight:650}.task-strip{display:flex;gap:.4rem;overflow-x:auto;padding:.75rem 0 .15rem}.task-strip button{flex:0 0 auto;height:2rem;padding:0 .55rem;border:1px solid var(--rh-border);border-radius:999px;background:var(--rh-surface-2);color:var(--rh-muted);font:inherit;font-size:.7rem;cursor:pointer;margin:0}.task-strip button.active{background:var(--rh-coffee);border-color:var(--rh-coffee);color:#fff}.dataset-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:.85rem;align-items:stretch}.dataset-card{box-sizing:border-box;min-width:0;height:100%;border:1px solid var(--rh-border);border-radius:.8rem;padding:.85rem;background:var(--rh-surface-2);display:flex;flex-direction:column}.card-top{display:flex;justify-content:space-between;gap:.5rem;align-items:flex-start}.access,.category{font-size:.64rem;line-height:1.2}.access{padding:.2rem .42rem;border-radius:999px;border:1px solid var(--rh-border);background:var(--rh-surface)}.access-restricted,.access-registration{border-color:var(--rh-caramel);color:var(--rh-coffee)}.access-volatile{border-style:dashed}.access-synthetic{color:#6d627a}.category{color:var(--rh-muted);text-align:right}.dataset-card h3{font-size:1rem;line-height:1.3;margin:.65rem 0 .35rem!important}.dataset-card p{margin:0!important;color:var(--rh-muted);font-size:.8rem;line-height:1.58}.dataset-card dl{display:grid;gap:.55rem;margin:.7rem 0!important}.dataset-card dl>div{display:grid;gap:.2rem}.dataset-card dt{font-size:.64rem;text-transform:uppercase;letter-spacing:.06em;color:var(--rh-caramel);font-weight:750}.dataset-card dd{margin:0!important;font-size:.76rem;line-height:1.45}.tags{display:flex;flex-wrap:wrap;gap:.28rem}.tags span{padding:.16rem .36rem;border:1px solid var(--rh-border);border-radius:.4rem;background:var(--rh-surface);font-size:.64rem}.source{margin-top:auto!important;padding-top:.45rem;color:var(--rh-coffee)!important;text-decoration:none!important;font-size:.74rem;font-weight:700}.source:hover{text-decoration:underline!important}.empty{margin-top:.8rem;border:1px dashed var(--rh-border);border-radius:.7rem;padding:1rem;text-align:center;color:var(--rh-muted)}
:global(.dataset-catalog .toolbar > *),:global(.dataset-catalog .task-strip > *),:global(.dataset-catalog .dataset-grid > *),:global(.dataset-catalog .dataset-card > * + *){margin-top:0}
@media(max-width:900px){.toolbar{grid-template-columns:1fr 1fr}.toolbar .search{grid-column:1/-1}.catalog-head{grid-template-columns:1fr}.count{display:none}}@media(max-width:700px){.dataset-grid{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr}.toolbar .search{grid-column:auto}}
</style>

<script>
for(const root of document.querySelectorAll('[data-dataset-catalog]')){if(root.dataset.ready)continue;root.dataset.ready='1';const q=root.querySelector('[data-search]'),cat=root.querySelector('[data-cat]'),access=root.querySelector('[data-access]'),reset=root.querySelector('[data-reset]'),count=root.querySelector('[data-count]'),empty=root.querySelector('[data-empty]'),cards=[...root.querySelectorAll('[data-card]')],chips=[...root.querySelectorAll('[data-chip]')];function apply(){const term=q.value.trim().toLowerCase(),c=cat.value,a=access.value;let n=0;cards.forEach(card=>{const show=(!term||card.dataset.search.includes(term))&&(c==='all'||card.dataset.cat===c)&&(a==='all'||card.dataset.access===a);card.hidden=!show;if(show)n++});count.textContent=String(n);empty.hidden=n!==0;chips.forEach(b=>b.classList.toggle('active',b.dataset.chip===c))}q.addEventListener('input',apply);cat.addEventListener('change',apply);access.addEventListener('change',apply);chips.forEach(b=>b.addEventListener('click',()=>{cat.value=cat.value===b.dataset.chip?'all':b.dataset.chip;apply()}));reset.addEventListener('click',()=>{q.value='';cat.value='all';access.value='all';apply()});apply()}
</script>
