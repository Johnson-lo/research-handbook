---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="dist-lab" data-dist-lab data-lang={isZh ? 'zh' : 'en'}>
  <div class="dist-head"><div><span class="kicker">DISTRIBUTION LAB</span><strong>{isZh ? '真的把 point cloud、probability path 與 velocity 畫出來' : 'Visualize point clouds, probability paths, and velocities directly'}</strong><p>{isZh ? '這是 deterministic toy distribution，不是生成模型輸出；用途是建立幾何直覺。' : 'This is a deterministic toy distribution, not model output; it is for geometric intuition.'}</p></div><div class="legend"><span><i class="data"></i>data</span><span><i class="prior"></i>prior</span><span><i class="current"></i>z_t</span><span><i class="instant"></i>v</span><span><i class="average"></i>u</span></div></div>
  <div class="mode-tabs" role="group"><button class="active" data-mode="path">{isZh ? 'Probability path' : 'Probability path'}</button><button data-mode="marginal">{isZh ? 'Conditional → Marginal' : 'Conditional → Marginal'}</button><button data-mode="average">{isZh ? 'Average velocity' : 'Average velocity'}</button></div>
  <div class="lab-grid">
    <div class="plot-wrap"><svg data-plot viewBox="0 0 820 420" role="img" aria-label="interactive distribution plot"></svg><div class="plot-caption" data-caption></div></div>
    <div class="controls-panel">
      <label class="control"><span>t</span><input data-t type="range" min="0" max="1" step="0.01" value="0.55"/><output data-tout>0.55</output></label>
      <label class="control conditional-control"><span>{isZh ? 'neighborhood' : 'neighborhood'}</span><input data-k type="range" min="4" max="20" step="1" value="10"/><output data-kout>10</output></label>
      <label class="control average-control" hidden><span>r</span><input data-r type="range" min="0" max="0.9" step="0.01" value="0.20"/><output data-rout>0.20</output></label>
      <div class="readout"><small>{isZh ? '目前顯示' : 'Current view'}</small><strong data-title></strong><p data-desc></p></div>
      <div class="formula-readout" data-formula></div>
    </div>
  </div>
</div>
<style>
.dist-lab{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface);margin:1rem 0 1.5rem;overflow:hidden}.dist-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end}.dist-head strong{display:block}.dist-head p{margin:.25rem 0 0;color:var(--rh-muted);line-height:1.5}.kicker{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.12em;margin-bottom:.2rem}.legend{display:flex;gap:.55rem;flex-wrap:wrap;font-size:.68rem;color:var(--rh-muted)}.legend span{display:flex;gap:.25rem;align-items:center}.legend i{width:.65rem;height:.65rem;border-radius:50%;display:inline-block}.legend .data{background:#638a69}.legend .prior{background:#6f85a8}.legend .current{background:#fffdf8;border:1px solid var(--rh-coffee)}.legend .instant{background:#c47a3d}.legend .average{background:#7d678f}.mode-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin:.85rem 0}.mode-tabs button{box-sizing:border-box;width:100%;height:2.55rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);color:var(--rh-text);font:inherit;cursor:pointer}.mode-tabs button.active{border-color:var(--rh-caramel);background:var(--rh-surface-3)}.lab-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(15rem,.7fr);gap:.8rem;align-items:start}.plot-wrap{min-width:0;border:1px solid var(--rh-border);border-radius:.75rem;background:#f8f3ec;overflow:hidden}.plot-wrap svg{display:block;width:100%;height:auto;min-height:20rem}.plot-caption{border-top:1px solid var(--rh-border);padding:.55rem .7rem;color:var(--rh-muted);font-size:.72rem;line-height:1.45;background:var(--rh-surface-2)}.controls-panel{display:grid;gap:.65rem}.control{box-sizing:border-box;display:grid;grid-template-columns:6.4rem minmax(0,1fr) 3.2rem;gap:.5rem;align-items:center;border:1px solid var(--rh-border);border-radius:.65rem;padding:.65rem;background:var(--rh-surface-2);min-width:0}.control input{width:100%;min-width:0}.control output{text-align:right;font-variant-numeric:tabular-nums}.readout,.formula-readout{border:1px solid var(--rh-border);border-radius:.65rem;padding:.7rem;background:var(--rh-surface-2)}.readout small{display:block;color:var(--rh-caramel);font-size:.68rem;text-transform:uppercase}.readout strong{display:block;margin:.25rem 0}.readout p{margin:0;color:var(--rh-muted);font-size:.78rem;line-height:1.55}.formula-readout{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.76rem;line-height:1.55;overflow-wrap:anywhere;color:var(--rh-coffee-deep)}
@media(max-width:820px){.dist-head{grid-template-columns:1fr}.lab-grid{grid-template-columns:1fr}.plot-wrap svg{min-height:16rem}}@media(max-width:560px){.mode-tabs{grid-template-columns:1fr}.control{grid-template-columns:5.8rem minmax(0,1fr) 2.8rem}}
</style>
<script>
for(const root of document.querySelectorAll('[data-dist-lab]')){if(root.dataset.ready)continue;root.dataset.ready='1';const zh=root.dataset.lang==='zh',svg=root.querySelector('[data-plot]'),tEl=root.querySelector('[data-t]'),tOut=root.querySelector('[data-tout]'),kEl=root.querySelector('[data-k]'),kOut=root.querySelector('[data-kout]'),rEl=root.querySelector('[data-r]'),rOut=root.querySelector('[data-rout]'),condControl=root.querySelector('.conditional-control'),avgControl=root.querySelector('.average-control'),title=root.querySelector('[data-title]'),desc=root.querySelector('[data-desc]'),formula=root.querySelector('[data-formula]'),caption=root.querySelector('[data-caption]'),tabs=[...root.querySelectorAll('[data-mode]')];let mode='path',anchor={x:0,y:0};let seed=123456789;const rand=()=>{seed=(1664525*seed+1013904223)>>>0;return seed/4294967296};const gauss=()=>{const u=Math.max(rand(),1e-9),v=rand();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)};const N=120,data=[],prior=[];for(let i=0;i<N;i++){const side=i%2===0?-1:1;data.push({x:side*1.35+0.55*gauss(),y:(side<0?.55:-.45)+0.5*gauss()+0.15*side*gauss()});prior.push({x:1.05*gauss(),y:1.05*gauss()})}const sx=x=>410+x*105,sy=y=>210-y*78,ux=x=>(x-410)/105,uy=y=>(210-y)/78;function el(name,attrs={}){const n=document.createElementNS('http://www.w3.org/2000/svg',name);for(const [k,v] of Object.entries(attrs))n.setAttribute(k,String(v));svg.appendChild(n);return n}function line(x1,y1,x2,y2,stroke,w=1,op=1,dash=''){const n=el('line',{x1:sx(x1),y1:sy(y1),x2:sx(x2),y2:sy(y2),stroke,'stroke-width':w,opacity:op});if(dash)n.setAttribute('stroke-dasharray',dash);return n}function circle(p,fill,r=3,op=1,stroke='none',sw=1){return el('circle',{cx:sx(p.x),cy:sy(p.y),r,fill,opacity:op,stroke,'stroke-width':sw})}function arrow(p,v,color,scale=0.22,w=2){const x2=p.x+v.x*scale,y2=p.y+v.y*scale;line(p.x,p.y,x2,y2,color,w,.95);const ang=Math.atan2(y2-p.y,x2-p.x),a=.09;line(x2,y2,x2-a*Math.cos(ang-.55),y2-a*Math.sin(ang-.55),color,w,.95);line(x2,y2,x2-a*Math.cos(ang+.55),y2-a*Math.sin(ang+.55),color,w,.95)}function clear(){svg.innerHTML='';el('rect',{x:0,y:0,width:820,height:420,fill:'#f8f3ec'});line(-3.4,0,3.4,0,'#d8c6b2',1,.55);line(0,-2.4,0,2.4,'#d8c6b2',1,.55)}function zAt(i,t){return{x:(1-t)*data[i].x+t*prior[i].x,y:(1-t)*data[i].y+t*prior[i].y}}function drawPath(t){clear();for(const p of data)circle(p,'#638a69',2.5,.28);for(const p of prior)circle(p,'#6f85a8',2.5,.28);for(let i=0;i<12;i++)line(data[i].x,data[i].y,prior[i].x,prior[i].y,'#c8b7a5',1,.35,'4 5');for(let i=0;i<N;i++)circle(zAt(i,t),'#fffdf8',3.1,.92,'#6b4f3a',1);title.textContent=zh?'Probability path：point cloud 隨 t 移動':'Probability path: point cloud moves with t';desc.textContent=zh?'t=0 是 data，t=1 是 prior。這裡畫的是 training geometry z_t=(1−t)x+tε，不是 inference rollout。':'t=0 is data and t=1 is prior. This visualizes the training geometry z_t=(1−t)x+tε, not an inference rollout.';formula.textContent=`z_t = (1−${t.toFixed(2)}) x + ${t.toFixed(2)} ε`;caption.textContent=zh?'綠：data samples；藍：prior samples；白：目前的 z_t。灰色虛線只顯示少量 paired interpolation。':'Green: data samples; blue: prior samples; white: current z_t. Dashed lines show a small subset of paired interpolations.'}function drawMarginal(t,k){clear();const zs=[];for(let i=0;i<N;i++){const z=zAt(i,t);zs.push({i,...z});circle(z,'#fffdf8',2.7,.5,'#6b4f3a',.7)}const near=zs.map(z=>({...z,d:(z.x-anchor.x)**2+(z.y-anchor.y)**2})).sort((a,b)=>a.d-b.d).slice(0,k);let av={x:0,y:0};for(const n of near){const v={x:prior[n.i].x-data[n.i].x,y:prior[n.i].y-data[n.i].y};av.x+=v.x;av.y+=v.y;circle(n,'#fffdf8',4,.95,'#c47a3d',1.2);arrow(anchor,v,'#c47a3d',.15,1.5)}av.x/=k;av.y/=k;circle(anchor,'#fffdf8',5,1,'#30251d',1.4);arrow(anchor,av,'#7d678f',.32,3);title.textContent=zh?'Conditional velocities → local marginal estimate':'Conditional velocities → local marginal estimate';desc.textContent=zh?'點圖上任意位置。系統取附近 k 個 sampled states，把各自的 e−x 當 conditional velocities，再畫出它們的 sample average。':'Click anywhere in the plot. The nearest k sampled states provide conditional velocities e−x; their sample average is drawn as a local marginal estimate.';formula.textContent=`v̂(z_t,t) ≈ (1/${k}) Σ_{nearest} (ε_i − x_i)`;caption.textContent=zh?'橘箭頭：附近 sampled pairs 的 conditional velocities；紫箭頭：它們的 sample-average approximation。這是有限樣本近似，不是精確 conditional expectation。':'Orange arrows: conditional velocities from nearby sampled pairs; purple arrow: their sample-average approximation. This is a finite-sample approximation, not an exact conditional expectation.'}function q(pair,s){const a=data[pair],b=prior[pair],dx=b.x-a.x,dy=b.y-a.y,n=Math.hypot(dx,dy)||1,px=-dy/n,py=dx/n,bend=.85*Math.sin(Math.PI*s);return{x:(1-s)*a.x+s*b.x+bend*px,y:(1-s)*a.y+s*b.y+bend*py}}function qPrime(pair,s){const a=data[pair],b=prior[pair],dx=b.x-a.x,dy=b.y-a.y,n=Math.hypot(dx,dy)||1,px=-dy/n,py=dx/n,c=.85*Math.PI*Math.cos(Math.PI*s);return{x:dx+c*px,y:dy+c*py}}function drawAverage(r,t){if(r>=t-.03){r=Math.max(0,t-.03);rEl.value=r.toFixed(2);rOut.textContent=r.toFixed(2)}clear();const pair=7,pts=[];for(let s=0;s<=1.0001;s+=.02)pts.push(q(pair,s));for(let i=1;i<pts.length;i++)line(pts[i-1].x,pts[i-1].y,pts[i].x,pts[i].y,'#9f8d7e',2,.55);const qr=q(pair,r),qt=q(pair,t),vm=qPrime(pair,t),u={x:(qt.x-qr.x)/(t-r),y:(qt.y-qr.y)/(t-r)};circle(qr,'#638a69',5,1,'#30251d',1);circle(qt,'#fffdf8',5,1,'#30251d',1);arrow(qt,vm,'#c47a3d',.18,2.5);arrow(qr,u,'#7d678f',.18,3);title.textContent=zh?'Toy curved trajectory：instantaneous v 與 interval-average u':'Toy curved trajectory: instantaneous v vs interval-average u';desc.textContent=zh?'這個 tab 故意使用 curved toy trajectory，讓 instantaneous velocity 會沿路改變；紫色 u 只負責總結 [r,t] 的 finite-time displacement。':'This tab intentionally uses a curved toy trajectory so instantaneous velocity changes along the path; purple u summarizes the finite-time displacement over [r,t].';formula.textContent=`u(r,t) = (q(t) − q(r)) / (t − r),   r=${r.toFixed(2)}, t=${t.toFixed(2)}`;caption.textContent=zh?'橘：t 處的 instantaneous tangent v；紫：從 r 到 t 的 average velocity u。這是幾何 toy example，不是 MeanFlow network prediction。':'Orange: instantaneous tangent v at t; purple: average velocity u over r→t. This is a geometric toy example, not a MeanFlow network prediction.'}function render(){const t=Number(tEl.value),k=Number(kEl.value),r=Number(rEl.value);tOut.textContent=t.toFixed(2);kOut.textContent=String(k);rOut.textContent=r.toFixed(2);condControl.hidden=mode!=='marginal';avgControl.hidden=mode!=='average';if(mode==='path')drawPath(t);else if(mode==='marginal')drawMarginal(t,k);else drawAverage(r,t)}tabs.forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;tabs.forEach(x=>x.classList.toggle('active',x===b));render()}));tEl.addEventListener('input',render);kEl.addEventListener('input',render);rEl.addEventListener('input',render);svg.addEventListener('click',e=>{if(mode!=='marginal')return;const box=svg.getBoundingClientRect(),x=(e.clientX-box.left)/box.width*820,y=(e.clientY-box.top)/box.height*420;anchor={x:ux(x),y:uy(y)};render()});render()}
</script>
