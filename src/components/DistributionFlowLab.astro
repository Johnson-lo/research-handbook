---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="dist" data-dist data-lang={isZh?'zh':'en'}>
  <div class="dist-head"><div><span>DISTRIBUTION LAB</span><strong>{isZh?'用 2D point cloud 直接看 distribution、conditional velocity 與 average velocity':'Use 2D point clouds to see distributions, conditional velocity, and average velocity'}</strong><p>{isZh?'先選一個模式；每個模式都只回答一個問題。資料是 deterministic toy distribution。':'Choose one mode first; each mode answers one question. The data are deterministic toy distributions.'}</p></div><div class="legend"><span><i class="d"></i>data</span><span><i class="p"></i>prior</span><span><i class="z"></i>z_t</span><span><i class="v"></i>v</span><span><i class="u"></i>u</span></div></div>
  <div class="tabs" role="tablist"><button class="active" data-mode="path"><b>1</b><span>Probability path</span><small>{isZh?'整群點怎麼移動':'how the cloud moves'}</small></button><button data-mode="marginal"><b>2</b><span>Conditional → Marginal</span><small>{isZh?'很多方向怎麼平均':'how directions average'}</small></button><button data-mode="average"><b>3</b><span>Average velocity</span><small>{isZh?'local v vs interval u':'local v vs interval u'}</small></button></div>
  <div class="howto"><b data-how-title>{isZh?'操作：拖動 t':'Action: drag t'}</b><span data-how>{isZh?'觀察白色 z_t point cloud 如何在綠色 data 與藍色 prior 之間移動。':'Watch the white z_t point cloud move between green data and blue prior.'}</span><button type="button" data-demo>{isZh?'示範':'Demo'}</button></div>
  <div class="layout"><div class="plot"><svg data-svg viewBox="0 0 820 430"></svg><div class="caption" data-caption></div></div><aside>
    <div class="control-card" data-tcard><div class="control-title"><b data-tlabel>t</b><output data-to>0.55</output></div><input data-t type="range" min="0" max="1" step="0.01" value="0.55"><div class="range-ends"><span data-left>{isZh?'data · t=0':'data · t=0'}</span><span data-right>{isZh?'prior · t=1':'prior · t=1'}</span></div></div>
    <div class="control-card" data-krow><div class="control-title"><b>{isZh?'附近 samples':'Nearby samples'}</b><output data-ko>9</output></div><input data-k type="range" min="4" max="18" step="1" value="9"><small>{isZh?'再點圖上的任意位置，查看附近 conditional directions。':'Then click anywhere in the plot to inspect nearby conditional directions.'}</small></div>
    <div class="control-card" data-rrow hidden><div class="control-title"><b>r</b><output data-ro>0.20</output></div><input data-r type="range" min="0" max="0.9" step="0.01" value="0.20"><small>{isZh?'r 是 interval 左端；必須保持 r < t。':'r is the left endpoint; keep r < t.'}</small></div>
    <div class="mode-info"><small>{isZh?'你現在應該看什麼':'What to look at'}</small><strong data-title></strong><p data-desc></p></div><div class="formula" data-formula></div>
  </aside></div>
</div>
<style>
.dist{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface);margin:1rem 0 1.5rem;overflow:hidden}.dist-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center}.dist-head>div>span{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.12em}.dist-head strong{display:block;margin-top:.2rem}.dist-head p{margin:.25rem 0 0;color:var(--rh-muted)}.legend{display:flex;gap:.55rem;flex-wrap:wrap;font-size:.68rem;color:var(--rh-muted)}.legend span{display:flex;align-items:center;gap:.25rem}.legend i{width:.65rem;height:.65rem;border-radius:50%;display:inline-block}.legend .d{background:#638a69}.legend .p{background:#6f85a8}.legend .z{background:#fffdf8;border:1px solid #6b4f3a}.legend .v{background:#c47a3d}.legend .u{background:#7d678f}.tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin:.85rem 0;align-items:stretch}.tabs button{box-sizing:border-box;height:4rem;margin:0;border:1px solid var(--rh-border);border-radius:.6rem;background:var(--rh-surface-2);color:var(--rh-text);font:inherit;cursor:pointer;padding:.45rem .6rem;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:.45rem;align-items:center;text-align:left}.tabs button b{grid-row:1/3;display:grid;place-items:center;width:1.55rem;height:1.55rem;border-radius:50%;background:var(--rh-surface);color:var(--rh-coffee);font-size:.72rem}.tabs button span{font-size:.82rem;font-weight:650;line-height:1.15}.tabs button small{font-size:.68rem;color:var(--rh-muted);line-height:1.15}.tabs button.active{border-color:var(--rh-caramel);background:var(--rh-surface-3)}.howto{display:grid;grid-template-columns:auto minmax(0,1fr) 5rem;gap:.65rem;align-items:center;border:1px solid var(--rh-border);border-radius:.65rem;background:color-mix(in srgb,var(--rh-caramel) 5%,var(--rh-surface-2));padding:.6rem .7rem;margin-bottom:.75rem}.howto b{font-size:.78rem}.howto span{color:var(--rh-muted);font-size:.76rem;line-height:1.4}.howto button{height:2.3rem;border:1px solid var(--rh-caramel);border-radius:.5rem;background:var(--rh-surface);color:var(--rh-coffee);font:inherit;cursor:pointer}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(16rem,.7fr);gap:.8rem;align-items:stretch}.plot{min-width:0;height:100%;border:1px solid var(--rh-border);border-radius:.75rem;background:#f8f3ec;overflow:hidden;display:grid;grid-template-rows:minmax(0,1fr) auto}.plot svg{display:block;width:100%;height:100%;min-height:25rem}.caption{border-top:1px solid var(--rh-border);padding:.55rem .7rem;background:var(--rh-surface-2);color:var(--rh-muted);font-size:.72rem;line-height:1.5}.layout aside{display:grid;grid-auto-rows:max-content;gap:.6rem;align-content:start}.control-card,.mode-info,.formula{box-sizing:border-box;border:1px solid var(--rh-border);border-radius:.65rem;padding:.7rem;background:var(--rh-surface-2);min-height:5.4rem}.control-title{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.4rem}.control-title b{font-size:.78rem}.control-title output{font-variant-numeric:tabular-nums;color:var(--rh-coffee);font-weight:700}.control-card input{width:100%;min-width:0}.control-card small{display:block;color:var(--rh-muted);font-size:.7rem;line-height:1.4;margin-top:.35rem}.range-ends{display:flex;justify-content:space-between;gap:.5rem;color:var(--rh-muted);font-size:.65rem;margin-top:.2rem}.mode-info small{display:block;color:var(--rh-caramel);font-size:.68rem;text-transform:uppercase}.mode-info strong{display:block;margin:.25rem 0;line-height:1.35}.mode-info p{margin:0;color:var(--rh-muted);font-size:.78rem;line-height:1.55}.formula{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.76rem;line-height:1.55;overflow-wrap:anywhere;min-height:4.5rem}
@media(max-width:840px){.dist-head{grid-template-columns:1fr}.layout{grid-template-columns:1fr}.plot svg{min-height:22rem}.howto{grid-template-columns:1fr auto}.howto span{grid-column:1/-1;grid-row:2}}@media(max-width:560px){.tabs{grid-template-columns:1fr}.tabs button{height:3.7rem}.howto{grid-template-columns:1fr}.howto button{width:100%}}
</style>
<script>
for(const root of document.querySelectorAll('[data-dist]')){if(root.dataset.ready)continue;root.dataset.ready='1';const zh=root.dataset.lang==='zh',svg=root.querySelector('[data-svg]'),tabs=[...root.querySelectorAll('[data-mode]')],tEl=root.querySelector('[data-t]'),kEl=root.querySelector('[data-k]'),rEl=root.querySelector('[data-r]'),to=root.querySelector('[data-to]'),ko=root.querySelector('[data-ko]'),ro=root.querySelector('[data-ro]'),krow=root.querySelector('[data-krow]'),rrow=root.querySelector('[data-rrow]'),title=root.querySelector('[data-title]'),desc=root.querySelector('[data-desc]'),formula=root.querySelector('[data-formula]'),caption=root.querySelector('[data-caption]'),howTitle=root.querySelector('[data-how-title]'),how=root.querySelector('[data-how]'),demo=root.querySelector('[data-demo]');let mode='path',anchor={x:0,y:0},seed=77123,demoTimer=null;const R=()=>{seed=(1664525*seed+1013904223)>>>0;return seed/4294967296},G=()=>{const u=Math.max(R(),1e-9),v=R();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)};const data=[],prior=[],N=140;for(let i=0;i<N;i++){const side=i%2?-1:1;data.push({x:side*1.45+.42*G(),y:.58*Math.sin(side*1.2)+.48*G()});prior.push({x:1.05*G(),y:1.05*G()})}const sx=x=>410+x*105,sy=y=>215-y*78;function E(name,a={}){const n=document.createElementNS('http://www.w3.org/2000/svg',name);for(const[k,v]of Object.entries(a))n.setAttribute(k,String(v));svg.appendChild(n);return n}function L(a,b,c,d,col,w=1,op=1,dash=''){const n=E('line',{x1:sx(a),y1:sy(b),x2:sx(c),y2:sy(d),stroke:col,'stroke-width':w,opacity:op});if(dash)n.setAttribute('stroke-dasharray',dash);return n}function C(p,fill,r=3,op=1,stroke='none',sw=1){return E('circle',{cx:sx(p.x),cy:sy(p.y),r,fill,opacity:op,stroke,'stroke-width':sw})}function A(p,v,col,scale=.2,w=2){const q={x:p.x+v.x*scale,y:p.y+v.y*scale};L(p.x,p.y,q.x,q.y,col,w,.95);const ang=Math.atan2(q.y-p.y,q.x-p.x),a=.1;L(q.x,q.y,q.x-a*Math.cos(ang-.55),q.y-a*Math.sin(ang-.55),col,w,.95);L(q.x,q.y,q.x-a*Math.cos(ang+.55),q.y-a*Math.sin(ang+.55),col,w,.95)}function clear(){svg.innerHTML='';E('rect',{x:0,y:0,width:820,height:430,fill:'#f8f3ec'});L(-3.5,0,3.5,0,'#d8c6b2',1,.55);L(0,-2.5,0,2.5,'#d8c6b2',1,.55)}function z(i,t){return{x:(1-t)*data[i].x+t*prior[i].x,y:(1-t)*data[i].y+t*prior[i].y}}function path(t){clear();data.forEach(p=>C(p,'#638a69',2.4,.25));prior.forEach(p=>C(p,'#6f85a8',2.4,.25));for(let i=0;i<14;i++)L(data[i].x,data[i].y,prior[i].x,prior[i].y,'#c8b7a5',1,.28,'4 5');for(let i=0;i<N;i++)C(z(i,t),'#fffdf8',3,.92,'#6b4f3a',.9);title.textContent=zh?'整個 distribution 在移動':'The whole distribution moves';desc.textContent=zh?'白色 z_t 是目前 t 的 point cloud。拖 t 看它如何在 data 與 prior 之間連續變形。':'The white z_t cloud is the current distribution. Drag t to see it continuously deform between data and prior.';formula.textContent=`z_t = (1−${t.toFixed(2)})x + ${t.toFixed(2)}ε`;caption.textContent=zh?'綠=data，藍=prior，白=z_t；灰線只顯示少量 paired interpolation。':'Green=data, blue=prior, white=z_t; gray lines show only a few paired interpolations.'}function marginal(t,k){clear();const zs=[];for(let i=0;i<N;i++){const p=z(i,t);zs.push({i,...p});C(p,'#fffdf8',2.6,.5,'#6b4f3a',.7)}const near=zs.map(p=>({...p,d:(p.x-anchor.x)**2+(p.y-anchor.y)**2})).sort((a,b)=>a.d-b.d).slice(0,k);let av={x:0,y:0};for(const n of near){const vv={x:prior[n.i].x-data[n.i].x,y:prior[n.i].y-data[n.i].y};av.x+=vv.x;av.y+=vv.y;C(n,'#fffdf8',4,.95,'#c47a3d',1.2);A(anchor,vv,'#c47a3d',.13,1.4)}av.x/=k;av.y/=k;C(anchor,'#fffdf8',5,1,'#30251d',1.5);A(anchor,av,'#7d678f',.34,3);title.textContent=zh?'很多 conditional directions → 一個 marginal-like direction':'Many conditional directions → one marginal-like direction';desc.textContent=zh?'先點圖上一個位置：橘色是附近 sampled pairs 的 e−x；紫色是這些方向的有限樣本平均。':'Click a location first: orange shows nearby sampled-pair e−x directions; purple is their finite-sample average.';formula.textContent=`v̂(z_t,t) ≈ (1/${k}) Σ_near (ε_i − x_i)`;caption.textContent=zh?'同一附近 state 可能對應很多 conditional directions；紫色不是另一個 pair，而是局部平均。':'A nearby state can correspond to many conditional directions; purple is a local average, not another sampled pair.'}function q(s){const a={x:-2.2,y:-1},b={x:2.1,y:.9},dx=b.x-a.x,dy=b.y-a.y,n=Math.hypot(dx,dy),px=-dy/n,py=dx/n,bend=1.15*Math.sin(Math.PI*s);return{x:(1-s)*a.x+s*b.x+bend*px,y:(1-s)*a.y+s*b.y+bend*py}}function qp(s){const dx=4.3,dy=1.9,n=Math.hypot(dx,dy),px=-dy/n,py=dx/n,c=1.15*Math.PI*Math.cos(Math.PI*s);return{x:dx+c*px,y:dy+c*py}}function average(r,t){if(r>=t-.03){r=Math.max(0,t-.03);rEl.value=r.toFixed(2);ro.textContent=r.toFixed(2)}clear();let last=q(0);for(let s=.02;s<=1.001;s+=.02){const cur=q(s);L(last.x,last.y,cur.x,cur.y,'#9f8d7e',2,.6);last=cur}const qr=q(r),qt=q(t),vv=qp(t),u={x:(qt.x-qr.x)/(t-r),y:(qt.y-qr.y)/(t-r)};C(qr,'#638a69',5,1,'#30251d',1);C(qt,'#fffdf8',5,1,'#30251d',1);A(qt,vv,'#c47a3d',.16,2.7);A(qr,u,'#7d678f',.18,3.2);title.textContent=zh?'橘色 local v 與紫色 interval-average u':'Orange local v vs purple interval-average u';desc.textContent=zh?'拖 r、t 改變 interval。路徑彎曲時，t 點的 local tangent 與整段 displacement summary 可以明顯不同。':'Drag r and t to change the interval. On a curved path, the local tangent at t can differ strongly from the interval displacement summary.';formula.textContent=`u(r,t) = (q(t) − q(r)) / (t − r),  Δt=${(t-r).toFixed(2)}`;caption.textContent=zh?'橘=v(t)，紫=u(r,t)。這是幾何 toy path，不是 trained MeanFlow output。':'Orange=v(t), purple=u(r,t). This is a geometric toy path, not trained MeanFlow output.'}function updateHow(){if(mode==='path'){howTitle.textContent=zh?'操作：拖動 t':'Action: drag t';how.textContent=zh?'觀察白色 z_t point cloud 如何在綠色 data 與藍色 prior 之間移動。':'Watch the white z_t cloud move between green data and blue prior.'}else if(mode==='marginal'){howTitle.textContent=zh?'操作：先點圖，再調 neighbors':'Action: click plot, then adjust neighbors';how.textContent=zh?'黑框白點是你選的位置；橘箭頭是 conditional directions，紫箭頭是局部平均。':'The outlined white point is your selected location; orange arrows are conditional directions and purple is their local average.'}else{howTitle.textContent=zh?'操作：拖 r 與 t':'Action: drag r and t';how.textContent=zh?'比較橘色 instantaneous tangent 與紫色 interval-average direction。':'Compare the orange instantaneous tangent with the purple interval-average direction.'}}function render(){const t=+tEl.value,k=+kEl.value,r=+rEl.value;to.textContent=t.toFixed(2);ko.textContent=String(k);ro.textContent=r.toFixed(2);krow.hidden=mode!=='marginal';rrow.hidden=mode!=='average';updateHow();if(mode==='path')path(t);else if(mode==='marginal')marginal(t,k);else average(r,t)}function stopDemo(){if(demoTimer){clearInterval(demoTimer);demoTimer=null}demo.textContent=zh?'示範':'Demo'}tabs.forEach(b=>b.addEventListener('click',()=>{stopDemo();mode=b.dataset.mode;tabs.forEach(x=>x.classList.toggle('active',x===b));render()}));[tEl,kEl,rEl].forEach(x=>x.addEventListener('input',()=>{stopDemo();render()}));svg.addEventListener('click',e=>{if(mode!=='marginal')return;const box=svg.getBoundingClientRect(),x=(e.clientX-box.left)/box.width*820,y=(e.clientY-box.top)/box.height*430;anchor={x:(x-410)/105,y:(215-y)/78};render()});demo.addEventListener('click',()=>{if(demoTimer){stopDemo();return}demo.textContent=zh?'停止':'Stop';if(mode==='path'){tEl.value='0';demoTimer=setInterval(()=>{let v=+tEl.value+.02;if(v>1){stopDemo();return}tEl.value=v.toFixed(2);render()},70)}else if(mode==='marginal'){anchor={x:-1.2,y:.4};kEl.value='6';render();setTimeout(()=>{kEl.value='14';render();stopDemo()},1000)}else{rEl.value='.1';tEl.value='.35';render();let x=.35;demoTimer=setInterval(()=>{x+=.02;if(x>.9){stopDemo();return}tEl.value=x.toFixed(2);render()},90)}});render()}
</script>
