---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="dist" data-dist data-lang={isZh?'zh':'en'}>
  <div class="dist-head"><div><span>DISTRIBUTION LAB</span><strong>{isZh?'用真正的 2D point cloud 看 distribution、conditional velocity 與 average velocity':'Use 2D point clouds to see distributions, conditional velocity, and average velocity'}</strong><p>{isZh?'資料是 deterministic toy distribution；不是生成模型輸出。':'The data are deterministic toy distributions, not outputs from a trained model.'}</p></div><div class="legend"><span><i class="d"></i>data</span><span><i class="p"></i>prior</span><span><i class="z"></i>z_t</span><span><i class="v"></i>v</span><span><i class="u"></i>u</span></div></div>
  <div class="tabs"><button class="active" data-mode="path">Probability path</button><button data-mode="marginal">Conditional → Marginal</button><button data-mode="average">Average velocity</button></div>
  <div class="layout"><div class="plot"><svg data-svg viewBox="0 0 820 430"></svg><div class="caption" data-caption></div></div><aside>
    <label><span>t</span><input data-t type="range" min="0" max="1" step="0.01" value="0.55"><output data-to>0.55</output></label>
    <label data-krow><span>neighbors</span><input data-k type="range" min="4" max="18" step="1" value="9"><output data-ko>9</output></label>
    <label data-rrow hidden><span>r</span><input data-r type="range" min="0" max="0.9" step="0.01" value="0.20"><output data-ro>0.20</output></label>
    <div class="mode-info"><small>{isZh?'目前模式':'Current mode'}</small><strong data-title></strong><p data-desc></p></div><div class="formula" data-formula></div>
  </aside></div>
</div>
<style>
.dist{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface);margin:1rem 0 1.5rem;overflow:hidden}.dist-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end}.dist-head>div>span{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.12em}.dist-head strong{display:block;margin-top:.2rem}.dist-head p{margin:.25rem 0 0;color:var(--rh-muted)}.legend{display:flex;gap:.55rem;flex-wrap:wrap;font-size:.68rem;color:var(--rh-muted)}.legend span{display:flex;align-items:center;gap:.25rem}.legend i{width:.65rem;height:.65rem;border-radius:50%;display:inline-block}.legend .d{background:#638a69}.legend .p{background:#6f85a8}.legend .z{background:#fffdf8;border:1px solid #6b4f3a}.legend .v{background:#c47a3d}.legend .u{background:#7d678f}.tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin:.85rem 0}.tabs button{height:2.5rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);color:var(--rh-text);font:inherit;cursor:pointer}.tabs button.active{border-color:var(--rh-caramel);background:var(--rh-surface-3)}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(16rem,.7fr);gap:.8rem;align-items:start}.plot{min-width:0;border:1px solid var(--rh-border);border-radius:.75rem;background:#f8f3ec;overflow:hidden}.plot svg{display:block;width:100%;height:auto;min-height:20rem}.caption{border-top:1px solid var(--rh-border);padding:.55rem .7rem;background:var(--rh-surface-2);color:var(--rh-muted);font-size:.72rem;line-height:1.5}.layout aside{display:grid;gap:.6rem}.layout aside label{display:grid;grid-template-columns:6.2rem minmax(0,1fr) 3.2rem;gap:.5rem;align-items:center;border:1px solid var(--rh-border);border-radius:.65rem;padding:.6rem;background:var(--rh-surface-2)}.layout input{width:100%;min-width:0}.layout output{text-align:right;font-variant-numeric:tabular-nums}.mode-info,.formula{border:1px solid var(--rh-border);border-radius:.65rem;padding:.7rem;background:var(--rh-surface-2)}.mode-info small{display:block;color:var(--rh-caramel);font-size:.68rem;text-transform:uppercase}.mode-info strong{display:block;margin:.25rem 0}.mode-info p{margin:0;color:var(--rh-muted);font-size:.78rem;line-height:1.55}.formula{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.76rem;line-height:1.55;overflow-wrap:anywhere}
@media(max-width:840px){.dist-head{grid-template-columns:1fr}.layout{grid-template-columns:1fr}.plot svg{min-height:16rem}}@media(max-width:560px){.tabs{grid-template-columns:1fr}.layout aside label{grid-template-columns:5.6rem minmax(0,1fr) 3rem}}
</style>
<script>
for(const root of document.querySelectorAll('[data-dist]')){if(root.dataset.ready)continue;root.dataset.ready='1';const zh=root.dataset.lang==='zh',svg=root.querySelector('[data-svg]'),tabs=[...root.querySelectorAll('[data-mode]')],tEl=root.querySelector('[data-t]'),kEl=root.querySelector('[data-k]'),rEl=root.querySelector('[data-r]'),to=root.querySelector('[data-to]'),ko=root.querySelector('[data-ko]'),ro=root.querySelector('[data-ro]'),krow=root.querySelector('[data-krow]'),rrow=root.querySelector('[data-rrow]'),title=root.querySelector('[data-title]'),desc=root.querySelector('[data-desc]'),formula=root.querySelector('[data-formula]'),caption=root.querySelector('[data-caption]');let mode='path',anchor={x:0,y:0},seed=77123;const R=()=>{seed=(1664525*seed+1013904223)>>>0;return seed/4294967296},G=()=>{const u=Math.max(R(),1e-9),v=R();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)};const data=[],prior=[],N=140;for(let i=0;i<N;i++){const side=i%2?-1:1;data.push({x:side*1.45+.42*G(),y:.58*Math.sin(side*1.2)+.48*G()});prior.push({x:1.05*G(),y:1.05*G()})}const sx=x=>410+x*105,sy=y=>215-y*78;function E(name,a={}){const n=document.createElementNS('http://www.w3.org/2000/svg',name);for(const[k,v]of Object.entries(a))n.setAttribute(k,String(v));svg.appendChild(n);return n}function L(a,b,c,d,col,w=1,op=1,dash=''){const n=E('line',{x1:sx(a),y1:sy(b),x2:sx(c),y2:sy(d),stroke:col,'stroke-width':w,opacity:op});if(dash)n.setAttribute('stroke-dasharray',dash);return n}function C(p,fill,r=3,op=1,stroke='none',sw=1){return E('circle',{cx:sx(p.x),cy:sy(p.y),r,fill,opacity:op,stroke,'stroke-width':sw})}function A(p,v,col,scale=.2,w=2){const q={x:p.x+v.x*scale,y:p.y+v.y*scale};L(p.x,p.y,q.x,q.y,col,w,.95);const ang=Math.atan2(q.y-p.y,q.x-p.x),a=.1;L(q.x,q.y,q.x-a*Math.cos(ang-.55),q.y-a*Math.sin(ang-.55),col,w,.95);L(q.x,q.y,q.x-a*Math.cos(ang+.55),q.y-a*Math.sin(ang+.55),col,w,.95)}function clear(){svg.innerHTML='';E('rect',{x:0,y:0,width:820,height:430,fill:'#f8f3ec'});L(-3.5,0,3.5,0,'#d8c6b2',1,.55);L(0,-2.5,0,2.5,'#d8c6b2',1,.55)}function z(i,t){return{x:(1-t)*data[i].x+t*prior[i].x,y:(1-t)*data[i].y+t*prior[i].y}}function path(t){clear();data.forEach(p=>C(p,'#638a69',2.4,.25));prior.forEach(p=>C(p,'#6f85a8',2.4,.25));for(let i=0;i<14;i++)L(data[i].x,data[i].y,prior[i].x,prior[i].y,'#c8b7a5',1,.28,'4 5');for(let i=0;i<N;i++)C(z(i,t),'#fffdf8',3,.92,'#6b4f3a',.9);title.textContent=zh?'Probability path：整個分布一起移動':'Probability path: the whole distribution moves';desc.textContent=zh?'t=0 是 data，t=1 是 Gaussian prior。這裡顯示 training path 的幾何；inference 會沿同一時間軸反向從 prior 往 data 走。':'t=0 is data and t=1 is the Gaussian prior. This is training-path geometry; inference traverses the time axis in reverse from prior toward data.';formula.textContent=`z_t = (1−${t.toFixed(2)})x + ${t.toFixed(2)}ε`;caption.textContent=zh?'綠=data，藍=prior，白=z_t。這讓 distribution 不再只是抽象機率符號，而是一整群 samples 的形狀。':'Green=data, blue=prior, white=z_t. A distribution is the geometry formed by many samples, not a single point.'}function marginal(t,k){clear();const zs=[];for(let i=0;i<N;i++){const p=z(i,t);zs.push({i,...p});C(p,'#fffdf8',2.6,.5,'#6b4f3a',.7)}const near=zs.map(p=>({...p,d:(p.x-anchor.x)**2+(p.y-anchor.y)**2})).sort((a,b)=>a.d-b.d).slice(0,k);let av={x:0,y:0};for(const n of near){const vv={x:prior[n.i].x-data[n.i].x,y:prior[n.i].y-data[n.i].y};av.x+=vv.x;av.y+=vv.y;C(n,'#fffdf8',4,.95,'#c47a3d',1.2);A(anchor,vv,'#c47a3d',.13,1.4)}av.x/=k;av.y/=k;C(anchor,'#fffdf8',5,1,'#30251d',1.5);A(anchor,av,'#7d678f',.34,3);title.textContent=zh?'Conditional velocities → marginal-like direction':'Conditional velocities → marginal-like direction';desc.textContent=zh?'點圖上任一位置。附近 sampled pairs 各自有 e−x；紫色箭頭是這些 conditional velocities 的有限樣本平均。':'Click anywhere. Nearby sampled pairs have different e−x directions; purple is their finite-sample average.';formula.textContent=`v̂(z_t,t) ≈ (1/${k}) Σ_near (ε_i − x_i)`;caption.textContent=zh?'橘色不是唯一 ground-truth velocity；同一附近 state 可能對應多個 conditional directions。紫色才是 sample-average 近似。':'Orange arrows are sample-specific conditional directions; purple is their sample-average approximation.'}function q(s){const a={x:-2.2,y:-1},b={x:2.1,y:.9},dx=b.x-a.x,dy=b.y-a.y,n=Math.hypot(dx,dy),px=-dy/n,py=dx/n,bend=1.15*Math.sin(Math.PI*s);return{x:(1-s)*a.x+s*b.x+bend*px,y:(1-s)*a.y+s*b.y+bend*py}}function qp(s){const dx=4.3,dy=1.9,n=Math.hypot(dx,dy),px=-dy/n,py=dx/n,c=1.15*Math.PI*Math.cos(Math.PI*s);return{x:dx+c*px,y:dy+c*py}}function average(r,t){if(r>=t-.03){r=Math.max(0,t-.03);rEl.value=r.toFixed(2);ro.textContent=r.toFixed(2)}clear();let last=q(0);for(let s=.02;s<=1.001;s+=.02){const cur=q(s);L(last.x,last.y,cur.x,cur.y,'#9f8d7e',2,.6);last=cur}const qr=q(r),qt=q(t),vv=qp(t),u={x:(qt.x-qr.x)/(t-r),y:(qt.y-qr.y)/(t-r)};C(qr,'#638a69',5,1,'#30251d',1);C(qt,'#fffdf8',5,1,'#30251d',1);A(qt,vv,'#c47a3d',.16,2.7);A(qr,u,'#7d678f',.18,3.2);title.textContent=zh?'Curved path：local v 與 interval-average u':'Curved path: local v vs interval-average u';desc.textContent=zh?'橘色是 t 點的 instantaneous tangent；紫色只負責摘要 [r,t] 的總位移，因此在彎曲路徑上兩者可以很不一樣。':'Orange is the instantaneous tangent at t; purple summarizes displacement over [r,t], so they can differ substantially on a curved path.';formula.textContent=`u(r,t) = (q(t) − q(r)) / (t − r),  Δt=${(t-r).toFixed(2)}`;caption.textContent=zh?'這是幾何 toy path，不是 trained MeanFlow output；目的是看懂 local quantity 與 finite-time quantity 的差別。':'This is a geometric toy path, not a trained MeanFlow output; it isolates the difference between local and finite-time quantities.'}function render(){const t=+tEl.value,k=+kEl.value,r=+rEl.value;to.textContent=t.toFixed(2);ko.textContent=String(k);ro.textContent=r.toFixed(2);krow.hidden=mode!=='marginal';rrow.hidden=mode!=='average';if(mode==='path')path(t);else if(mode==='marginal')marginal(t,k);else average(r,t)}tabs.forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;tabs.forEach(x=>x.classList.toggle('active',x===b));render()}));[tEl,kEl,rEl].forEach(x=>x.addEventListener('input',render));svg.addEventListener('click',e=>{if(mode!=='marginal')return;const box=svg.getBoundingClientRect(),x=(e.clientX-box.left)/box.width*820,y=(e.clientY-box.top)/box.height*430;anchor={x:(x-410)/105,y:(215-y)/78};render()});render()}
</script>
