<div class="interactive-frame" data-loss-explorer>
  <div class="loss-tabs" role="tablist">
    <button class="active" data-k="mf">Original MF</button><button data-k="eqv">Equivalent v-loss</button><button data-k="imf">iMF</button>
  </div>
  <div data-box></div>
</div>
<style>.loss-tabs{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.8rem}.loss-tabs button{padding:.55rem .75rem;border:1px solid #7a8794;border-radius:.5rem;background:transparent;color:inherit;cursor:pointer}.loss-tabs button.active{background:#e7eef5;color:#163449}.loss-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:.5rem}.loss-node{padding:.7rem;border:1px solid #798896;border-radius:.55rem;text-align:center}.loss-arrow{text-align:center}@media(max-width:620px){.loss-flow{grid-template-columns:1fr}.loss-arrow{transform:rotate(90deg)}}</style>
<script>
for(const root of document.querySelectorAll('[data-loss-explorer]')){if(root.dataset.ready)continue;root.dataset.ready='1';const box=root.querySelector('[data-box]'),btns=[...root.querySelectorAll('button')];const data={mf:['Original MF','uθ','u_target','u_target=(e−x)−(t−r)JVP(uθ;e−x)','The target itself contains the current network through JVP, so the apparent regression target moves as θ changes.'],eqv:['Equivalent v-loss','uθ + JVP(e−x)','Vθ(z_t,e−x)','Vθ=uθ+(t−r)JVP_sg(uθ;e−x)','Same objective, new view: the predictor itself requires sample-specific e−x as a JVP tangent.'],imf:['Improved MeanFlow','uθ + JVP(vθ)','Vθ(z_t)','Vθ=uθ+(t−r)JVP_sg(uθ;vθ)','e−x remains supervision, but the predictor/JVP pathway uses a marginal-velocity estimate vθ(z_t).']};function show(k){const d=data[k];btns.forEach(b=>b.classList.toggle('active',b.dataset.k===k));box.innerHTML=`<h3>${d[0]}</h3><div class="loss-flow"><div class="loss-node">${d[1]}</div><div class="loss-arrow">→</div><div class="loss-node">${d[2]}</div><div class="loss-arrow">↔</div><div class="loss-node">supervision: e−x</div></div><p><code>${d[3]}</code></p><p>${d[4]}</p>`}btns.forEach(b=>b.addEventListener('click',()=>show(b.dataset.k)));show('mf')}
</script>
