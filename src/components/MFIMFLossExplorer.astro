---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="interactive-frame" data-loss-explorer data-lang={isZh ? 'zh' : 'en'}>
  <div class="loss-tabs" role="tablist">
    <button class="active" data-k="mf">Original MF</button><button data-k="eqv">Equivalent v-loss</button><button data-k="imf">iMF</button>
  </div>
  <div data-box></div>
</div>
<style>.loss-tabs{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.8rem}.loss-tabs button{padding:.55rem .75rem;border:1px solid #7a8794;border-radius:.5rem;background:transparent;color:inherit;cursor:pointer}.loss-tabs button.active{background:#e7eef5;color:#163449}.loss-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:.5rem}.loss-node{padding:.7rem;border:1px solid #798896;border-radius:.55rem;text-align:center}.loss-arrow{text-align:center}@media(max-width:620px){.loss-flow{grid-template-columns:1fr}.loss-arrow{transform:rotate(90deg)}}</style>
<script>
for(const root of document.querySelectorAll('[data-loss-explorer]')){if(root.dataset.ready)continue;root.dataset.ready='1';const isZh=root.dataset.lang==='zh';const box=root.querySelector('[data-box]'),btns=[...root.querySelectorAll('button')];const en={mf:['Original MF','uθ','u_target','u_target=(e−x)−(t−r)JVP(uθ;e−x)','The target itself contains the current network through JVP, so the apparent regression target moves as θ changes.'],eqv:['Equivalent v-loss','uθ + JVP(e−x)','Vθ(z_t,e−x)','Vθ=uθ+(t−r)JVP_sg(uθ;e−x)','Same objective, new view: the predictor itself requires sample-specific e−x as a JVP tangent.'],imf:['Improved MeanFlow','uθ + JVP(vθ)','Vθ(z_t)','Vθ=uθ+(t−r)JVP_sg(uθ;vθ)','e−x remains supervision, but the predictor/JVP pathway uses a marginal-velocity estimate vθ(z_t).']};const zh={mf:['Original MF','uθ','u_target','u_target=(e−x)−(t−r)JVP(uθ;e−x)','Target 本身透過 JVP 又包含目前的 network，所以 θ 改變時，apparent regression target 也跟著移動。'],eqv:['Equivalent v-loss','uθ + JVP(e−x)','Vθ(z_t,e−x)','Vθ=uθ+(t−r)JVP_sg(uθ;e−x)','同一個 objective 換一個角度看：predictor 本身需要 sample-specific 的 e−x 作為 JVP tangent。'],imf:['Improved MeanFlow','uθ + JVP(vθ)','Vθ(z_t)','Vθ=uθ+(t−r)JVP_sg(uθ;vθ)','e−x 仍然是 supervision，但 predictor / JVP pathway 改用 marginal-velocity estimate vθ(z_t)。']};const data=isZh?zh:en;function show(k){const d=data[k];btns.forEach(b=>b.classList.toggle('active',b.dataset.k===k));box.innerHTML=`<h3>${d[0]}</h3><div class="loss-flow"><div class="loss-node">${d[1]}</div><div class="loss-arrow">→</div><div class="loss-node">${d[2]}</div><div class="loss-arrow">↔</div><div class="loss-node">${isZh?'監督訊號':'supervision'}: e−x</div></div><p><code>${d[3]}</code></p><p>${d[4]}</p>`}btns.forEach(b=>b.addEventListener('click',()=>show(b.dataset.k)));show('mf')}
</script>
