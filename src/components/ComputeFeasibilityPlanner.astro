---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
const prefix = isZh ? '/research-handbook' : '/research-handbook/en';

const gpuPresets = [
  {id:'rtx3060', name:'RTX 3060 12 GB', vram:12, source:''},
  {id:'rtx3090', name:'RTX 3090 24 GB', vram:24, source:''},
  {id:'rtx4090', name:'RTX 4090 24 GB', vram:24, source:'https://www.nvidia.com/en-us/geforce/graphics-cards/40-series/rtx-4090/'},
  {id:'rtx5090', name:'RTX 5090 32 GB', vram:32, source:'https://www.nvidia.com/en-us/geforce/graphics-cards/50-series/rtx-5090/'},
  {id:'a6000', name:'RTX A6000 / 48 GB class', vram:48, source:''},
  {id:'rtx6000ada', name:'RTX 6000 Ada 48 GB', vram:48, source:'https://www.nvidia.com/en-us/products/workstations/rtx-6000/'},
  {id:'a10040', name:'A100 40 GB', vram:40, source:'https://www.nvidia.com/en-us/data-center/a100/'},
  {id:'a10080', name:'A100 80 GB', vram:80, source:'https://www.nvidia.com/en-us/data-center/a100/'},
  {id:'h10080', name:'H100 SXM 80 GB', vram:80, source:'https://www.nvidia.com/en-us/data-center/h100/'},
  {id:'h200', name:'H200 141 GB', vram:141, source:'https://www.nvidia.com/en-us/data-center/h200/'},
  {id:'b200', name:'B200 180 GB', vram:180, source:'https://docs.nvidia.com/enterprise-reference-architectures/hgx-ai-factory-h100-h200-b200/latest/components.html'},
  {id:'custom', name:isZh ? '自訂 VRAM' : 'Custom VRAM', vram:24, source:''},
];

const categories = [
  ['all', isZh ? '全部任務' : 'All tasks'],
  ['image', isZh ? '影像生成' : 'Image generation'],
  ['multimodal', isZh ? '圖文 / 多模態' : 'Multimodal'],
  ['video', isZh ? '影片' : 'Video'],
  ['robotics', isZh ? '機器人 / Action' : 'Robotics / Action'],
  ['driving', isZh ? '自駕 / Motion' : 'Driving / Motion'],
  ['molecule', isZh ? '分子 / 材料' : 'Molecule / Materials'],
  ['timeseries', isZh ? '時間序列 / Dynamics' : 'Time series / Dynamics'],
  ['3d', isZh ? '3D / Motion' : '3D / Motion'],
  ['medical', isZh ? '醫療 / Biosignal' : 'Medical / Biosignal'],
];

const levels = [
  ['all', isZh ? '全部實驗尺度' : 'All experiment scales'],
  ['smoke', isZh ? 'Smoke test / prototype' : 'Smoke test / prototype'],
  ['ablation', isZh ? '研究型 ablation' : 'Research ablation'],
  ['paper', isZh ? '接近 paper-scale' : 'Near paper-scale'],
];

const workloads = [
  {dataset:'CIFAR-10', name:'Flow / diffusion smoke test', cat:'image', level:'smoke', min:8, comfy:12, gpus:1, shard:false, storage:1, storageText:'< 10 GB', ram:'16–32 GB', access:'open', role:isZh?'先驗證 loss、sampling、JVP / ODE 實作是否正確。':'Validate losses, sampling, JVP/ODE implementation first.', why:isZh?'最適合單卡快速迭代；不適合拿來宣稱 ImageNet-scale 結論。':'Ideal for single-GPU iteration; not evidence of ImageNet-scale behavior.', opt:'mixed precision', source:'https://www.cs.toronto.edu/~kriz/cifar.html'},
  {dataset:'AFHQ v2 / CelebA', name:'Small-domain image generation', cat:'image', level:'ablation', min:12, comfy:16, gpus:1, shard:false, storage:1, storageText:'< 50 GB', ram:'32 GB', access:'open/terms', role:isZh?'做 one/few-step generation、loss ablation、domain generation。':'One/few-step generation, loss ablations, domain generation.', why:isZh?'比 ImageNet 便宜很多，但已比 CIFAR 更接近真實影像問題。':'Much cheaper than ImageNet while more realistic than CIFAR.', opt:'FP16/BF16 · latent cache', source:'https://github.com/clovaai/stargan-v2'},
  {dataset:'FFHQ 256', name:'High-quality single-domain generation', cat:'image', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:2, storageText:'50–200 GB', ram:'32–64 GB', access:'terms', role:isZh?'測高頻細節、one-step endpoint quality、refinement。':'High-frequency detail, one-step endpoint quality, refinement.', why:isZh?'適合 RMFlow-style refinement 或 endpoint error，但不是 class-conditional benchmark。':'Useful for refinement/endpoint error; not a class-conditional benchmark.', opt:'latent training · checkpointing', source:'https://github.com/NVlabs/ffhq-dataset'},
  {dataset:'ImageNet-1K 256', name:'Small DiT / MeanFlow prototype', cat:'image', level:'ablation', min:20, comfy:24, gpus:1, shard:true, storage:2, storageText:'~0.2–0.5 TB incl. caches', ram:'64 GB', access:'terms', role:isZh?'以縮小 backbone / batch 做 MeanFlow、iMF、curriculum objective ablation。':'MeanFlow/iMF/curriculum ablations with smaller backbone or batch.', why:isZh?'保留 ImageNet benchmark continuity，但這不是完整 paper-scale reproduction。':'Keeps ImageNet continuity without claiming full paper-scale reproduction.', opt:'BF16 · gradient accumulation · checkpointing · cached VAE latents', source:'https://www.image-net.org/download.php'},
  {dataset:'ImageNet-1K 256', name:'MeanFlow-B/2-class objective study', cat:'image', level:'ablation', min:24, comfy:48, gpus:1, shard:true, storage:2, storageText:'~0.2–0.5 TB incl. caches', ram:'64–128 GB', access:'terms', role:isZh?'研究 r=t、small-Δt curriculum、JVP tangent、2-NFE 等核心假設。':'Study r=t, small-Δt curriculum, JVP tangent, 2-NFE hypotheses.', why:isZh?'24 GB 可以做低 batch / checkpointing 版本；48 GB 會舒服很多。':'24 GB is a tight low-batch/checkpointed setup; 48 GB is substantially easier.', opt:'BF16 · checkpointing · gradient accumulation · 8-bit optimizer optional', source:`${prefix}/papers/meanflow/`},
  {dataset:'ImageNet-1K 256', name:'MeanFlow / iMF XL-scale proxy', cat:'image', level:'paper', min:48, comfy:80, gpus:4, shard:true, storage:2, storageText:'~0.5 TB+ with caches/checkpoints', ram:'128 GB+', access:'terms', role:isZh?'接近大型 DiT 的 full-training / scaling study。':'Large-DiT full-training / scaling study.', why:isZh?'這是 planning proxy，不宣稱是論文官方最低硬體；通常需要多卡與分散式訓練。':'A planning proxy, not an official paper minimum; multi-GPU distributed training is normally required.', opt:'DDP/FSDP · BF16 · checkpointing · fast storage', source:`${prefix}/papers/improved-meanflow/`},
  {dataset:'COCO 2017', name:'Latent text-to-image fine-tuning / evaluation', cat:'multimodal', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:2, storageText:'~50–150 GB', ram:'32–64 GB', access:'open', role:isZh?'做小型 text-conditioned flow/diffusion、CLIP/FID 評估與 conditioning ablation。':'Small text-conditioned flow/diffusion and conditioning ablations.', why:isZh?'適合 fine-tune 或 evaluation；不等同 web-scale T2I pretraining。':'Good for fine-tuning/evaluation, not web-scale T2I pretraining.', opt:'precompute text / VAE latents', source:'https://cocodataset.org/'},
  {dataset:'CC3M / CC12M', name:'Mid-scale vision-language pretraining', cat:'multimodal', level:'paper', min:24, comfy:48, gpus:2, shard:true, storage:3, storageText:'0.5–2 TB depending on URL survival/cache', ram:'64–128 GB', access:'volatile', role:isZh?'研究 text-image conditioning、data filtering、較小型 T2I pretraining。':'Text-image conditioning, data filtering, mid-scale T2I pretraining.', why:isZh?'真正瓶頸常是下載、URL decay、解碼與 cache，而不只 GPU。':'Download, URL decay, decoding and cache can dominate the GPU bottleneck.', opt:'distributed data pipeline · latent caching', source:'https://github.com/google-research-datasets/conceptual-12m'},
  {dataset:'LAION / DataComp-scale', name:'Web-scale text-image pretraining', cat:'multimodal', level:'paper', min:80, comfy:80, gpus:8, shard:true, storage:4, storageText:'multi-TB to much larger', ram:'256 GB+ node', access:'volatile', role:isZh?'大型 foundation / T2I pretraining。':'Large foundation / T2I pretraining.', why:isZh?'不適合有限實驗室資源直接 from-scratch；更適合作為合作 / cloud 計畫。':'Usually a collaboration/cloud project rather than a limited-lab from-scratch run.', opt:'multi-node · sharding · data streaming · dedup/filtering', source:'https://www.datacomp.ai/'},
  {dataset:'KTH Actions', name:'Video dynamics smoke test', cat:'video', level:'smoke', min:12, comfy:16, gpus:1, shard:false, storage:1, storageText:'< 20 GB', ram:'32 GB', access:'open', role:isZh?'測 video probability path、temporal consistency、Flow Divergence 類方法。':'Video probability paths, temporal consistency, Flow Divergence-style methods.', why:isZh?'小、乾淨，非常適合先確認 temporal method 是否有效。':'Small and clean; ideal before scaling temporal methods.', opt:'short clips · latent video', source:'https://www.csc.kth.se/cvap/actions/'},
  {dataset:'UCF101', name:'Latent video generation ablation', cat:'video', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:2, storageText:'~20–100 GB', ram:'32–64 GB', access:'open', role:isZh?'做 video generation / action-conditioned temporal ablation。':'Video generation and temporal/action-conditioned ablations.', why:isZh?'單卡仍可做 latent / reduced-resolution experiments。':'Still manageable on one GPU with latent/reduced-resolution training.', opt:'latent video · clip sampling · checkpointing', source:'https://www.crcv.ucf.edu/data/UCF101.php'},
  {dataset:'Kinetics-700', name:'Large video pretraining', cat:'video', level:'paper', min:48, comfy:80, gpus:4, shard:true, storage:4, storageText:'multi-TB / URL-dependent', ram:'128 GB+', access:'volatile', role:isZh?'large-scale video backbone / generation pretraining。':'Large-scale video backbone/generation pretraining.', why:isZh?'video decode、temporal activation 與 I/O 都很重，適合合作算力。':'Video decoding, temporal activations and I/O make this collaboration-scale.', opt:'multi-GPU · video cache · low-res curriculum', source:'https://www.deepmind.com/open-source/kinetics'},
  {dataset:'BAIR Robot Pushing', name:'Action-conditioned video toy', cat:'robotics', level:'smoke', min:12, comfy:16, gpus:1, shard:false, storage:1, storageText:'< 50 GB', ram:'32 GB', access:'open', role:isZh?'把 action 與 future frame / dynamics 先做成便宜 prototype。':'Cheap prototype for action-conditioned future frames/dynamics.', why:isZh?'很適合測 flow-based action/video idea，不需要真實機器人。':'Useful for flow-based action/video ideas without a physical robot.', opt:'short horizon · latent video', source:'https://www.tensorflow.org/datasets/catalog/bair_robot_pushing_small'},
  {dataset:'RoboMimic', name:'Diffusion / flow policy prototype', cat:'robotics', level:'smoke', min:12, comfy:16, gpus:1, shard:false, storage:1, storageText:'< 100 GB depending subset', ram:'32 GB', access:'open', role:isZh?'behavior cloning、offline policy、action chunk / trajectory generation。':'Behavior cloning, offline policy, action-chunk/trajectory generation.', why:isZh?'格式與 baseline 完整，是把 MeanFlow-style temporal ideas搬到 robotics 的好起點。':'Well-structured baseline suite for transferring MeanFlow-style temporal ideas to robotics.', opt:'freeze vision encoder · short horizons', source:'https://robomimic.github.io/docs/datasets/overview.html'},
  {dataset:'LIBERO', name:'Long-horizon manipulation ablation', cat:'robotics', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:2, storageText:'tens to low hundreds GB', ram:'32–64 GB', access:'open', role:isZh?'long-horizon multitask policy、curriculum、trajectory horizon。':'Long-horizon multitask policy, curriculum, trajectory horizon.', why:isZh?'非常適合檢驗 small-horizon → long-horizon curriculum 是否類似 MeanFlow Δt curriculum。':'Good for testing whether short→long horizon curricula mirror MeanFlow Δt curricula.', opt:'frozen encoder · action chunking · gradient accumulation', source:'https://libero-project.github.io/'},
  {dataset:'BridgeData V2', name:'Real-robot flow/diffusion policy', cat:'robotics', level:'ablation', min:24, comfy:32, gpus:1, shard:true, storage:3, storageText:'hundreds GB to ~TB with decoded video/caches', ram:'64–128 GB', access:'open', role:isZh?'language-conditioned manipulation、action generation、generalization。':'Language-conditioned manipulation, action generation, generalization.', why:isZh?'單張 24–32 GB 卡可做 subset / frozen encoder；全資料 preprocessing 和 I/O 更重。':'A 24–32 GB GPU can handle subsets/frozen encoders; full-data preprocessing/I/O is heavier.', opt:'precompute visual embeddings · subset first', source:'https://rail-berkeley.github.io/bridgedata/'},
  {dataset:'DROID', name:'Real-world manipulation subset study', cat:'robotics', level:'ablation', min:24, comfy:48, gpus:1, shard:true, storage:4, storageText:'TB-class once video/cache is included', ram:'128 GB recommended', access:'open', role:isZh?'真實世界 action generation、cross-scene generalization、VLA-style conditioning。':'Real-world action generation, cross-scene generalization, VLA-style conditioning.', why:isZh?'GPU 不是唯一瓶頸；資料 decode、SSD 與 preprocessing 很重要。':'GPU is not the only bottleneck; decoding, SSD and preprocessing matter heavily.', opt:'subset · frame sampling · frozen encoder · embedding cache', source:'https://droid-dataset.github.io/'},
  {dataset:'Open X-Embodiment', name:'Cross-embodiment subset experiment', cat:'robotics', level:'ablation', min:32, comfy:48, gpus:1, shard:true, storage:4, storageText:'TB-class / source-dependent', ram:'128 GB+', access:'terms', role:isZh?'跨 robot embodiment 的 action representation / transfer。':'Cross-embodiment action representation and transfer.', why:isZh?'可以先選 2–4 個 embodiment 做研究問題，不必一開始吃完整聚合資料。':'Start with 2–4 embodiments rather than the full aggregation.', opt:'subset · common action schema · frozen encoders', source:'https://robotics-transformer-x.github.io/'},
  {dataset:'Open X-Embodiment', name:'Generalist VLA-scale training proxy', cat:'robotics', level:'paper', min:80, comfy:80, gpus:8, shard:true, storage:4, storageText:'multi-TB', ram:'256 GB+ node', access:'terms', role:isZh?'generalist VLA / large cross-embodiment policy。':'Generalist VLA / large cross-embodiment policy.', why:isZh?'更像合作 / cluster project，不適合單卡 from scratch。':'A collaboration/cluster project rather than a single-GPU from-scratch run.', opt:'multi-node · sharding · data mixing', source:'https://robotics-transformer-x.github.io/'},
  {dataset:'Argoverse 2 / nuScenes', name:'Motion forecasting prototype', cat:'driving', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:3, storageText:'hundreds GB', ram:'64–128 GB', access:'terms', role:isZh?'trajectory / motion generation、map-conditioned flow、uncertainty。':'Trajectory/motion generation, map-conditioned flow, uncertainty.', why:isZh?'若只用 vectorized trajectories，不一定需要很大 GPU；sensor generation 則完全不同。':'Vectorized trajectory work can be modest; raw-sensor generation is much heavier.', opt:'vectorized scenes · cached maps', source:'https://www.argoverse.org/av2.html'},
  {dataset:'Waymo Open', name:'Large driving motion / sensor study', cat:'driving', level:'paper', min:32, comfy:48, gpus:4, shard:true, storage:4, storageText:'multi-TB depending modality', ram:'128 GB+', access:'terms', role:isZh?'large motion forecasting、sensor fusion、scene generation。':'Large motion forecasting, sensor fusion, scene generation.', why:isZh?'只做 motion tracks 可縮小；camera/lidar generative modeling 會迅速變成 cluster workload。':'Motion-only can be reduced; camera/lidar generation quickly becomes cluster-scale.', opt:'modality subset · feature cache · distributed loading', source:'https://waymo.com/open/'},
  {dataset:'QM9', name:'Molecule generation baseline', cat:'molecule', level:'smoke', min:8, comfy:12, gpus:1, shard:false, storage:1, storageText:'< 10 GB', ram:'16–32 GB', access:'open', role:isZh?'context-to-molecule、3D equivariant / flow generation；RMFlow 直接相關。':'Context-to-molecule and 3D equivariant/flow generation; directly relevant to RMFlow.', why:isZh?'資料小，適合在有限 GPU 下做真正有 benchmark 意義的 generation。':'Small enough for meaningful generative benchmarks under limited compute.', opt:'FP32/BF16 both practical', source:'https://www.tensorflow.org/datasets/catalog/qm9'},
  {dataset:'GEOM / MOSES', name:'Larger molecule generation', cat:'molecule', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:2, storageText:'tens to hundreds GB', ram:'32–64 GB', access:'open', role:isZh?'3D conformer / drug-like molecule generation、validity / novelty。':'3D conformer/drug-like molecule generation, validity/novelty.', why:isZh?'仍可單卡做，但 preprocessing、3D coordinates 與 evaluation 比 QM9 更重。':'Still single-GPU friendly, with heavier 3D preprocessing/evaluation than QM9.', opt:'coordinate batching · mixed precision', source:'https://github.com/learningmatter-mit/geom'},
  {dataset:'Lorenz / FitzHugh–Nagumo', name:'Known-dynamics probability-path test', cat:'timeseries', level:'smoke', min:4, comfy:8, gpus:1, shard:false, storage:1, storageText:'simulation-generated', ram:'16 GB', access:'synthetic', role:isZh?'檢驗 probability path、divergence、trajectory generation；可無限生成。':'Probability paths, divergence and trajectory generation with known dynamics.', why:isZh?'對 Flow Divergence / MeanFlow 理論 idea 非常便宜且可控。':'Very cheap and controlled for Flow Divergence/MeanFlow-style theoretical ideas.', opt:'CPU simulation + small GPU', source:'https://proceedings.mlr.press/v267/huang25ag.html'},
  {dataset:'UCR/UEA / ETT', name:'Time-series flow ablation', cat:'timeseries', level:'ablation', min:8, comfy:12, gpus:1, shard:false, storage:1, storageText:'< 20 GB', ram:'16–32 GB', access:'open', role:isZh?'forecasting、trajectory generation、long-horizon curriculum。':'Forecasting, trajectory generation, long-horizon curriculum.', why:isZh?'很適合研究「短 horizon → 長 horizon」是否和 MeanFlow Δt curriculum 類似。':'Good for testing short→long horizon curricula analogous to MeanFlow Δt.', opt:'small transformer / state-space encoder', source:'https://www.timeseriesclassification.com/'},
  {dataset:'HumanML3D', name:'Text-to-motion generation', cat:'3d', level:'ablation', min:12, comfy:24, gpus:1, shard:false, storage:2, storageText:'tens GB', ram:'32 GB', access:'open', role:isZh?'text-conditioned motion / trajectory generation、few-step motion sampling。':'Text-conditioned motion/trajectory generation and few-step motion sampling.', why:isZh?'比 raw 3D asset 容易很多，也與 robotics trajectory generation 有概念連結。':'Much lighter than raw 3D assets and conceptually linked to robot trajectory generation.', opt:'motion latent · frozen text encoder', source:'https://github.com/EricGuo5513/HumanML3D'},
  {dataset:'Objaverse subset', name:'3D generative prototype', cat:'3d', level:'ablation', min:24, comfy:48, gpus:1, shard:true, storage:4, storageText:'subset-dependent; full corpus very large', ram:'64–128 GB', access:'terms', role:isZh?'3D asset / view-conditioned generation。':'3D asset/view-conditioned generation.', why:isZh?'資料與 rendering pipeline 常比模型本身更麻煩，建議從 subset 開始。':'Data/rendering pipelines can dominate; start from a subset.', opt:'pre-render views · latent 3D representation', source:'https://objaverse.allenai.org/'},
  {dataset:'MedMNIST v2', name:'Medical-generation smoke test', cat:'medical', level:'smoke', min:8, comfy:12, gpus:1, shard:false, storage:1, storageText:'< 10 GB', ram:'16–32 GB', access:'open', role:isZh?'先驗證 medical conditional generation / classification-guided pipeline。':'Validate medical conditional-generation pipelines cheaply.', why:isZh?'適合方法 smoke test，不代表 clinical-scale 難度。':'Useful for method smoke tests, not clinical-scale difficulty.', opt:'small CNN/ViT · mixed precision', source:'https://medmnist.com/'},
  {dataset:'MIMIC-CXR / MIMIC-IV-ECG', name:'Clinical multimodal / biosignal study', cat:'medical', level:'ablation', min:16, comfy:24, gpus:1, shard:false, storage:3, storageText:'hundreds GB; restricted access', ram:'64 GB', access:'restricted', role:isZh?'X-ray/report generation、ECG generation、clinical representation。':'X-ray/report generation, ECG generation, clinical representation.', why:isZh?'算力未必最大瓶頸；credentialing、DUA 與 data governance 更關鍵。':'Compute may not be the biggest bottleneck; credentialing and governance are critical.', opt:'credentialed access · de-identified workflow', source:'https://physionet.org/'},
];

const storageLabels = [
  ['4', isZh ? '不限 storage' : 'Any storage'],
  ['1', isZh ? '低：< 100 GB' : 'Low: < 100 GB'],
  ['2', isZh ? '中：大約 < 0.5 TB' : 'Medium: roughly < 0.5 TB'],
  ['3', isZh ? '高：可接受 ~TB 級' : 'High: TB-class is acceptable'],
];
---

<div class="compute-planner" data-compute-planner>
  <div class="planner-head">
    <div>
      <span class="eyebrow">COMPUTE FEASIBILITY PLANNER</span>
      <strong>{isZh ? '用你手上的 GPU 反推「現在能做什麼實驗」' : 'Map available GPU resources to experiments you can run now'}</strong>
      <p>{isZh ? '這裡估的是「dataset + model / experiment profile」，不是說某個 dataset 本身需要固定 VRAM。數字是 practical planning estimate，不是論文官方最低硬體。' : 'This estimates dataset + model/experiment profiles, not a fixed VRAM requirement for a dataset itself. Values are practical planning estimates, not official paper minimums.'}</p>
    </div>
    <div class="planner-summary">
      <div><b data-local-count>0</b><small>{isZh ? '本機可做' : 'local fits'}</small></div>
      <div><b data-tight-count>0</b><small>{isZh ? '需省記憶體' : 'tight fits'}</small></div>
      <div><b data-collab-count>0</b><small>{isZh ? '合作 / cluster' : 'collab / cluster'}</small></div>
    </div>
  </div>

  <div class="planner-controls">
    <label>
      <span>{isZh ? 'GPU 型號' : 'GPU preset'}</span>
      <select data-gpu>{gpuPresets.map(g => <option value={g.id} data-vram={g.vram}>{g.name}</option>)}</select>
    </label>
    <label class="custom-vram" data-custom-wrap hidden>
      <span>{isZh ? '每張 GPU VRAM (GB)' : 'VRAM per GPU (GB)'}</span>
      <input type="number" min="4" max="512" step="1" value="24" data-custom-vram />
    </label>
    <label>
      <span>{isZh ? 'GPU 數量' : 'GPU count'}</span>
      <select data-gpu-count><option>1</option><option>2</option><option>4</option><option>8</option></select>
    </label>
    <label>
      <span>{isZh ? '任務族群' : 'Task family'}</span>
      <select data-category>{categories.map(([v,l]) => <option value={v}>{l}</option>)}</select>
    </label>
    <label>
      <span>{isZh ? '實驗尺度' : 'Experiment scale'}</span>
      <select data-level>{levels.map(([v,l]) => <option value={v}>{l}</option>)}</select>
    </label>
    <label>
      <span>{isZh ? 'Storage 預算' : 'Storage budget'}</span>
      <select data-storage>{storageLabels.map(([v,l]) => <option value={v}>{l}</option>)}</select>
    </label>
    <label class="checkline"><input type="checkbox" data-local-only /><span>{isZh ? '只顯示本機可行' : 'Show local-feasible only'}</span></label>
    <button type="button" data-reset>{isZh ? '重設' : 'Reset'}</button>
  </div>

  <div class="resource-strip">
    <div><span>{isZh ? '目前配置' : 'Selected hardware'}</span><strong data-config-label>RTX 3060 12 GB × 1</strong><a data-gpu-source hidden target="_blank" rel="noreferrer">{isZh ? '官方規格 ↗' : 'Official specs ↗'}</a></div>
    <div><span>{isZh ? '重要提醒' : 'Important'}</span><strong>{isZh ? '普通 DDP 不會把每張 GPU 的 VRAM 相加' : 'Ordinary DDP does not pool VRAM across GPUs'}</strong><small>{isZh ? '只有 FSDP / ZeRO / model sharding 等方法才可能利用多卡分攤模型與 optimizer state。' : 'FSDP / ZeRO / model sharding can distribute model and optimizer state across GPUs.'}</small></div>
    <div><span>{isZh ? 'Host 建議' : 'Host guidance'}</span><strong>{isZh ? '小型：32–64 GB RAM；大型資料：128 GB+ + NVMe' : 'Small: 32–64 GB RAM; large data: 128 GB+ + NVMe'}</strong><small>{isZh ? 'video / robotics / web-scale 常先被 decode、cache 與 I/O 卡住。' : 'Video, robotics and web-scale jobs are often I/O/decode limited first.'}</small></div>
  </div>

  <div class="status-legend">
    <span class="legend-good">{isZh ? '適合：資源有餘裕' : 'Comfortable'}</span>
    <span class="legend-tight">{isZh ? '可做：需降低 batch / checkpointing' : 'Feasible with memory savings'}</span>
    <span class="legend-shard">{isZh ? '可做：需 sharding / 多卡技巧' : 'Feasible with sharding'}</span>
    <span class="legend-collab">{isZh ? '合作候選：本機不建議' : 'Collaboration candidate'}</span>
  </div>

  <div class="workload-grid" data-workload-grid>
    {workloads.map((w, i) => (
      <article class="workload-card" data-workload data-index={i} data-cat={w.cat} data-level={w.level} data-min={w.min} data-comfy={w.comfy} data-gpus={w.gpus} data-shard={w.shard ? '1':'0'} data-storage={w.storage}>
        <div class="workload-top"><span class="status" data-status></span><span class="scale">{levels.find(([v])=>v===w.level)?.[1]}</span></div>
        <h3>{w.dataset}</h3>
        <strong class="workload-name">{w.name}</strong>
        <p>{w.role}</p>
        <dl>
          <div><dt>{isZh ? 'Planning VRAM' : 'Planning VRAM'}</dt><dd>{w.min} GB {isZh ? '最低起跑' : 'starting'} · {w.comfy} GB {isZh ? '較舒服' : 'comfortable'} · {w.gpus > 1 ? `${w.gpus}+ GPUs` : '1 GPU'}</dd></div>
          <div><dt>{isZh ? 'Storage / RAM' : 'Storage / RAM'}</dt><dd>{w.storageText} · RAM {w.ram}</dd></div>
          <div><dt>{isZh ? '為什麼適合 / 不適合' : 'Why this fit matters'}</dt><dd>{w.why}</dd></div>
          <div><dt>{isZh ? '省資源策略' : 'Resource-saving strategy'}</dt><dd>{w.opt}</dd></div>
        </dl>
        <div class="gap-note" data-gap-note></div>
        <a href={w.source} target={w.source.startsWith('http') ? '_blank' : undefined} rel={w.source.startsWith('http') ? 'noreferrer' : undefined}>{isZh ? '資料 / 相關筆記 ↗' : 'Data / related note ↗'}</a>
      </article>
    ))}
  </div>
  <div class="planner-empty" data-empty hidden>{isZh ? '目前條件沒有符合的 experiment profile。可以放寬任務、storage 或取消「只顯示本機可行」。' : 'No experiment profile matches the current filters. Relax task/storage filters or disable local-only mode.'}</div>

  <div class="estimate-note">
    <strong>{isZh ? '怎麼解讀這些數字？' : 'How to read these estimates'}</strong>
    <p>{isZh ? 'VRAM 估計故意保守地以常見 mixed-precision training、合理 batch 與常見 memory optimization 為前提。實際需求會隨 backbone、resolution、sequence length、optimizer、JVP / higher-order autodiff、activation checkpointing、latent caching 與 framework 改變。若要做正式 reproduction，應優先採用 paper / official code 的 batch、GPU count 與 training setup。' : 'VRAM estimates assume common mixed-precision training and practical memory optimization. Actual requirements vary with backbone, resolution, sequence length, optimizer, JVP/higher-order autodiff, activation checkpointing, latent caching and framework. For formal reproduction, prefer the paper/official-code hardware and batch setup whenever reported.'}</p>
  </div>
</div>

<style>
.compute-planner{border:1px solid var(--rh-border);border-radius:1rem;background:var(--rh-surface);padding:1rem;margin:1rem 0 1.5rem;overflow:hidden}.planner-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center}.eyebrow{display:block;font-size:.67rem;letter-spacing:.12em;font-weight:800;color:var(--rh-caramel)}.planner-head strong{display:block;margin-top:.2rem;font-size:1.05rem}.planner-head p{margin:.3rem 0 0!important;color:var(--rh-muted);line-height:1.55}.planner-summary{display:grid;grid-template-columns:repeat(3,5rem);gap:.4rem}.planner-summary>div{border:1px solid var(--rh-border);background:var(--rh-surface-2);border-radius:.7rem;padding:.55rem;text-align:center}.planner-summary b{display:block;font-size:1.1rem}.planner-summary small{font-size:.62rem;color:var(--rh-muted);line-height:1.2}.planner-controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem;margin-top:1rem;align-items:end}.planner-controls label{display:grid;gap:.28rem;margin:0!important}.planner-controls label>span{font-size:.66rem;color:var(--rh-muted)}.planner-controls select,.planner-controls input,.planner-controls button{box-sizing:border-box;width:100%;height:2.55rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);color:var(--rh-text);font:inherit;padding:0 .65rem;margin:0}.planner-controls button{cursor:pointer;color:var(--rh-coffee);font-weight:700}.planner-controls .checkline{height:2.55rem;display:flex;align-items:center;gap:.45rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);padding:0 .65rem}.planner-controls .checkline input{width:1rem;height:1rem;padding:0}.planner-controls .checkline span{font-size:.72rem}.resource-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin-top:.75rem}.resource-strip>div{border:1px solid var(--rh-border);border-radius:.7rem;background:var(--rh-surface-2);padding:.7rem;min-height:6.1rem}.resource-strip span{display:block;font-size:.63rem;color:var(--rh-caramel);text-transform:uppercase;letter-spacing:.06em;font-weight:750}.resource-strip strong{display:block;margin-top:.25rem;font-size:.82rem;line-height:1.4}.resource-strip small{display:block;margin-top:.25rem;color:var(--rh-muted);font-size:.7rem;line-height:1.45}.resource-strip a{display:inline-block;margin-top:.3rem!important;font-size:.68rem;color:var(--rh-coffee)!important}.status-legend{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.8rem}.status-legend span{border:1px solid var(--rh-border);border-radius:999px;padding:.25rem .5rem;font-size:.65rem}.legend-good{background:color-mix(in srgb,#6e8b69 13%,var(--rh-surface))}.legend-tight{background:color-mix(in srgb,var(--rh-latte) 14%,var(--rh-surface))}.legend-shard{background:color-mix(in srgb,#80729a 12%,var(--rh-surface))}.legend-collab{background:color-mix(in srgb,#a25d4a 10%,var(--rh-surface))}.workload-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin-top:.8rem;align-items:stretch}.workload-card{border:1px solid var(--rh-border);border-radius:.8rem;background:var(--rh-surface-2);padding:.85rem;display:flex;flex-direction:column;height:100%;min-width:0}.workload-top{display:flex;justify-content:space-between;gap:.5rem;align-items:flex-start}.status{font-size:.66rem;font-weight:800;border-radius:999px;padding:.23rem .46rem;border:1px solid var(--rh-border)}.status.good{background:color-mix(in srgb,#6e8b69 15%,var(--rh-surface));color:#4f684b}.status.tight{background:color-mix(in srgb,var(--rh-latte) 18%,var(--rh-surface));color:var(--rh-coffee)}.status.shard{background:color-mix(in srgb,#80729a 13%,var(--rh-surface));color:#655879}.status.collab{background:color-mix(in srgb,#a25d4a 12%,var(--rh-surface));color:#854b3d}.scale{font-size:.62rem;color:var(--rh-muted);text-align:right}.workload-card h3{font-size:1rem;margin:.6rem 0 .15rem!important}.workload-name{font-size:.76rem;color:var(--rh-coffee);line-height:1.35}.workload-card>p{font-size:.78rem;color:var(--rh-muted);line-height:1.55;margin:.45rem 0 0!important}.workload-card dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin:.65rem 0!important}.workload-card dl>div{border:1px solid color-mix(in srgb,var(--rh-border) 80%,transparent);border-radius:.55rem;padding:.5rem;background:var(--rh-surface)}.workload-card dt{font-size:.6rem;color:var(--rh-caramel);text-transform:uppercase;letter-spacing:.05em;font-weight:750}.workload-card dd{margin:.18rem 0 0!important;font-size:.7rem;line-height:1.45}.gap-note{font-size:.7rem;line-height:1.5;padding:.5rem;border-left:3px solid var(--rh-border);background:var(--rh-surface);margin-top:.1rem!important}.workload-card>a{margin-top:auto!important;padding-top:.55rem;color:var(--rh-coffee)!important;font-size:.7rem;text-decoration:none!important;font-weight:700}.planner-empty{margin-top:.8rem;padding:1rem;border:1px dashed var(--rh-border);border-radius:.7rem;color:var(--rh-muted);text-align:center}.estimate-note{margin-top:.85rem;border-top:1px solid var(--rh-border);padding-top:.75rem}.estimate-note strong{font-size:.78rem}.estimate-note p{margin:.25rem 0 0!important;color:var(--rh-muted);font-size:.72rem;line-height:1.55}.compute-planner [hidden]{display:none!important}
:global(.sl-markdown-content .compute-planner :is(.planner-head,.planner-summary,.planner-controls,.resource-strip,.status-legend,.workload-grid,.workload-top) > *){margin-top:0!important}
@media(max-width:1000px){.planner-controls{grid-template-columns:repeat(3,minmax(0,1fr))}.resource-strip{grid-template-columns:1fr}.planner-head{grid-template-columns:1fr}.planner-summary{grid-template-columns:repeat(3,minmax(0,1fr));max-width:26rem}}@media(max-width:760px){.planner-controls{grid-template-columns:1fr 1fr}.workload-grid{grid-template-columns:1fr}.workload-card dl{grid-template-columns:1fr}}@media(max-width:520px){.planner-controls{grid-template-columns:1fr}.planner-summary{grid-template-columns:repeat(3,1fr)}}
</style>

<script define:vars={{ gpuPresets, isZh }}>
for(const root of document.querySelectorAll('[data-compute-planner]')){
  if(root.dataset.ready) continue;
  root.dataset.ready='1';
  const gpu=root.querySelector('[data-gpu]'), customWrap=root.querySelector('[data-custom-wrap]'), customVram=root.querySelector('[data-custom-vram]'), gpuCount=root.querySelector('[data-gpu-count]'), category=root.querySelector('[data-category]'), level=root.querySelector('[data-level]'), storage=root.querySelector('[data-storage]'), localOnly=root.querySelector('[data-local-only]'), reset=root.querySelector('[data-reset]'), configLabel=root.querySelector('[data-config-label]'), source=root.querySelector('[data-gpu-source]'), localCount=root.querySelector('[data-local-count]'), tightCount=root.querySelector('[data-tight-count]'), collabCount=root.querySelector('[data-collab-count]'), empty=root.querySelector('[data-empty]'), grid=root.querySelector('[data-workload-grid]'), cards=[...root.querySelectorAll('[data-workload]')];
  function selectedGPU(){const p=gpuPresets.find(x=>x.id===gpu.value)||gpuPresets[0];return {name:p.name,vram:gpu.value==='custom'?Number(customVram.value||24):p.vram,source:p.source||''}}
  function classify(card,vram,count){const min=Number(card.dataset.min),comfy=Number(card.dataset.comfy),need=Number(card.dataset.gpus),shard=card.dataset.shard==='1';if(vram>=comfy&&count>=need)return {key:'good',rank:0,label:isZh?'適合':'Comfortable',fit:true,note:isZh?'目前配置有合理餘裕，可優先考慮。':'Current setup has reasonable headroom.'};if(vram>=min&&count>=need)return {key:'tight',rank:1,label:isZh?'可做・偏緊':'Feasible · tight',fit:true,note:isZh?'建議降低 batch、使用 BF16/FP16、gradient accumulation 或 activation checkpointing。':'Use smaller batch, mixed precision, accumulation or checkpointing.'};if(shard&&count>=2&&count>=need&&vram*count>=min*need)return {key:'shard',rank:2,label:isZh?'可做・需 sharding':'Feasible · sharding',fit:true,note:isZh?'每張卡 VRAM 不足以直接跑；需 FSDP / ZeRO / model sharding，不能只靠普通 DDP。':'Per-GPU VRAM is tight; use FSDP/ZeRO/model sharding rather than ordinary DDP.'};const missing=[];if(vram<min)missing.push(isZh?`每張卡建議至少約 ${min} GB`:`~${min} GB/GPU starting point`);if(count<need)missing.push(isZh?`建議 ${need}+ GPUs`:`${need}+ GPUs suggested`);return {key:'collab',rank:3,label:isZh?'合作 / cluster 候選':'Collab / cluster candidate',fit:false,note:(isZh?'本機不建議直接 full run：':'Not recommended as a full local run: ')+missing.join('；')+(isZh?'。可改做 subset / smaller backbone，或找共享算力合作。':'. Try a subset/smaller backbone or shared compute collaboration.')};}
  function apply(){const g=selectedGPU(),count=Number(gpuCount.value),maxStorage=Number(storage.value),cat=category.value,lvl=level.value;customWrap.hidden=gpu.value!=='custom';configLabel.textContent=`${g.name.replace(isZh?'自訂 VRAM':'Custom VRAM',isZh?'自訂':'Custom')} ${gpu.value==='custom'?g.vram+' GB':''} × ${count}`.replace('  ×',' ×');if(g.source){source.hidden=false;source.href=g.source}else source.hidden=true;let local=0,tight=0,collab=0,shown=0;const ranked=[];cards.forEach(card=>{const st=classify(card,g.vram,count);card.dataset.status=st.key;const status=card.querySelector('[data-status]');status.className='status '+st.key;status.textContent=st.label;card.querySelector('[data-gap-note]').textContent=st.note;if(st.key==='good')local++;else if(st.fit)tight++;else collab++;const filters=(cat==='all'||card.dataset.cat===cat)&&(lvl==='all'||card.dataset.level===lvl)&&Number(card.dataset.storage)<=maxStorage&&(!localOnly.checked||st.fit);card.hidden=!filters;if(filters){shown++;ranked.push({card,rank:st.rank})}});ranked.sort((a,b)=>a.rank-b.rank||Number(a.card.dataset.index)-Number(b.card.dataset.index)).forEach(x=>grid.appendChild(x.card));localCount.textContent=String(local);tightCount.textContent=String(tight);collabCount.textContent=String(collab);empty.hidden=shown!==0;}
  [gpu,gpuCount,category,level,storage,localOnly,customVram].forEach(el=>{el.addEventListener(el.type==='checkbox'?'change':'change',apply);if(el===customVram)el.addEventListener('input',apply)});reset.addEventListener('click',()=>{gpu.value='rtx4090';customVram.value='24';gpuCount.value='1';category.value='all';level.value='all';storage.value='4';localOnly.checked=false;apply()});gpu.value='rtx4090';apply();
}
</script>
