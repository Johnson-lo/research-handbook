---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
const prefix = isZh ? '/research-handbook' : '/research-handbook/en';
const problems = isZh ? [
  {id:'q1',tag:'Representation / NFE',title:'如何把 local velocity 壓縮成 one-step finite-time transport？',status:'核心方法問題',body:'Flow Matching 的 instantaneous velocity 是 local quantity；MeanFlow 改學 interval-average velocity u，直接表示 finite-time transport。',papers:[['MeanFlow',`${prefix}/papers/meanflow/`]],transfer:['Flow Map Matching：finite-time displacement representation','Shortcut Models：two-time / self-consistency view']},
  {id:'q2',tag:'Training dynamics',title:'是否應先建立 r=t / small-Δt 能力，再學 large-gap u？',status:'有直接實驗證據，protocol 仍可研究',body:'r=t 時 u(z,t,t)=v(z,t)。AlphaFlow 指出 MeanFlow 內部存在 gradient conflict；CVPR 2026 的 training-dynamics paper 則顯示 well-formed v 是學 u 的前提，並支持 short-gap → large-gap curriculum。',papers:[['AlphaFlow',`${prefix}/papers/alphaflow/`],['Understanding & Improving MF Training',`${prefix}/papers/meanflow-training/`]],transfer:['Consistency Models：progressive time-domain curriculum','Diffusion timestep weighting：先建立較容易 / 高訊號區域']},
  {id:'q3',tag:'Objective / JVP',title:'JVP tangent 應該用 sample-specific e−x，還是 state-conditioned vθ？',status:'iMF 直接處理',body:'Original MF 把 e−x 同時放在 supervision 與 JVP tangent。iMF 把 tangent 換成 vθ(z_t)，但保留 e−x 作為 regression target。',papers:[['Improved MeanFlow',`${prefix}/papers/improved-meanflow/`]],transfer:['Flow Matching marginalization：conditional target 的 MSE optimum 是 marginal field']},
  {id:'q4',tag:'Endpoint / refinement',title:'one-step coarse transport 已經足夠嗎？',status:'active branch',body:'即使 transport 很快，endpoint quality 仍可能不足。RMFlow 把問題拆成 coarse MeanFlow transport + distribution-aware refinement。',papers:[['RMFlow',`${prefix}/papers/rmflow/`]],transfer:['Diffusion refinement / corrector intuition：把 transport 與 correction 分開']},
  {id:'q5',tag:'Distribution correctness',title:'vector regression loss 變小，是否代表 probability path 真的正確？',status:'跨方法可借鏡',body:'Flow Matching 的 pointwise regression objective 不直接等同於整條 probability path 的 distribution-level correctness。Divergence alignment 提供一個可移植到 fast-flow 研究的 constraint / diagnostic lens。',papers:[['Aligning Flow Divergence',`${prefix}/papers/flow-divergence/`]],transfer:['Divergence / continuity-equation constraints：從 vector error 升到 distribution evolution']}
] : [
  {id:'q1',tag:'Representation / NFE',title:'How can local velocity be compressed into one-step finite-time transport?',status:'Core method question',body:'Flow Matching models an instantaneous local quantity. MeanFlow instead learns interval-average velocity u, directly representing finite-time transport.',papers:[['MeanFlow',`${prefix}/papers/meanflow/`]],transfer:['Flow Map Matching: finite-time displacement representation','Shortcut Models: two-time / self-consistency view']},
  {id:'q2',tag:'Training dynamics',title:'Should r=t / small-Δt competence form before large-gap u?',status:'Direct evidence; protocol still open',body:'At r=t, u(z,t,t)=v(z,t). AlphaFlow identifies gradient conflict inside MeanFlow, while the CVPR 2026 training-dynamics study shows that a well-formed v is a prerequisite for u and supports a short-gap → large-gap curriculum.',papers:[['AlphaFlow',`${prefix}/papers/alphaflow/`],['Understanding & Improving MF Training',`${prefix}/papers/meanflow-training/`]],transfer:['Consistency Models: progressive time-domain curriculum','Diffusion timestep weighting: establish easier / higher-signal regimes first']},
  {id:'q3',tag:'Objective / JVP',title:'Should the JVP tangent use sample-specific e−x or state-conditioned vθ?',status:'Directly addressed by iMF',body:'Original MF uses e−x on both the supervision side and inside the JVP tangent. iMF replaces the tangent with vθ(z_t) while retaining e−x as the regression target.',papers:[['Improved MeanFlow',`${prefix}/papers/improved-meanflow/`]],transfer:['Flow Matching marginalization: the MSE optimum of conditional targets is the marginal field']},
  {id:'q4',tag:'Endpoint / refinement',title:'Is coarse one-step transport sufficient?',status:'Active branch',body:'Fast one-step transport can still leave endpoint quality on the table. RMFlow decomposes the problem into coarse MeanFlow transport plus distribution-aware refinement.',papers:[['RMFlow',`${prefix}/papers/rmflow/`]],transfer:['Diffusion refinement / corrector intuition: separate transport from correction']},
  {id:'q5',tag:'Distribution correctness',title:'Does a smaller vector-regression loss imply the correct probability path?',status:'Transferable cross-method lens',body:'Pointwise Flow Matching regression is not identical to distribution-level path correctness. Divergence alignment supplies a constraint / diagnostic lens that may transfer to fast-flow research.',papers:[['Aligning Flow Divergence',`${prefix}/papers/flow-divergence/`]],transfer:['Divergence / continuity-equation constraints: move from vector error to distribution evolution']}
];
---
<div class="research-tree" data-research-tree>
  <div class="tree-head"><div><span class="kicker">MEANFLOW-CENTERED RESEARCH TREE</span><strong>{isZh ? '主流方法主幹 + MeanFlow 尚未解完的問題分支' : 'Mainstream method trunk + unresolved MeanFlow branches'}</strong><p>{isZh ? '點問題節點看 evidence；點論文名稱直接進筆記。實線代表主要演進，虛線文字代表「可借鏡但尚未證明可直接移植」的方法。' : 'Select a problem node for evidence; paper names open the corresponding notes. Solid structure shows the main lineage, while transfer lenses are candidate ideas rather than established direct transfers.'}</p></div><div class="legend"><span><i class="trunk-dot"></i>{isZh ? '主幹' : 'trunk'}</span><span><i class="question-dot"></i>{isZh ? '問題' : 'question'}</span><span><i class="paper-dot"></i>{isZh ? '論文' : 'paper'}</span></div></div>
  <div class="tree-layout">
    <div class="tree-canvas">
      <div class="trunk">
        <div class="trunk-node muted"><small>{isZh ? '歷史主流' : 'historical mainstream'}</small><b>Diffusion / Score-based Models</b></div><div class="down">↓</div>
        <div class="trunk-node"><small>{isZh ? '連續時間 transport' : 'continuous-time transport'}</small><b>Flow Matching</b><span>{isZh ? 'instantaneous velocity field v' : 'instantaneous velocity field v'}</span></div><div class="down">↓</div>
        <div class="trunk-node focus"><small>{isZh ? '目前研究中心' : 'current focus'}</small><b>MeanFlow</b><span>{isZh ? 'interval-average velocity u · one-step / few-step' : 'interval-average velocity u · one-step / few-step'}</span></div>
      </div>
      <div class="branch-label">{isZh ? 'MeanFlow-centered unresolved / evolving branches' : 'MeanFlow-centered unresolved / evolving branches'}</div>
      <div class="branches">
        {problems.map((p,i)=><div class="branch-row"><button class={i===1?'problem active':'problem'} data-problem={i}><small>{p.tag}</small><b>{p.title}</b></button><div class="paper-children">{p.papers.map(([name,href])=><a href={href}>{name}<span>→</span></a>)}</div></div>)}
      </div>
      <div class="transfer-box"><span>{isZh ? 'Past-method transfer lenses' : 'Past-method transfer lenses'}</span><p>{isZh ? '這些不是「已證明能解 MeanFlow」；它們是從過去方法抽出的可測試設計線索。' : 'These are not proven MeanFlow solutions; they are testable design lenses extracted from earlier methods.'}</p><div class="transfer-chips"><span>Consistency curriculum → Q2</span><span>Shortcut / two-time consistency → Q1</span><span>Flow-map displacement → Q1</span><span>Diffusion correction intuition → Q4</span><span>Divergence constraints → Q5</span></div></div>
    </div>
    <aside class="tree-inspector">
      {problems.map((p,i)=><section data-panel={i} hidden={i!==1}><span class="status">{p.status}</span><h3>{p.title}</h3><p>{p.body}</p><div class="evidence"><b>{isZh ? 'Paper evidence' : 'Paper evidence'}</b>{p.papers.map(([name,href])=><a href={href}>{name} →</a>)}</div><div class="transfer"><b>{isZh ? '可借鏡的方法' : 'Transfer lenses'}</b>{p.transfer.map(t=><span>{t}</span>)}</div></section>)}
    </aside>
  </div>
</div>
<style>
.research-tree{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface);margin:1rem 0 1.5rem;box-shadow:0 14px 38px rgba(74,49,34,.055)}.tree-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end}.tree-head strong{display:block;font-size:1.05rem}.tree-head p{margin:.3rem 0 0;color:var(--rh-muted);line-height:1.55}.kicker{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.13em;margin-bottom:.25rem}.legend{display:flex;gap:.7rem;flex-wrap:wrap;font-size:.7rem;color:var(--rh-muted)}.legend span{display:flex;gap:.3rem;align-items:center}.legend i{width:.65rem;height:.65rem;border-radius:3px;display:inline-block}.trunk-dot{background:var(--rh-coffee)}.question-dot{background:var(--rh-caramel)}.paper-dot{background:var(--rh-surface-2);border:1px solid var(--rh-coffee)}.tree-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(17rem,.75fr);gap:1rem;margin-top:1rem;align-items:start}.tree-canvas{min-width:0}.trunk{display:grid;justify-items:center}.trunk-node{box-sizing:border-box;width:min(100%,31rem);border:1px solid var(--rh-border);border-radius:.7rem;background:var(--rh-surface-2);padding:.65rem .85rem;text-align:center}.trunk-node small,.trunk-node span{display:block;color:var(--rh-muted);font-size:.7rem}.trunk-node b{display:block;margin:.1rem 0}.trunk-node.focus{border:2px solid var(--rh-coffee);background:color-mix(in srgb,var(--rh-coffee) 8%,var(--rh-surface-2))}.trunk-node.muted{opacity:.82}.down{color:var(--rh-caramel);height:1.55rem;display:grid;place-items:center}.branch-label{font-size:.68rem;letter-spacing:.09em;text-transform:uppercase;color:var(--rh-muted);margin:1rem 0 .45rem;padding-left:1.25rem}.branches{position:relative;padding-left:1.5rem}.branches::before{content:'';position:absolute;left:.42rem;top:.3rem;bottom:.3rem;border-left:2px solid var(--rh-border)}.branch-row{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:.4rem;margin:.65rem 0}.branch-row::before{content:'';position:absolute;left:-1.08rem;top:1.7rem;width:1.05rem;border-top:2px solid var(--rh-border)}.problem{box-sizing:border-box;width:100%;min-width:0;text-align:left;border:1px solid var(--rh-border);border-radius:.7rem;background:var(--rh-surface-2);color:var(--rh-text);padding:.65rem .75rem;cursor:pointer;font:inherit}.problem small{display:block;color:var(--rh-caramel);font-size:.67rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.2rem}.problem b{font-size:.84rem;line-height:1.35}.problem:hover,.problem.active{border-color:var(--rh-caramel);background:color-mix(in srgb,var(--rh-caramel) 8%,var(--rh-surface-2))}.paper-children{display:flex;gap:.4rem;flex-wrap:wrap;padding-left:.6rem}.paper-children a{font-size:.72rem;text-decoration:none!important;color:var(--rh-coffee)!important;border:1px solid var(--rh-border);border-radius:.5rem;padding:.3rem .5rem;background:var(--rh-surface)}.paper-children a span{color:var(--rh-caramel);margin-left:.25rem}.paper-children a:hover{border-color:var(--rh-caramel)}.transfer-box{border:1px dashed var(--rh-caramel);border-radius:.7rem;padding:.75rem;margin-top:1rem;background:color-mix(in srgb,var(--rh-caramel) 4%,var(--rh-surface-2))}.transfer-box>span{font-size:.7rem;font-weight:800;color:var(--rh-caramel);text-transform:uppercase;letter-spacing:.06em}.transfer-box p{margin:.25rem 0 .6rem;color:var(--rh-muted);font-size:.78rem}.transfer-chips{display:flex;gap:.35rem;flex-wrap:wrap}.transfer-chips span{font-size:.68rem;border:1px dashed var(--rh-border);border-radius:999px;padding:.25rem .48rem;background:var(--rh-surface)}.tree-inspector{position:sticky;top:5rem}.tree-inspector section{box-sizing:border-box;border:1px solid var(--rh-border);border-radius:.8rem;padding:.9rem;background:var(--rh-surface-2)}.tree-inspector .status{display:block;color:var(--rh-caramel);font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;font-weight:800}.tree-inspector h3{font-size:1rem;line-height:1.35;margin:.35rem 0}.tree-inspector p{color:var(--rh-muted);line-height:1.62;font-size:.84rem}.evidence,.transfer{border-top:1px solid var(--rh-border);padding-top:.65rem;margin-top:.65rem;display:grid;gap:.35rem}.evidence b,.transfer b{font-size:.7rem;text-transform:uppercase;color:var(--rh-muted);letter-spacing:.05em}.evidence a{font-size:.76rem;text-decoration:none!important;color:var(--rh-coffee)!important}.transfer span{font-size:.74rem;line-height:1.45;border-left:2px dashed var(--rh-caramel);padding-left:.5rem}
@media(max-width:840px){.tree-head{grid-template-columns:1fr}.tree-layout{grid-template-columns:1fr}.tree-inspector{position:static}.branch-label{padding-left:0}.branches{padding-left:1.25rem}}
</style>
<script>
for(const root of document.querySelectorAll('[data-research-tree]')){if(root.dataset.ready)continue;root.dataset.ready='1';const nodes=[...root.querySelectorAll('[data-problem]')],panels=[...root.querySelectorAll('[data-panel]')];function set(i){nodes.forEach((n,j)=>n.classList.toggle('active',i===j));panels.forEach((p,j)=>p.hidden=i!==j)}nodes.forEach((n,i)=>n.addEventListener('click',()=>set(i)));set(1)}
</script>
