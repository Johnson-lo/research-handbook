---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="bridge" data-bridge>
  <div class="bridge-head">
    <div><strong>{isZh ? 'Original MeanFlow → Improved MeanFlow｜objective-level 差異' : 'Original MeanFlow → Improved MeanFlow | objective-level difference'}</strong><p>{isZh ? '先固定不變項，再只看真正改動的 JVP tangent。' : 'Hold the invariants fixed, then isolate the actual JVP-tangent change.'}</p></div>
    <div class="bridge-tabs" role="group"><button class="active" data-view="diff">{isZh ? '核心差異' : 'Core difference'}</button><button data-view="full">{isZh ? '完整流程' : 'Full flow'}</button></div>
  </div>

  <div class="shared" data-shared>
    <div><b>{isZh ? '共同 training sample' : 'Shared training sample'}</b><code>x, e, t, r → z_t</code></div>
    <div><b>{isZh ? '共同 supervision' : 'Shared supervision'}</b><code>e−x</code></div>
    <div><b>{isZh ? '共同 inference object' : 'Shared inference object'}</b><code>uθ(z,r,t)</code></div>
  </div>

  <div class="change-banner"><span>{isZh ? '唯一核心替換' : 'Single core replacement'}</span><strong><code>e−x</code><b>→</b><code>vθ(z_t)</code></strong><small>{isZh ? 'e−x 沒有從 loss 消失；它只是離開 JVP tangent。' : 'e−x does not disappear from the loss; it leaves only the JVP tangent.'}</small></div>

  <div class="compare">
    <article>
      <div class="article-title"><span>Original</span><h3>MeanFlow</h3></div>
      <div class="flowline"><span class="state">z_t</span><span>→</span><span class="avg">uθ</span></div>
      <div class="critical dashed"><span class="label">JVP tangent</span><code>e−x</code><small>sample-specific conditional velocity</small></div>
      <div class="arrow">↓</div>
      <div class="result"><span>{isZh ? 'compound predictor' : 'compound predictor'}</span><code>Vθ(z_t, e−x)</code></div>
      <p>{isZh ? 'JVP pathway 看到了 sampled pair 的 conditional tangent，因此 predictor 額外依賴 sample-specific information。' : 'The JVP pathway sees the sampled pair-specific conditional tangent, so the predictor additionally depends on sample-specific information.'}</p>
    </article>
    <article>
      <div class="article-title"><span>Improved</span><h3>MeanFlow</h3></div>
      <div class="flowline"><span class="state">z_t</span><span>→</span><span class="avg">uθ</span></div>
      <div class="critical"><span class="label">JVP tangent</span><code>vθ(z_t)</code><small>model-estimated marginal-like velocity</small></div>
      <div class="arrow">↓</div>
      <div class="result"><span>{isZh ? 'compound predictor' : 'compound predictor'}</span><code>Vθ(z_t)</code></div>
      <p>{isZh ? 'JVP direction 改成只由目前 state 得到的 velocity estimate；supervision 端仍然使用 e−x。' : 'The JVP direction is replaced by a velocity estimate derived from the current state; e−x remains on the supervision side.'}</p>
    </article>
  </div>

  <div class="supervision-row" data-full><span>{isZh ? '兩者最後都與同一個 sample target 比較' : 'Both are finally compared with the same sample target'}</span><code>Vθ − (e−x)</code></div>
  <div class="paper-scope" data-full><b>{isZh ? '不要把 objective-only 改動和 final system 混在一起' : 'Separate the objective-only change from the final system'}</b><div class="scope-grid"><div><strong>{isZh ? 'Objective' : 'Objective'}</strong><span>JVP tangent: e−x → vθ(z_t)</span></div><div><strong>{isZh ? 'System additions' : 'System additions'}</strong><span>{isZh ? 'flexible CFG、Ω-conditioning、in-context conditioning、block changes、longer training' : 'flexible CFG, Ω-conditioning, in-context conditioning, block changes, longer training'}</span></div></div></div>
</div>

<style>
.bridge{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;margin:1.2rem 0;background:var(--rh-surface);overflow:hidden}.bridge-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center}.bridge-head p{margin:.25rem 0 0;color:var(--rh-muted)}.bridge-tabs{display:grid;grid-template-columns:repeat(2,7.2rem);gap:.5rem}.bridge-tabs button{box-sizing:border-box;width:100%;height:2.55rem;margin:0;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface-2);color:var(--rh-text);font:inherit;white-space:nowrap}.bridge-tabs button.active{border-color:var(--rh-caramel);background:var(--rh-surface-3)}.shared{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin:1rem 0}.shared>div{box-sizing:border-box;min-width:0;min-height:6.2rem;border:1px solid var(--rh-border);border-radius:.7rem;padding:.75rem;background:var(--rh-surface-2);display:flex;flex-direction:column;justify-content:space-between;gap:.5rem}.shared code{width:max-content;max-width:100%;overflow-wrap:anywhere}.change-banner{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.8rem;align-items:center;border:1px solid var(--rh-caramel);border-radius:.75rem;padding:.7rem .85rem;margin:.85rem 0;background:color-mix(in srgb,var(--rh-caramel) 7%,var(--rh-surface-2))}.change-banner>span,.change-banner small{color:var(--rh-muted);font-size:.78rem}.change-banner strong{display:flex;justify-content:center;gap:.55rem;align-items:center;font-size:1rem}.change-banner strong b{color:var(--rh-caramel)}.compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;align-items:stretch}.compare article{box-sizing:border-box;min-width:0;height:100%;border:1px solid var(--rh-border);border-radius:.8rem;padding:.9rem;background:var(--rh-surface-2);display:flex;flex-direction:column}.article-title span{display:block;color:var(--rh-caramel);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.article-title h3{margin:.1rem 0 .65rem}.flowline{display:flex;justify-content:center;gap:.55rem;align-items:center;margin:.4rem 0 .8rem}.state,.avg{border:1px solid var(--rh-border);border-radius:.55rem;padding:.55rem .7rem;background:var(--rh-surface)}.avg{border-color:#7d678f}.critical{display:grid;gap:.28rem;text-align:center;border:2px solid var(--rh-caramel);border-radius:.65rem;padding:.7rem;background:color-mix(in srgb,var(--rh-caramel) 6%,var(--rh-surface))}.critical.dashed{border-style:dashed}.critical .label{font-size:.72rem;text-transform:uppercase;color:var(--rh-muted)}.critical code{font-size:1rem}.critical small{color:var(--rh-muted)}.arrow{text-align:center;font-size:1.25rem;margin:.3rem 0}.result{display:grid;gap:.25rem;text-align:center;border:1px solid var(--rh-border);border-radius:.6rem;padding:.6rem;background:var(--rh-surface)}.result span{font-size:.7rem;color:var(--rh-muted);text-transform:uppercase}.compare article p{color:var(--rh-muted);line-height:1.6;margin:.8rem 0 0}.supervision-row,.paper-scope{border:1px solid var(--rh-border);border-radius:.7rem;padding:.75rem;margin-top:.8rem;background:var(--rh-surface-2)}.supervision-row{display:flex;justify-content:center;gap:.8rem;align-items:center;flex-wrap:wrap}.scope-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:.6rem}.scope-grid>div{min-width:0;border-left:3px solid var(--rh-caramel);padding-left:.7rem}.scope-grid strong,.scope-grid span{display:block}.scope-grid span{color:var(--rh-muted);margin-top:.2rem;overflow-wrap:anywhere}.bridge[data-view='diff'] [data-shared],.bridge[data-view='diff'] [data-full]{display:none}
@media(max-width:760px){.bridge-head{grid-template-columns:1fr}.bridge-tabs{grid-template-columns:repeat(2,minmax(0,1fr));width:100%}.shared,.compare,.scope-grid{grid-template-columns:1fr}.change-banner{grid-template-columns:1fr;text-align:center}.change-banner strong{justify-content:center}}
</style>
<script>
for(const root of document.querySelectorAll('[data-bridge]')){if(root.dataset.ready)continue;root.dataset.ready='1';const buttons=[...root.querySelectorAll('[data-view]')];function set(v){root.dataset.view=v;buttons.forEach(b=>b.classList.toggle('active',b.dataset.view===v))}buttons.forEach(b=>b.addEventListener('click',()=>set(b.dataset.view)));set('diff')}
</script>
