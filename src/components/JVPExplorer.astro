---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="jvp-lab" data-jvp-lab data-lang={isZh?'zh':'en'}>
  <div class="jvp-head"><div><span>JVP EXPLORER</span><strong>{isZh?'把偏微分、chain rule 與 MeanFlow tangent 放在同一個互動裡':'Partial derivatives, chain rule, and the MeanFlow tangent in one interactive'}</strong></div><div class="tabs"><button class="active" data-mode="chain">{isZh?'Chain rule':'Chain rule'}</button><button data-mode="interval">{isZh?'r=t boundary':'r=t boundary'}</button></div></div>
  <div class="chain-view" data-view="chain">
    <div class="sliders">
      <label><span>z</span><input data-z type="range" min="-2" max="2" step="0.05" value="0.8"><output data-zo>0.80</output></label>
      <label><span>t</span><input data-t type="range" min="0" max="1" step="0.01" value="0.55"><output data-to>0.55</output></label>
      <label><span>v = dz/dt</span><input data-v type="range" min="-2" max="2" step="0.05" value="0.7"><output data-vo>0.70</output></label>
    </div>
    <div class="readouts"><div><small>∂u/∂z</small><strong data-dz></strong></div><div><small>(∂u/∂z)v</small><strong data-state></strong></div><div><small>∂u/∂t</small><strong data-dt></strong></div><div><small>du/dt = JVP</small><strong data-total></strong></div></div>
    <div class="equation" data-eq></div>
    <svg class="contrib" viewBox="0 0 780 170" role="img" aria-label="JVP contribution bars"><rect x="0" y="0" width="780" height="170" rx="12" class="bg"/><line x1="390" y1="30" x2="390" y2="145" class="zero"/><text x="390" y="20" text-anchor="middle" class="label">0</text><text x="35" y="58" class="label">state</text><text x="35" y="103" class="label">time</text><text x="35" y="148" class="label">total</text><rect data-statebar y="42" height="20" rx="5"/><rect data-timebar y="87" height="20" rx="5"/><rect data-totalbar y="132" height="20" rx="5"/></svg>
    <p>{isZh?'Toy function 使用 u(z,t)=z²+0.6zt+2t。目的不是模擬真實 network，而是讓你看到 total derivative 如何由 state contribution 與 time contribution 相加。':'The toy function is u(z,t)=z²+0.6zt+2t. It is not a trained network; it makes the two contributions to the total derivative visible.'}</p>
  </div>
  <div class="interval-view" data-view="interval" hidden>
    <div class="sliders"><label><span>t</span><input data-it type="range" min="0.05" max="1" step="0.01" value="0.75"><output data-ito>0.75</output></label><label><span>r</span><input data-ir type="range" min="0" max="0.74" step="0.01" value="0.25"><output data-iro>0.25</output></label></div>
    <svg class="interval" viewBox="0 0 780 180"><rect width="780" height="180" rx="12" class="bg"/><line x1="80" y1="90" x2="700" y2="90" class="axis"/><circle data-rp cy="90" r="12" class="rp"/><circle data-tp cy="90" r="12" class="tp"/><line data-gap y1="90" y2="90" class="gap"/><text x="80" y="135" class="label">0 · data</text><text x="650" y="135" class="label">1 · prior</text><text data-gaplabel y="55" text-anchor="middle" class="label"></text></svg>
    <div class="boundary-note" data-boundary></div>
  </div>
</div>
<style>
.jvp-lab{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface-2);margin:1rem 0 1.4rem;overflow:hidden}.jvp-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end}.jvp-head span{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.12em}.jvp-head strong{display:block;margin-top:.2rem}.tabs{display:grid;grid-template-columns:repeat(2,7.2rem);gap:.45rem}.tabs button{height:2.5rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface);color:var(--rh-text);font:inherit;cursor:pointer}.tabs button.active{border-color:var(--rh-caramel);background:var(--rh-surface-3)}.chain-view,.interval-view{margin-top:.9rem;border-top:1px solid var(--rh-border);padding-top:.9rem}.sliders{display:grid;gap:.6rem}.sliders label{display:grid;grid-template-columns:7rem minmax(0,1fr) 3.7rem;gap:.6rem;align-items:center;border:1px solid var(--rh-border);border-radius:.65rem;background:var(--rh-surface);padding:.6rem .7rem;min-width:0}.sliders input{width:100%;min-width:0}.sliders output{text-align:right;font-variant-numeric:tabular-nums}.readouts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem;margin:.75rem 0}.readouts>div{border:1px solid var(--rh-border);border-radius:.65rem;padding:.65rem;background:var(--rh-surface);text-align:center}.readouts small{display:block;color:var(--rh-muted);font-size:.7rem}.readouts strong{display:block;margin-top:.2rem;font-variant-numeric:tabular-nums}.equation{border:1px solid var(--rh-border);border-radius:.65rem;background:var(--rh-surface);padding:.7rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82rem;overflow-wrap:anywhere}.contrib,.interval{display:block;width:100%;height:auto;margin-top:.75rem}.bg{fill:#f8f3ec}.zero{stroke:var(--rh-border);stroke-width:2}.label{fill:#74665a;font-size:12px}.axis{stroke:#c49a72;stroke-width:5;stroke-linecap:round}.rp{fill:#638a69}.tp{fill:#fffdf8;stroke:#6b4f3a;stroke-width:2}.gap{stroke:#7d678f;stroke-width:7;stroke-linecap:round}.boundary-note{margin-top:.7rem;border-left:3px solid var(--rh-caramel);padding:.7rem .8rem;background:var(--rh-surface);line-height:1.6}.jvp-lab p{color:var(--rh-muted);line-height:1.6}
@media(max-width:720px){.jvp-head{grid-template-columns:1fr}.tabs{grid-template-columns:repeat(2,minmax(0,1fr));width:100%}.readouts{grid-template-columns:repeat(2,minmax(0,1fr))}.sliders label{grid-template-columns:6.4rem minmax(0,1fr) 3.4rem}}
</style>
<script>
for(const root of document.querySelectorAll('[data-jvp-lab]')){if(root.dataset.ready)continue;root.dataset.ready='1';const zh=root.dataset.lang==='zh',tabs=[...root.querySelectorAll('[data-mode]')],views=[...root.querySelectorAll('[data-view]')];function setMode(m){tabs.forEach(b=>b.classList.toggle('active',b.dataset.mode===m));views.forEach(v=>v.hidden=v.dataset.view!==m)}tabs.forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.mode)));const z=root.querySelector('[data-z]'),t=root.querySelector('[data-t]'),v=root.querySelector('[data-v]'),zo=root.querySelector('[data-zo]'),to=root.querySelector('[data-to]'),vo=root.querySelector('[data-vo]'),dz=root.querySelector('[data-dz]'),state=root.querySelector('[data-state]'),dt=root.querySelector('[data-dt]'),total=root.querySelector('[data-total]'),eq=root.querySelector('[data-eq]'),sb=root.querySelector('[data-statebar]'),tb=root.querySelector('[data-timebar]'),totb=root.querySelector('[data-totalbar]');function bar(rect,val,color){const scale=58,x0=390,w=Math.min(280,Math.abs(val)*scale);rect.setAttribute('x',val>=0?x0:x0-w);rect.setAttribute('width',w);rect.setAttribute('fill',color)}function updateChain(){const zz=+z.value,tt=+t.value,vv=+v.value,pz=2*zz+.6*tt,pt=.6*zz+2,s=pz*vv,j=s+pt;zo.textContent=zz.toFixed(2);to.textContent=tt.toFixed(2);vo.textContent=vv.toFixed(2);dz.textContent=pz.toFixed(3);state.textContent=s.toFixed(3);dt.textContent=pt.toFixed(3);total.textContent=j.toFixed(3);eq.textContent=`du/dt = (∂u/∂z)v + ∂u/∂t = (${pz.toFixed(3)})(${vv.toFixed(2)}) + ${pt.toFixed(3)} = ${j.toFixed(3)}`;bar(sb,s,'#c47a3d');bar(tb,pt,'#a06f47');bar(totb,j,'#7d678f')}[z,t,v].forEach(x=>x.addEventListener('input',updateChain));const it=root.querySelector('[data-it]'),ir=root.querySelector('[data-ir]'),ito=root.querySelector('[data-ito]'),iro=root.querySelector('[data-iro]'),rp=root.querySelector('[data-rp]'),tp=root.querySelector('[data-tp]'),gap=root.querySelector('[data-gap]'),gl=root.querySelector('[data-gaplabel]'),bn=root.querySelector('[data-boundary]');function updateInterval(){let tv=+it.value,rv=+ir.value;if(rv>=tv){rv=Math.max(0,tv-.01);ir.value=rv.toFixed(2)}ir.max=Math.max(0,tv-.01);ito.textContent=tv.toFixed(2);iro.textContent=rv.toFixed(2);const xr=80+620*rv,xt=80+620*tv,L=tv-rv;rp.setAttribute('cx',xr);tp.setAttribute('cx',xt);gap.setAttribute('x1',xr);gap.setAttribute('x2',xt);gl.setAttribute('x',(xr+xt)/2);gl.textContent=`Δt = ${L.toFixed(2)}`;bn.innerHTML=zh?(L<.06?'<b>接近 r=t：</b> interval 幾乎縮成一個點，此時 u(z,t,t)=v(z,t)，接近 instantaneous-velocity learning。':`<b>finite interval：</b> 目前 Δt=${L.toFixed(2)}。u 要摘要整段 transport；gap 越大，任務越不像單純 local velocity。`):(L<.06?'<b>Near r=t:</b> the interval nearly collapses to a point, so u(z,t,t)=v(z,t).':`<b>Finite interval:</b> Δt=${L.toFixed(2)}. u must summarize transport over the whole interval.`)}it.addEventListener('input',updateInterval);ir.addEventListener('input',updateInterval);updateChain();updateInterval();setMode('chain')}
</script>
