---
const { lang = 'zh' } = Astro.props;
const isZh = lang !== 'en';
---
<div class="jvp-lab" data-jvp-lab data-lang={isZh?'zh':'en'}>
  <div class="jvp-head">
    <div><span>JVP EXPLORER</span><strong>{isZh?'把公式、方向與幾何放在同一個互動裡':'Put formula, direction, and geometry in one interactive'}</strong><p>{isZh?'拖動 z、t、v，左邊看 trajectory 上的移動，右邊看 JVP 被拆成 state 與 explicit-time 兩部分。':'Move z, t, and v; watch the trajectory on the left and the JVP decomposition on the right.'}</p></div>
    <div class="tabs"><button class="active" data-mode="chain">{isZh?'幾何 + JVP':'Geometry + JVP'}</button><button data-mode="interval">{isZh?'r=t boundary':'r=t boundary'}</button></div>
  </div>
  <div class="chain-view" data-view="chain">
    <div class="chain-layout">
      <div class="geo-panel">
        <div class="geo-title"><span>{isZh?'沿著 tangent 走一小步':'Take a small step along the tangent'}</span><b>q(t) = (z_t, t)</b></div>
        <svg class="trajectory" viewBox="0 0 520 330" role="img" aria-label="JVP geometric trajectory">
          <defs><marker id="arrow-jvp" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" class="arrowhead"/></marker></defs>
          <rect width="520" height="330" rx="14" class="bg"/>
          <line x1="55" y1="275" x2="475" y2="275" class="axis"/><line x1="75" y1="300" x2="75" y2="45" class="axis"/>
          <text x="465" y="300" class="label">t</text><text x="45" y="55" class="label">z</text>
          <path data-curve class="curve"/>
          <circle data-point r="8" class="point"/><circle data-next r="7" class="next"/>
          <line data-tangent class="tangent-line" marker-end="url(#arrow-jvp)"/>
          <line data-state-comp class="state-comp" marker-end="url(#arrow-jvp)"/>
          <line data-time-comp class="time-comp" marker-end="url(#arrow-jvp)"/>
          <text data-point-label class="label point-label"></text>
          <text data-next-label class="label"></text>
        </svg>
        <div class="geo-legend"><span><i class="dot-current"></i>{isZh?'目前 q(t)':'current q(t)'}</span><span><i class="dot-next"></i>{isZh?'沿 tangent 後':'after tangent step'}</span><span><i class="line-state"></i>{isZh?'state contribution':'state contribution'}</span><span><i class="line-time"></i>{isZh?'time contribution':'time contribution'}</span></div>
      </div>
      <div class="math-panel">
        <div class="sliders">
          <label><span>z</span><input data-z type="range" min="-2" max="2" step="0.05" value="0.8"><output data-zo>0.80</output></label>
          <label><span>t</span><input data-t type="range" min="0" max="1" step="0.01" value="0.55"><output data-to>0.55</output></label>
          <label><span>v = dz/dt</span><input data-v type="range" min="-2" max="2" step="0.05" value="0.7"><output data-vo>0.70</output></label>
        </div>
        <div class="readouts"><div><small>∂u/∂z</small><strong data-dz></strong></div><div><small>(∂u/∂z)v</small><strong data-state></strong></div><div><small>∂u/∂t</small><strong data-dt></strong></div><div><small>du/dt = JVP</small><strong data-total></strong></div></div>
        <div class="equation" data-eq></div>
        <div class="contrib-bars"><div><span>state</span><div class="bar-track"><i data-statefill></i></div><b data-statepct></b></div><div><span>time</span><div class="bar-track"><i data-timefill></i></div><b data-timepct></b></div></div>
        <div class="interpret" data-interpret></div>
      </div>
    </div>
  </div>
  <div class="interval-view" data-view="interval" hidden>
    <div class="sliders"><label><span>t</span><input data-it type="range" min="0.05" max="1" step="0.01" value="0.75"><output data-ito>0.75</output></label><label><span>r</span><input data-ir type="range" min="0" max="0.74" step="0.01" value="0.25"><output data-iro>0.25</output></label></div>
    <svg class="interval" viewBox="0 0 780 180"><rect width="780" height="180" rx="12" class="bg"/><line x1="80" y1="90" x2="700" y2="90" class="axis"/><circle data-rp cy="90" r="12" class="rp"/><circle data-tp cy="90" r="12" class="tp"/><line data-gap y1="90" y2="90" class="gap"/><text x="80" y="135" class="label">0 · data</text><text x="650" y="135" class="label">1 · prior</text><text data-gaplabel y="55" text-anchor="middle" class="label"></text></svg>
    <div class="boundary-note" data-boundary></div>
  </div>
</div>
<style>
.jvp-lab{box-sizing:border-box;width:100%;border:1px solid var(--rh-border);border-radius:1rem;padding:1rem;background:var(--rh-surface-2);margin:1rem 0 1.4rem;overflow:hidden}.jvp-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end}.jvp-head span{display:block;color:var(--rh-caramel);font-size:.68rem;font-weight:800;letter-spacing:.12em}.jvp-head strong{display:block;margin-top:.2rem}.jvp-head p{margin:.25rem 0 0!important;color:var(--rh-muted);font-size:.76rem;line-height:1.5}.tabs{display:grid;grid-template-columns:repeat(2,8.2rem);gap:.45rem}.tabs button{height:2.5rem;border:1px solid var(--rh-border);border-radius:.55rem;background:var(--rh-surface);color:var(--rh-text);font:inherit;cursor:pointer}.tabs button.active{border-color:var(--rh-caramel);background:var(--rh-surface-3)}.chain-view,.interval-view{margin-top:.9rem;border-top:1px solid var(--rh-border);padding-top:.9rem}.chain-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(20rem,.9fr);gap:.75rem;align-items:stretch}.geo-panel,.math-panel{border:1px solid var(--rh-border);border-radius:.75rem;background:var(--rh-surface);padding:.7rem;min-width:0}.geo-title span{display:block;color:var(--rh-caramel);font-size:.65rem;text-transform:uppercase;letter-spacing:.06em}.geo-title b{display:block;margin-top:.15rem}.trajectory{width:100%;height:auto;display:block;margin-top:.5rem}.bg{fill:#f8f3ec}.axis{stroke:#cab9a8;stroke-width:1.5}.curve{fill:none;stroke:#9e8f82;stroke-width:2.2;stroke-dasharray:5 5}.point{fill:#fffdf8;stroke:#6b4f3a;stroke-width:3}.next{fill:#7d678f;stroke:#fff;stroke-width:2}.tangent-line{stroke:#7d678f;stroke-width:3}.state-comp{stroke:#c47a3d;stroke-width:3}.time-comp{stroke:#6f8b69;stroke-width:3}.arrowhead{fill:#7d678f}.label{fill:#74665a;font-size:12px}.point-label{font-weight:700}.geo-legend{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.45rem}.geo-legend span{font-size:.65rem;color:var(--rh-muted);display:flex;align-items:center;gap:.3rem}.geo-legend i{display:inline-block}.dot-current,.dot-next{width:.55rem;height:.55rem;border-radius:50%}.dot-current{background:#fff;border:2px solid #6b4f3a}.dot-next{background:#7d678f}.line-state,.line-time{width:1rem;height:2px}.line-state{background:#c47a3d}.line-time{background:#6f8b69}.sliders{display:grid;gap:.55rem}.sliders label{display:grid;grid-template-columns:6.5rem minmax(0,1fr) 3.5rem;gap:.5rem;align-items:center;border:1px solid var(--rh-border);border-radius:.6rem;background:var(--rh-surface-2);padding:.55rem .6rem;min-width:0}.sliders input{width:100%;min-width:0}.sliders output{text-align:right;font-variant-numeric:tabular-nums}.readouts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin:.65rem 0}.readouts>div{border:1px solid var(--rh-border);border-radius:.6rem;padding:.55rem;background:var(--rh-surface-2);text-align:center}.readouts small{display:block;color:var(--rh-muted);font-size:.68rem}.readouts strong{display:block;margin-top:.15rem;font-variant-numeric:tabular-nums}.equation{border:1px solid var(--rh-border);border-radius:.6rem;background:var(--rh-surface-2);padding:.65rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;overflow-wrap:anywhere}.contrib-bars{display:grid;gap:.45rem;margin-top:.6rem}.contrib-bars>div{display:grid;grid-template-columns:3.5rem 1fr 3.4rem;gap:.45rem;align-items:center;font-size:.68rem}.bar-track{height:.55rem;border-radius:999px;background:var(--rh-surface-3);overflow:hidden}.bar-track i{display:block;height:100%;width:0;border-radius:999px;transition:width .2s}.contrib-bars>div:first-child i{background:#c47a3d}.contrib-bars>div:nth-child(2) i{background:#6f8b69}.contrib-bars b{text-align:right;font-variant-numeric:tabular-nums}.interpret{margin-top:.6rem;border-left:3px solid var(--rh-caramel);padding:.55rem .65rem;background:var(--rh-surface-2);font-size:.72rem;line-height:1.5}.interval{display:block;width:100%;height:auto;margin-top:.75rem}.rp{fill:#638a69}.tp{fill:#fffdf8;stroke:#6b4f3a;stroke-width:2}.gap{stroke:#7d678f;stroke-width:7;stroke-linecap:round}.boundary-note{margin-top:.7rem;border-left:3px solid var(--rh-caramel);padding:.7rem .8rem;background:var(--rh-surface);line-height:1.6}
:global(.sl-markdown-content .jvp-lab :is(.jvp-head,.tabs,.chain-layout,.sliders,.readouts,.geo-legend,.contrib-bars) > *){margin-top:0!important}
@media(max-width:900px){.jvp-head{grid-template-columns:1fr}.tabs{grid-template-columns:repeat(2,minmax(0,1fr));width:100%}.chain-layout{grid-template-columns:1fr}}@media(max-width:620px){.readouts{grid-template-columns:1fr 1fr}.sliders label{grid-template-columns:5.7rem minmax(0,1fr) 3.2rem}}
</style>
<script>
for(const root of document.querySelectorAll('[data-jvp-lab]')){
  if(root.dataset.ready)continue;root.dataset.ready='1';
  const zh=root.dataset.lang==='zh',tabs=[...root.querySelectorAll('[data-mode]')],views=[...root.querySelectorAll('[data-view]')];
  function setMode(m){tabs.forEach(b=>b.classList.toggle('active',b.dataset.mode===m));views.forEach(v=>v.hidden=v.dataset.view!==m)}tabs.forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.mode)));
  const z=root.querySelector('[data-z]'),t=root.querySelector('[data-t]'),v=root.querySelector('[data-v]'),zo=root.querySelector('[data-zo]'),to=root.querySelector('[data-to]'),vo=root.querySelector('[data-vo]'),dz=root.querySelector('[data-dz]'),state=root.querySelector('[data-state]'),dt=root.querySelector('[data-dt]'),total=root.querySelector('[data-total]'),eq=root.querySelector('[data-eq]'),sf=root.querySelector('[data-statefill]'),tf=root.querySelector('[data-timefill]'),sp=root.querySelector('[data-statepct]'),tpct=root.querySelector('[data-timepct]'),interpret=root.querySelector('[data-interpret]'),curve=root.querySelector('[data-curve]'),point=root.querySelector('[data-point]'),next=root.querySelector('[data-next]'),tan=root.querySelector('[data-tangent]'),stateComp=root.querySelector('[data-state-comp]'),timeComp=root.querySelector('[data-time-comp]'),pl=root.querySelector('[data-point-label]'),nl=root.querySelector('[data-next-label]');
  function mapT(tt){return 75+380*tt}function mapZ(zz){return 160-62*zz}
  function updateCurve(){let d='';for(let i=0;i<=50;i++){const tt=i/50,zz=.55*Math.sin(tt*5.2)+.55-tt*.25;d+=(i?'L':'M')+mapT(tt).toFixed(1)+','+mapZ(zz).toFixed(1)+' '}curve.setAttribute('d',d)}
  function updateChain(){const zz=+z.value,tt=+t.value,vv=+v.value,pz=2*zz+.6*tt,pt=.6*zz+2,s=pz*vv,j=s+pt;zo.textContent=zz.toFixed(2);to.textContent=tt.toFixed(2);vo.textContent=vv.toFixed(2);dz.textContent=pz.toFixed(3);state.textContent=s.toFixed(3);dt.textContent=pt.toFixed(3);total.textContent=j.toFixed(3);eq.textContent=`du/dt = (∂u/∂z)v + ∂u/∂t = (${pz.toFixed(3)})(${vv.toFixed(2)}) + ${pt.toFixed(3)} = ${j.toFixed(3)}`;const denom=Math.max(.001,Math.abs(s)+Math.abs(pt)),ps=Math.round(Math.abs(s)/denom*100),ptm=100-ps;sf.style.width=ps+'%';tf.style.width=ptm+'%';sp.textContent=ps+'%';tpct.textContent=ptm+'%';interpret.innerHTML=zh?(Math.abs(s)>Math.abs(pt)?'<b>現在主要是 state contribution。</b> 改變 z 沿 tangent 的影響，比 explicit time 變化更大。':'<b>現在主要是 explicit-time contribution。</b> 即使 z 不移動，u 本身隨 t 的變化仍很明顯。'):(Math.abs(s)>Math.abs(pt)?'<b>State contribution dominates.</b> Motion in z matters more here.':'<b>Explicit-time contribution dominates.</b> u changes strongly with t even apart from state motion.');const x=mapT(tt),y=mapZ(zz),step=.12,x2=mapT(Math.min(1,tt+step)),y2=mapZ(zz+vv*step);point.setAttribute('cx',x);point.setAttribute('cy',y);next.setAttribute('cx',x2);next.setAttribute('cy',y2);tan.setAttribute('x1',x);tan.setAttribute('y1',y);tan.setAttribute('x2',x2);tan.setAttribute('y2',y2);stateComp.setAttribute('x1',x);stateComp.setAttribute('y1',y);stateComp.setAttribute('x2',x);stateComp.setAttribute('y2',y2);timeComp.setAttribute('x1',x);timeComp.setAttribute('y1',y2);timeComp.setAttribute('x2',x2);timeComp.setAttribute('y2',y2);pl.setAttribute('x',x+10);pl.setAttribute('y',y-10);pl.textContent='q(t)';nl.setAttribute('x',x2+8);nl.setAttribute('y',y2-8);nl.textContent='q(t+δ)'}[z,t,v].forEach(x=>x.addEventListener('input',updateChain));
  const it=root.querySelector('[data-it]'),ir=root.querySelector('[data-ir]'),ito=root.querySelector('[data-ito]'),iro=root.querySelector('[data-iro]'),rp=root.querySelector('[data-rp]'),tp=root.querySelector('[data-tp]'),gap=root.querySelector('[data-gap]'),gl=root.querySelector('[data-gaplabel]'),bn=root.querySelector('[data-boundary]');function updateInterval(){let tv=+it.value,rv=+ir.value;if(rv>=tv){rv=Math.max(0,tv-.01);ir.value=rv.toFixed(2)}ir.max=Math.max(0,tv-.01);ito.textContent=tv.toFixed(2);iro.textContent=rv.toFixed(2);const xr=80+620*rv,xt=80+620*tv,L=tv-rv;rp.setAttribute('cx',xr);tp.setAttribute('cx',xt);gap.setAttribute('x1',xr);gap.setAttribute('x2',xt);gl.setAttribute('x',(xr+xt)/2);gl.textContent=`Δt = ${L.toFixed(2)}`;bn.innerHTML=zh?(L<.06?'<b>接近 r=t：</b> interval 幾乎縮成一個點，此時 u(z,t,t)=v(z,t)，接近 instantaneous-velocity learning。':`<b>finite interval：</b> 目前 Δt=${L.toFixed(2)}。u 要摘要整段 transport；gap 越大，任務越不像單純 local velocity。`):(L<.06?'<b>Near r=t:</b> the interval nearly collapses to a point, so u(z,t,t)=v(z,t).':`<b>Finite interval:</b> Δt=${L.toFixed(2)}. u must summarize transport over the whole interval.`)}it.addEventListener('input',updateInterval);ir.addEventListener('input',updateInterval);updateCurve();updateChain();updateInterval();setMode('chain')}
</script>
